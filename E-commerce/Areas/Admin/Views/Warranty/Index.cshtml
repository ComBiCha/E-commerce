@model IEnumerable<E_commerce.Models.WarrantyRequestModel>

@{
    ViewData["Title"] = "Warranty Requests";
}
<link rel="stylesheet" href="~/css/admin-index.css" />


<div class="warranty-filter-section">
    <h2>@ViewData["Title"]</h2>

    <div class="filter-section">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label for="statusFilter" class="warranty-filter-label">Filter by Status:</label>
                <select id="statusFilter" class="warranty-status-select">
                    <option value="">All</option>
                    <option value="Đợi duyệt">Đợi duyệt</option>
                    <option value="Đã duyệt">Đã duyệt</option>
                    <option value="Đã tiếp nhận sản phẩm lỗi">Đã tiếp nhận sản phẩm lỗi</option>
                    <option value="Đã khắc phục">Đã khắc phục</option>
                    <option value="Đã hoàn thành">Đã hoàn thành</option>
                    <option value="Bị từ chối">Bị từ chối</option>
                    <option value="Đã bị huỷ">Đã bị huỷ</option>
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label for="startDate" class="warranty-filter-label">Start Date:</label>
                <input type="date" id="startDate" class="warranty-date-input">
            </div>
            <div class="col-md-3 mb-3">
                <label for="endDate" class="warranty-filter-label">End Date:</label>
                <input type="date" id="endDate" class="warranty-date-input">
            </div>
        </div>
    </div>

<div class="table-responsive">
    <table class="table table-bordered" id="WarrantyTable">
        <thead>
            <tr>
                <th class="text-center">#</th>
                <th>Warranty Code</th>
                <th>User</th>
                <th class="text-center">Status</th>
                <th class="text-center">Created Date</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td class="text-center">@request.Id</td>
                    <td>@request.WarrantyCode</td>
                    <td>@request.User.UserName</td>
                        <td class="text-center">
                            @if (request.Status == 0)
                            {
                                <span class="warranty-badge warranty-status-pending">Đợi duyệt</span>
                            }
                            else if (request.Status == 1)
                            {
                                <span class="warranty-badge warranty-status-approved">Đã duyệt</span>
                            }
                            else if (request.Status == 2)
                            {
                                <span class="warranty-badge warranty-status-received">Đã tiếp nhận sản phẩm lỗi</span>
                            }
                            else if (request.Status == 3)
                            {
                                <span class="warranty-badge warranty-status-fixed">Đã khắc phục</span>
                            }
                            else if (request.Status == 4)
                            {
                                <span class="warranty-badge warranty-status-completed">Đã hoàn thành</span>
                            }
                            else if (request.Status == 5)
                            {
                                <span class="warranty-badge warranty-status-rejected">Bị từ chối</span>
                            }
                            else if (request.Status == 6)
                            {
                                <span class="warranty-badge warranty-status-cancelled">Đã bị huỷ</span>
                            }
                        </td>
                    <td class="text-center">@request.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td class="text-center">
                        <a href="@Url.Action("ViewDetails", "Warranty", new { id = request.Id })" class="btn btn-info btn-sm">View Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#WarrantyTable').DataTable();

            // Add event listener to the dropdown
            $('#statusFilter').on('change', function () {
                var selectedStatus = $(this).val();
                table.column(3).search(selectedStatus, true, false).draw(); // Column 4 is the "Order Status"
            });

            // Add custom filter for date range
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var startDate = $('#startDate').val();
                var endDate = $('#endDate').val();
                var createdDate = data[4]; // Column index of CreatedDate

                if (startDate) {
                    startDate = new Date(startDate);
                }
                if (endDate) {
                    endDate = new Date(endDate);
                }

                // Parse the createdDate from the table
                var tableDate = new Date(createdDate.split(" ")[0].split('/').reverse().join('-'));

                // Apply the filter
                if ((!startDate || tableDate >= startDate) &&
                    (!endDate || tableDate <= endDate)) {
                    return true;
                }
                return false;
            });

            // Add event listeners to the date inputs
            $('#startDate, #endDate').on('change', function () {
                table.draw(); // Trigger a redraw with the date filter
            });
        });

    </script>
}
