@model IEnumerable<SliderModel>
@{
    ViewData["title"] = "Slider Listed";
    // Paginate pager = new Paginate();

    // int pageNo = 0;

    // if (ViewBag.Pager != null)
    // {
    //     pager = ViewBag.Pager;

    //     pageNo = pager.CurrentPage;
    // }
}
<link rel="stylesheet" href="~/css/admin-index.css" />

<div class="top">
    <h3>List Sliders</h3>
    <a asp-action="Create" asp-controller="Slider" class="add-button">Add Slider</a>
</div>

<div class="table-container">
    <table class="table table-hover" id="sliderTable">
        <thead>
            <tr>
                <th scope="col" class="text-center">#</th>
                <th scope="col">Slider Name</th>
                <th scope="col">Slider Description</th>
                <th scope="col">Slider Image</th>
                <th scope="col" class="text-center">Slider Status</th>
                <th scope="col" class="text-center">Slider Manage</th>
            </tr>
        </thead>
        <tbody>
                @{
                    int stt = (ViewBag.Pager.CurrentPage - 1) * ViewBag.Pager.PageSize + 1;
                }
            @foreach(var item in Model)
            {
                <tr>
                        <td class="text-center align-middle">
                            <span class="badge bg-secondary">@stt</span>
                        </td>
                    <td>@item.Name</td>
                    <td>@Html.Raw(@item.Description)</td>
                    <td><img src="~/media/sliders/@item.Image" width="400px" height="200px"/></td>
                    <td class="text-center">
                        @if (item.Status == 1)
                        {
                            <span class="status-badge status-active">Hiển thị</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">Ẩn</span>
                        }
                    </td>
                    <td class="text-center align-middle">
                        <div class="btn-group" role="group">
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    disabled
                                    title="Nothing to view">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <a asp-action="Edit"
                               asp-controller="Slider"
                               asp-route-Id="@item.Id"
                               class="btn btn-outline-warning btn-sm">
                                <i class="fa-solid fa-edit"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    onclick="deleteSlider(@item.Id)">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </td>

                </tr>
                    stt++;
            }
        

        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", ViewBag.Pager as E_commerce.Models.Paginate)
</div>
@* <partial name="_paging" model="@pager" /> *@
@section Scripts{
    <script>
        let table = new DataTable('#sliderTable');
    </script>

    <script>
        function deleteSlider(sliderId) {
            if (confirm('Are you sure you want to delete this color?')) {
                // Redirect đến action Delete với GET
                window.location.href = '@Url.Action("Delete", "Slider")?Id=' + sliderId;
            }
        }
    </script>
}