@{
    ViewData["title"] = "User Listed";
    // Paginate pager = new Paginate();

    // int pageNo = 0;

    // if (ViewBag.Pager != null)
    // {
    //     pager = ViewBag.Pager;

    //     pageNo = pager.CurrentPage;
    // }
}
<link rel="stylesheet" href="~/css/admin-index.css" />


<div class="top">
    <h2>List Users</h2>
    <!-- Add New Button -->
    <a asp-action="Create" asp-controller="User" class="add-button">Add User</a>
</div>

<div class="table-container">
    <table class="table table-hover" id="myTable">
        <thead>
            <tr>
                <th scope="col" class="text-center">#</th>
                <th scope="col">UserName</th>
                <th scope="col">Email</th>
                <th scope="col" class="text-center">Phone</th>
                <th scope="col" class="text-center">Role</th>
                <th scope="col" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = (ViewBag.Pager.CurrentPage - 1) * ViewBag.Pager.PageSize + 1;
            }
            @foreach (var usersWithRoles in Model.UsersWithRoles)
            {
                <tr>
                    <td class="text-center align-middle">
                        <span class="badge bg-secondary">@stt</span>
                    </td>
                    <td class="text-left align-middle">
                        <span class="user-name">@usersWithRoles.User.UserName</span>
                    </td>
                    <td class="text-left align-middle">
                        <span class="email-cell">@usersWithRoles.User.Email</span>
                    </td>

                    <td class="text-center align-middle">
                        <span class="badge bg-phone">@usersWithRoles.User.PhoneNumber</span>
                    </td>
                    <td class="text-center align-middle">
                        @{
                            string roleClass = usersWithRoles.RoleName switch
                            {
                                "Admin" => "role-admin",
                                "User" => "role-user",
                                "CustomerSupport" => "role-customersup",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @roleClass">@usersWithRoles.RoleName</span>
                    </td>

                    <td class="text-center align-middle">
                        <div class="btn-group" role="group">
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    disabled
                                    title="Nothing to view">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <a asp-action="Edit"
                               asp-controller="User"
                               asp-route-Id="@usersWithRoles.User.Id"
                               class="btn btn-outline-warning btn-sm">
                                <i class="fa-solid fa-edit"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    onclick="deleteUser('@usersWithRoles.User.Id')">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                stt++;
            }


        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", ViewBag.Pager as E_commerce.Models.Paginate)

@* <partial name="_paging" model="@pager" /> *@
@section Scripts {
    <script>
        let table = new DataTable('#userTable', {
        layout: {
                topStart: {
                    buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
                }
            }
        });
    </script>
    <script>
        function deleteUser(userId) {
            if (confirm('Are you sure you want to delete this user?')) {
                // Redirect đến action Delete với GET
                window.location.href = '@Url.Action("Delete", "User")?id=' + userId;
            }
        }
    </script>
}