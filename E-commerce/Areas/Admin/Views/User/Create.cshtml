@model AppUserModel
@{
    ViewData["title"] = "Create User";
}

<link rel="stylesheet" href="~/css/admin-create.css" />

<h4>Create User</h4>
<div class="container">
    <form asp-action="Create" enctype="multipart/form-data" class="form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label>UserName</label>
            <input asp-for="UserName"  placeholder="UserName" required />
            <span asp-validation-for="UserName" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email"  placeholder="Email" type="email" required />
            <span asp-validation-for="Email" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Phone Number</label>
            <input asp-for="PhoneNumber"  placeholder="Phone Number" type="tel" required />
            <span asp-validation-for="PhoneNumber" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input asp-for="PasswordHash"  placeholder="Password" type="password" required />
            <span asp-validation-for="PasswordHash" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Roles</label>
            <select asp-for="RoleId"  asp-items="ViewBag.Roles" required>
                <option value="">-- Choose a Role --</option>
            </select>
            <span asp-validation-for="RoleId" class="text-danger" />
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </form>

<a asp-action="Index" class="back-link">Back to List User</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}