@model ProductModel
@{
    ViewData["Title"] = "Create Product";
}

<link rel="stylesheet" href="~/css/admin-create.css" />


<h4>Create Product</h4>
<div class="container">
    <form asp-action="Create" enctype="multipart/form-data" class="form"> 
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label>Name</label>
            <input asp-for="Name" placeholder="Name" />
            <span asp-validation-for="Name" class="text-danger" />
        </div>
        <div class="form-group">
            <label>Price</label>
            <input asp-for="Price" pattern="[0-9.,]+" typing-price" placeholder="Price" />
            <span style="color:orange;" id="price-convert"></span>
            <span asp-validation-for="Price" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Warranty Period</label>
            <input asp-for="WarrantyPeriod" placeholder="Warranty Period" />
            <span asp-validation-for="WarrantyPeriod" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Category</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories">
                <option>--Choose a Category</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Brand</label>
            <select asp-for="BrandId" asp-items="ViewBag.Brands">
                <option>--Choose a Brand</option>
            </select>
            <span asp-validation-for="BrandId" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Image</label>
            <input asp-for="ImageUpload" />
            <span asp-validation-for="ImageUpload" class="text-danger" />
            <img id="imgpreview" class="pt-2" style="max-width: 200px; display:none;" />
        </div>

        <div class="form-group">
            <label>Image 2</label>
            <input asp-for="ImageUpload2" />
            <span asp-validation-for="ImageUpload2" class="text-danger" />
            <img id="imgpreview2" class="pt-2" style="max-width: 200px; display:none;" />
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" rows="16" placeholder="Description"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <h4>Add Variations (Optional)</h4>
        <button type="button" id="add-variation" class="btn btn-success">Add Variation</button>
        <div id="variations-container"></div>

        <div class="form-group">
            <button class="btn btn-primary" style="background:none">Create</button>
        </div>
    </form>
    <a asp-action="Index" class="back-link">Back to List User</a>
</div>



@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>

    <script>
        CKEDITOR.replace('Description', {
            uiColor: '#2e374a',
            height: 200,
            contentsCss: 'body { background-color: #182237; color: #b7bac1; font-family: inherit; margin: 8px; } p { margin: 0; color: #b7bac1; }',
            toolbar: [
                ['Bold', 'Italic', 'Underline'],
                ['NumberedList', 'BulletedList'],
                ['Link', 'Image']
            ]
        });
    </script>
    <script>
        $(".typing-price").on("keyup", function () {
            var currency_input = $(this).val();
            $("#price-convert").html(new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(currency_input));
        });

        function readURL(input, previewId) {
            if (input.files && input.files[0]) {
                let reader = new FileReader();
                reader.onload = function (e) {
                    $("#" + previewId).attr("src", e.target.result).show();
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        $("#ImageUpload").change(function () {
            readURL(this, "imgpreview");
        });

        $("#ImageUpload2").change(function () {
            readURL(this, "imgpreview2");
        });

        var materials = @Html.Raw(Json.Serialize(ViewBag.Materials));
        var colors = @Html.Raw(Json.Serialize(ViewBag.Colors));

        $(document).ready(function () {
            $("#add-variation").click(function () {
                var index = $(".variation").length;

                var materialOptions = `<option value="">--Choose a Material--</option>`;
                materials.forEach(function (mat) {
                    materialOptions += `<option value="${mat.value}">${mat.text}</option>`;
                });

                var colorOptions = `<option value="">--Choose a Color--</option>`;
                colors.forEach(function (col) {
                    colorOptions += `<option value="${col.value}">${col.text}</option>`;
                });

                var variationHtml = `
                            <div class="variation border p-3 my-2">
                                <h5>Variation ${index + 1}</h5>
                                <div class="form-group">
                                    <label>Material</label>
                                    <select name="Variations[${index}].MaterialId" class="form-control">
                                        ${materialOptions}
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Color</label>
                                    <select name="Variations[${index}].ColorId" class="form-control">
                                        ${colorOptions}
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Price</label>
                                    <input name="Variations[${index}].Price" class="form-control" />
                                </div>
                                <div class="form-group">
                                    <input type="hidden" name="Variations[${index}].Stock" value="0" />
                                </div>
                                <div class="form-group">
                                    <label>Size</label>
                                    <input name="Variations[${index}].Size" class="form-control" />
                                </div>
                                <div class="form-group">
                                    <label>Variation Image</label>
                                    <input type="file" name="VariationImages" class="form-control-file variation-image" accept="image/*" data-preview="variation-preview-${index}" />
                                    <img id="variation-preview-${index}" class="pt-2" style="max-width: 100px; display: none;" />
                                </div>
                            </div>`;

                $("#variations-container").append(variationHtml);
            });

            $("#variations-container").on("change", ".variation-image", function () {
                var input = this;
                var previewId = $(this).data("preview");
                readURL(input, previewId);
            });
        });
    </script>
}
