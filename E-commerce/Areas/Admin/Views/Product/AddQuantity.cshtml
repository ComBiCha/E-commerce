@model ProductQuantityModel
@{
    ViewData["title"] = "Add Quantity";
    var total_quantities = 0;
    var key = 1;
}
<h4>Add Quantity</h4>
<div class="col-md-9">
    <form asp-action="StoreProductQuantity" method="post">
        <input type="hidden" asp-for="VariationId" />

        <div class="form-group">
            <label>Quantity</label>
            <input type="number" asp-for="Quantity" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Add</button>
    </form>
    <h3>Existing Product Quantities:</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Quantity Added</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var productQuantity in ViewBag.ProductByQuantity)
            {
                total_quantities += productQuantity.Quantity;
                <tr>
                    <td>@key</td>
                    <td>@productQuantity.Quantity</td>
                    <td>@productQuantity.DateCreated</td>
                </tr>
                key++;
            }
            <tr>
                <td colspan="2"><strong>Total Quantities:</strong></td>
                <td><strong>@total_quantities</strong></td>
            </tr>
        </tbody>
    </table>

    <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Variation.ProductId" class="btn btn-secondary">
        Back to Product Details
    </a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}