@model E_commerce.Models.ViewModel.AddStockViewModel
@{
    ViewData["Title"] = "Add Quantity to Product Variation";
    var variation = Model.Variation;
}

<h4>Add Stock for: <span class="text-primary">@variation.Product.Name</span></h4>
<p>
    <strong>Variation:</strong> @variation.Size / @variation.Color?.Name / @variation.Material?.Name
</p>

<form asp-action="StoreProductQuantity" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Variation.Id" />

    <div class="form-group">
        <label asp-for="BatchCode">Batch Code <span class="text-danger">*</span></label>
        <input asp-for="BatchCode" class="form-control" placeholder="e.g. IMPORT20250625-001" />
        <span asp-validation-for="BatchCode" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="Quantity">Quantity <span class="text-danger">*</span></label>
        <input asp-for="Quantity" class="form-control" type="number" min="1" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Add Quantity</button>
</form>

<a asp-action="Details" asp-controller="Product" asp-route-id="@variation.ProductId" class="btn btn-secondary mt-3">
    Back to Product Details
</a>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
