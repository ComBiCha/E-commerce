@model E_commerce.Models.ProductModel

@{
    ViewData["Title"] = "Edit Product";
}

<h2>Edit Product</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Name">Product Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger" />
    </div>
    <div class="form-group">
        <label>WarrantyPeriod</label>
        <input asp-for="WarrantyPeriod" class="form-control" />
        <span asp-validation-for="WarrantyPeriod" class="text-danger" />
    </div>
    <div class="form-group">
        <label asp-for="Price">Price</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Category</label>
        <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
            <option>--Choose a Category</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger" />
    </div>
    <div class="form-group">
        <label>Brand</label>
        <select asp-for="BrandId" class="form-control" asp-items="ViewBag.Brands">
            <option>--Choose a Brand</option>
        </select>
        <span asp-validation-for="BrandId" class="text-danger" />
    </div>
    <div class="form-group">
        <label>Image</label>
        <input asp-for="ImageUpload" class="form-control-file" />
        <span asp-validation-for="ImageUpload" class="text-danger" />
        <img id="imgpreview" src="@Url.Content("~/media/products/" + ViewBag.OldImage)" alt="Current Image" class="pt-2" style="max-width: 200px; max-height: 200px;" />
    </div>
    <div class="form-group">
        <label>Image 2</label>
        <input asp-for="ImageUpload2" class="form-control-file" />
        <span asp-validation-for="ImageUpload2" class="text-danger" />
        <img id="imgpreview2" src="@Url.Content("~/media/products/" + ViewBag.OldImage2)" alt="Current Image2" class="pt-2" style="max-width: 200px; max-height: 200px;" />
    </div>
    <h3>Product Variations</h3>
    <div id="variations">
        @for (int i = 0; i < Model.Variations.Count; i++)
        {
            <input type="hidden" asp-for="Variations[i].Id" />
            <div class="variation-item">
                <h3></h3>
                <h4>Variations @(i+1):</h4>
                <div class="form-group">
                    <label asp-for="Variations[i].MaterialId">Material</label>
                    <select asp-for="Variations[i].MaterialId" asp-items="ViewBag.Materials" class="form-control"></select>
                </div>

                <div class="form-group">
                    <label asp-for="Variations[i].ColorId">Color</label>
                    <select asp-for="Variations[i].ColorId" asp-items="ViewBag.Colors" class="form-control"></select>
                </div>

                <div class="form-group">
                    <label asp-for="Variations[i].Price">Price</label>
                    <input asp-for="Variations[i].Price" type="number" step="0.01" class="form-control" required />
                </div>

                <div class="form-group">
                    <label asp-for="Variations[i].Stock">Stock</label>
                    <input asp-for="Variations[i].Stock" type="number" class="form-control" value="0" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="Variations[i].Size">Size</label>
                    <input asp-for="Variations[i].Size" type="number" class="form-control" required />
                </div>

                <div class="form-group">
                    <label>Variation Image</label>
                    <input type="file" name="VariationImages" class="form-control" />
                    @if (!string.IsNullOrEmpty(Model.Variations[i].ImageUrl))
                    {
                        <img src="~/media/variations/@Model.Variations[i].ImageUrl" width="100" />
                    }
                </div>
            </div>
        }
    </div>
    <button type="button" id="addVariation" class="btn btn-success">+ Add Variation</button>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
                $(document).ready(function () {
            function readURL(input, previewId) {
                if (input.files && input.files[0]) {
                    let reader = new FileReader();
                    reader.onload = function (e) {
                        $("#" + previewId).attr("src", e.target.result).width(200).height(200).show();
                    };
                    reader.readAsDataURL(input.files[0]);
                }
            }

            $("#ImageUpload").change(function () {
                readURL(this, "imgpreview");
            });

            $("#ImageUpload2").change(function () {
                readURL(this, "imgpreview2");
            });
        });
    </script>
    <script>
        CKEDITOR.replace('Description');
    </script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let addButton = document.getElementById("addVariation");

        if (addButton) {
            addButton.addEventListener("click", function () {
                console.log("Button clicked!"); // Kiểm tra sự kiện click
                
                let variationsContainer = document.getElementById("variations");
                let index = document.querySelectorAll(".variation-item").length; // Lấy số lượng variations hiện có
                
                let variationHtml = `
                    <div class="variation-item border p-3 mb-3" style="position: relative;">
                        <input type="hidden" name="Variations[${index}].Id" value="0" />
                        <h4>Variation ${index + 1}:</h4>

                        <div class="form-group">
                            <label>Material</label>
                            <select name="Variations[${index}].MaterialId" class="form-control">
                                @foreach (var material in ViewBag.Materials)
                                {
                                    <option value="@material.Value">@material.Text</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Color</label>
                            <select name="Variations[${index}].ColorId" class="form-control">
                                @foreach (var color in ViewBag.Colors)
                                {
                                    <option value="@color.Value">@color.Text</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Price</label>
                            <input type="number" name="Variations[${index}].Price" class="form-control" step="0.01" required />
                        </div>

                        <div class="form-group">
                            <input type="hidden" name="Variations[${index}].Stock" value="0" />
                        </div>

                        <div class="form-group">
                            <label>Size</label>
                            <input type="number" name="Variations[${index}].Size" class="form-control" required />
                        </div>

                        <div class="form-group">
                            <label>Variation Image</label>
                            <input type="file" name="VariationImages" class="form-control" />
                        </div>

                        <!-- Nút Remove -->
                        <button type="button" class="btn btn-danger btn-sm removeVariation" style="position: absolute; top: 10px; right: 10px;">
                            Remove
                        </button>
                    </div>
                `;

                variationsContainer.insertAdjacentHTML("beforeend", variationHtml);
            });

            // Lắng nghe sự kiện click trên toàn bộ variationsContainer
            document.getElementById("variations").addEventListener("click", function (e) {
                if (e.target.classList.contains("removeVariation")) {
                    e.target.closest(".variation-item").remove(); // Xóa variation khi ấn Remove
                }
            });
        } else {
            console.error("Button #addVariation not found!");
        }
    });
</script>



}