@model ProductModel

@{
    ViewData["Title"] = "Edit Product";
}

<h4>Edit Product</h4>
<div class="col-md-9">
    <form asp-action="Edit" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label>Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Price</label>
            <input asp-for="Price" class="form-control typing-price" />
            <span id="price-convert" style="color: orange;"></span>
            <span asp-validation-for="Price" class="text-danger" />
        </div>

        <div class="form-group">
            <label>WarrantyPeriod</label>
            <input asp-for="WarrantyPeriod" class="form-control" />
            <span asp-validation-for="WarrantyPeriod" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Category</label>
            <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories"></select>
            <span asp-validation-for="CategoryId" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Brand</label>
            <select asp-for="BrandId" class="form-control" asp-items="ViewBag.Brands"></select>
            <span asp-validation-for="BrandId" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Image</label>
            <input asp-for="ImageUpload" class="form-control-file" />
            <img id="imgpreview" src="@Url.Content("~/media/products/" + ViewBag.OldImage)" style="max-width: 200px;" />
        </div>

        <div class="form-group">
            <label>Image 2</label>
            <input asp-for="ImageUpload2" class="form-control-file" />
            <img id="imgpreview2" src="@Url.Content("~/media/products/" + ViewBag.OldImage2)" style="max-width: 200px;" />
        </div>

        <h4>Add Variations</h4>
        <button type="button" id="add-variation" class="btn btn-success mb-2">+ Add Variation</button>
        <div id="variations-container">
            @for (int i = 0; i < Model.Variations.Count; i++)
            {
                <div class="variation border p-3 my-2">
                    <input type="hidden" asp-for="Variations[@i].Id" />
                    <h5>Variation @(i + 1)</h5>
                    <div class="form-group">
                        <label>Material</label>
                        <select asp-for="Variations[@i].MaterialId" class="form-control" asp-items="ViewBag.Materials"></select>
                    </div>
                    <div class="form-group">
                        <label>Color</label>
                        <select asp-for="Variations[@i].ColorId" class="form-control" asp-items="ViewBag.Colors"></select>
                    </div>
                    <div class="form-group">
                        <label>Price</label>
                        <input asp-for="Variations[@i].Price" class="form-control" />
                    </div>
                    <div class="form-group">
                        <input type="hidden" asp-for="Variations[@i].Stock" />
                    </div>
                    <div class="form-group">
                        <label>Size</label>
                        <input asp-for="Variations[@i].Size" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Variation Image</label>
                        <input asp-for="Variations[@i].ImageUpload" class="form-control-file" />
                        @if (!string.IsNullOrEmpty(Model.Variations[i].ImageUrl))
                        {
                            <img src="~/media/variations/@Model.Variations[i].ImageUrl" width="100" />
                        }
                    </div>
                </div>
            }
        </div>

        <button class="btn btn-primary">Save Changes</button>
    </form>

    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('Description');

        var materials = @Html.Raw(Json.Serialize(ViewBag.Materials));
        var colors = @Html.Raw(Json.Serialize(ViewBag.Colors));

        $(document).ready(function () {
            $(".typing-price").on("keyup", function () {
                var input = $(this).val();
                $("#price-convert").html(new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(input));
            });

            $("#ImageUpload").change(function () {
                readURL(this, "imgpreview");
            });
            $("#ImageUpload2").change(function () {
                readURL(this, "imgpreview2");
            });

            $("#add-variation").click(function () {
                var index = $(".variation").length;

                var materialOptions = `<option value="">--Choose Material--</option>`;
                materials.forEach(mat => {
                    materialOptions += `<option value="${mat.value}">${mat.text}</option>`;
                });

                var colorOptions = `<option value="">--Choose Color--</option>`;
                colors.forEach(col => {
                    colorOptions += `<option value="${col.value}">${col.text}</option>`;
                });

                var html = `
                <div class="variation border p-3 my-2">
                    <input type="hidden" name="Variations[${index}].Id" value="0" />
                    <h5>Variation ${index + 1}</h5>
                    <div class="form-group">
                        <label>Material</label>
                        <select name="Variations[${index}].MaterialId" class="form-control">${materialOptions}</select>
                    </div>
                    <div class="form-group">
                        <label>Color</label>
                        <select name="Variations[${index}].ColorId" class="form-control">${colorOptions}</select>
                    </div>
                    <div class="form-group">
                        <label>Price</label>
                        <input name="Variations[${index}].Price" class="form-control" />
                    </div>
                    <div class="form-group">
                        <input type="hidden" name="Variations[${index}].Stock" value="0" />
                    </div>
                    <div class="form-group">
                        <label>Size</label>
                        <input name="Variations[${index}].Size" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Variation Image</label>
                        <input type="file" name="Variations[${index}].ImageUpload" class="form-control-file" />
                    </div>
                </div>`;

                $("#variations-container").append(html);
            });

            function readURL(input, previewId) {
                if (input.files && input.files[0]) {
                    let reader = new FileReader();
                    reader.onload = function (e) {
                        $("#" + previewId).attr("src", e.target.result).show();
                    };
                    reader.readAsDataURL(input.files[0]);
                }
            }
        });
    </script>
}
