@model IEnumerable<ProductModel>
@{
    ViewData["title"] = "Product Listed";
    // Paginate pager = new Paginate();
    // int pageNo = 0;
    // if (ViewBag.Pager != null)
    // {
    //     pager = ViewBag.Pager;
    //     pageNo = pager.CurrentPage;
    // }
}

<h3>List Products</h3>
<a asp-action="Create" asp-controller="Product">Add Product</a>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Product Name</th>
            <th scope="col">Product Description</th>
            <th scope="col">Total In Stock</th> <!-- Đổi tên cho rõ -->
            <th scope="col">Product Sold</th>
            <th scope="col">Product Price</th>
            <th scope="col">Product Image</th>
            <th scope="col">Product Slug</th>
            <th scope="col">Product Category</th>
            <th scope="col">Product Brand</th>
            <th scope="col">Product Manage</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Name</td>
                <td>@Html.Raw(item.Description)</td>
                <td><b>@item.TotalStock</b></td> <!-- Dùng thuộc tính tổng tồn kho mới từ controller -->
                <td style="text-align:center; color:coral"><b>@item.Sold</b></td>
                <td>@item.Price</td>
                <td><img src="~/media/products/@item.Image" width="120" /></td>
                <td>@item.Slug</td>
                <td>@item.Category.Name</td>
                <td>@item.Brand.Name</td>
                <td>
                    <a asp-action="Details" asp-controller="Product" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detail</a>
                    <a asp-action="Edit" class="btn btn-warning btn-sm" asp-controller="Product" asp-route-Id="@item.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>


