@model IEnumerable<ProductModel>
@{
    ViewData["title"] = "Product Listed";
    // Paginate pager = new Paginate();

    // int pageNo = 0;

    // if (ViewBag.Pager != null)
    // {
    //     pager = ViewBag.Pager;

    //     pageNo = pager.CurrentPage;
    // }
}

<link rel="stylesheet" href="~/css/admin-index.css" />

<div class="top">
    <h2>List Products</h2>
    <!-- Add New Button -->
    <a asp-action="Create" asp-controller="Product" class="add-button">Add Product</a>
</div>

<div class="table-container">
    <table class="table table-hover" id="myTable">
        <thead>
            <tr>
                <th scope="col" class="text-center">#</th>
                <th scope="col">Product</th>
                <th scope="col">Description</th>
                <th scope="col" class="text-center">Qty</th>
                <th scope="col" class="text-center">Sold</th>
                <th scope="col" class="text-center">Price</th>
                <th scope="col" class="text-center">Category</th>
                <th scope="col" class="text-center">Brand</th>
                <th scope="col" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center align-middle">
                        <span class="badge bg-secondary">#@item.Id</span>
                    </td>

                    <td class="product-cell">
                        <div class="d-flex align-items-center">
                            <img src="~/media/products/@item.Image"
                                 class="product-image me-3"
                                 alt="@item.Name" />
                            <div>
                                <div class="product-name">@item.Name</div>
                            </div>
                        </div>
                    </td>

                    <td class="description-cell">
                        @{
                            var firstLine = item.Description?.Split('\n')[0] ?? "";
                        }
                        <span>@Html.Raw(firstLine)</span>
                    </td>

                    <td class="text-center align-middle">
                        <span class="badge bg-primary">@item.Quantity</span>
                    </td>

                    <td class="text-center align-middle">
                        <span class="badge bg-warning">@item.Sold</span>
                    </td>

                    <td class="text-center align-middle">
                        <strong class="text-success">$@item.Price.ToString("N0")</strong>
                    </td>

                    <td class="text-center align-middle">
                        @{
                            string categoryClass = item.Category.Name switch
                            {
                                "Women's" => "badge-womens",
                                "Men's" => "badge-mens",
                                "Unisex" => "badge-unisex",
                                _ => "bg-info"
                            };
                        }
                        <span class="badge bg-info @categoryClass">@item.Category.Name</span>
                    </td>

                    <td class="text-center align-middle">
                        <span class="badge bg-secondary">@item.Brand.Name</span>
                    </td>

                    <td class="text-center align-middle">
                        <div class="btn-group" role="group">
                            <a asp-action="Details"
                               asp-controller="Product"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-info btn-sm">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <a asp-action="Edit"
                               asp-controller="Product"
                               asp-route-Id="@item.Id"
                               class="btn btn-outline-warning btn-sm">
                                <i class="fa-solid fa-edit"></i>
                            </a>
                            @if (item.Variations != null && item.Variations.Any())
                            {
                                <!-- Nếu còn variations - nút disabled với tooltip -->
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        disabled
                                        title="Delete all variations first">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            }
                            else
                            {
                                <!-- Nếu không còn variations - cho phép xóa bằng form -->
                                <form asp-action="DeleteProduct" method="post" style="display: inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this product?');">
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@await Html.PartialAsync("_Pagination", ViewBag.Pager as E_commerce.Models.Paginate)

