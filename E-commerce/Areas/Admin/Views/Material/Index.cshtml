@model IEnumerable<MaterialModel>
@{
    ViewData["title"] = "Material Listed";

    // Paginate pager = new Paginate();

    // int pageNo = 0;

    // if(ViewBag.Pager != null)
    // {
    //     pager = ViewBag.Pager;

    //     pageNo = pager.CurrentPage;
    // }
}
<link rel="stylesheet" href="~/css/admin-index.css" />

<div class="top">
    <h3>List Material</h3>
    <a asp-action="Create" asp-controller="Material" class="add-button">Add Material</a>
</div>

<div class="table-container">
    <table class="table table-hover" id="myTable">
        <thead>
            <tr>
                <th scope="col" class="text-center">#</th>
                <th scope="col">Material Name</th>
                <th scope="col" class="text-center">Material Manage</th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = (ViewBag.Pager.CurrentPage - 1) * ViewBag.Pager.PageSize + 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center align-middle">
                        <span class="badge bg-secondary">@stt</span>
                    </td>
                    <td>@item.Name</td>
                    <td class="text-center align-middle">
                        <div class="btn-group" role="group">
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    disabled
                                    title="Nothing to view">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <a asp-action="Edit"
                               asp-controller="Material"
                               asp-route-Id="@item.Id"
                               class="btn btn-outline-warning btn-sm">
                                <i class="fa-solid fa-edit"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    onclick="deleteMaterial(@item.Id)">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                stt++;
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", ViewBag.Pager as E_commerce.Models.Paginate)

</div>
@* <partial name="_paging" model="@pager" /> *@
@* @section Scripts {
    <script>
        let table = new DataTable('#categoryTable');
    </script>
} *@

<script>
    function deleteMaterial(materialId) {
        if (confirm('Are you sure you want to delete this material?')) {
            // Redirect đến action Delete với GET
            window.location.href = '@Url.Action("Delete", "Material")?Id=' + materialId;
        }
    }
</script>