            data.productsByBrand.forEach(item => {
                const row = `<tr><td>${item.brand}</td><td>${item.totalProducts}</td></tr>`;
                brandTableBody.insertAdjacentHTML("beforeend", row);
            });
        })
        .catch(error => console.error('Error fetching product statistics:', error));

    fetch('@Url.Action("GetTotalUserCount", "Statistic")')
        .then(response => response.json())
        .then(data => {
            console.log("Total Users:", data);
            // Giả sử bạn muốn hiển thị tổng số người dùng trong phần tử với id "userCount"
            document.getElementById("userCount").textContent = data;
        })
        .catch(error => console.error('Error fetching total user count:', error));
</script>

<script>
    // Get the modal and close button elements
    const modal = document.getElementById('customModal');
    const closeModalBtn = document.getElementById('closeModal');

    // Open the modal
    function openRevenueModal() {
        // Show the modal
        modal.style.display = "flex";

        // Fetch today's revenue and revenue growth
        fetch('@Url.Action("GetTodayRevenue", "Statistic")')
            .then(response => response.json())
            .then(data => {
                if (data.totalRevenue !== undefined) {
                    document.getElementById("todayRevenue").textContent =
                        new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(data.totalRevenue);
                } else {
                    console.error(data.message || "Failed to fetch today's revenue.");
                    document.getElementById("todayRevenue").textContent = "N/A";
                }
            })
            .catch(error => {
                console.error('Error fetching today\'s revenue:', error);
                document.getElementById("todayRevenue").textContent = "Error";
            });

        fetch('@Url.Action("GetCurrentMonthRevenueGrowth", "Statistic")')
            .then(response => response.json())
            .then(data => {
                if (data.message) {
                    console.error(data.message);
                    document.getElementById("currentMonth").textContent = "N/A";
                    document.getElementById("previousMonth").textContent = "N/A";
                    document.getElementById("growth").textContent = "N/A";
                    return;
                }

                document.getElementById("currentMonth").textContent = data.currentMonth;
                document.getElementById("previousMonth").textContent = data.previousMonth;

                const growthPercentage = data.growth.toFixed(2);
                const growthText = growthPercentage > 0
                    ? `+${growthPercentage}%`
                    : `${growthPercentage}%`;

                document.getElementById("growth").textContent = growthText;
            })
            .catch(error => {
                console.error('Error fetching revenue growth data:', error);
                document.getElementById("currentMonth").textContent = "Error";
                document.getElementById("previousMonth").textContent = "Error";
                document.getElementById("growth").textContent = "Error";
            });
    }

    // Close the modal when the user clicks the close button
    closeModalBtn.addEventListener('click', () => {
        modal.style.display = "none";  // Hide the modal
    });

    // Close the modal if the user clicks outside of the modal content
    window.addEventListener('click', (event) => {
        if (event.target === modal) {
            modal.style.display = "none";
        }
    });

</script>

