    var ctxPie = document.getElementById("quarterlyRevenueChart").getContext("2d");

    fetch('@Url.Action("GetQuarterlyRevenue", "Statistic")')
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok: ' + response.statusText);
            }
            return response.json();
        })
        .then(data => {
            console.log("Quarterly Revenue Data: ", data);

            // Extract revenue data for each quarter
            const quarters = data.map(item => item.quarter);
            const revenues = data.map(item => item.revenue);

            // Create the pie chart
            new Chart(ctxPie, {
                type: 'pie', // Pie chart type
                data: {
                    labels: quarters, // Quarters names
                    datasets: [{
                        label: 'Quarterly Revenue',
                        data: revenues, // Revenue for each quarter
                        backgroundColor: ['#FF5733', '#33FF57', '#3357FF', '#FF33A1'], // Customize colors for each slice
