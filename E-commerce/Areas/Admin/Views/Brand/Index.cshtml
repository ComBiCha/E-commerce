@model IEnumerable<BrandModel>
@{
    ViewData["title"] = "Brand Listed";
    // Paginate pager = new Paginate();

    // int pageNo = 0;

    // if (ViewBag.Pager != null)
    // {
    //     pager = ViewBag.Pager;

    //     pageNo = pager.CurrentPage;
    // }
}
<link rel="stylesheet" href="~/css/admin-index.css" />

<div class="top">
    <h3>List Brand</h3>
    <a asp-action="Create" asp-controller="Brand" class="add-button">Add Brand</a>
</div>

<div class="table-container">
    <table class="table table-hover" id="myTable">
        <thead>
            <tr>
                <th scope="col" class="text-center">#</th>
                <th scope="col">Brand Name</th>
                <th scope="col">Brand Description</th>
                <th scope="col">Brand Slug</th>
                <th scope="col" class="text-center">Brand Status</th>
                <th scope="col" class="text-center">Brand Manage</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center align-middle">
                        <span class="badge bg-secondary">#@item.Id</span>
                    </td>
                    <td>@item.Name</td>
                    <td>@Html.Raw(@item.Description)</td>
                    <td>@item.Slug</td>
                    <td class="text-center">
                        @if (item.Status == 1)
                        {
                            <span class="status-badge status-active">Hiển thị</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">Ẩn</span>
                        }
                    </td>
                    <td class="text-center align-middle">
                        <div class="btn-group" role="group">
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    disabled
                                    title="Nothing to view">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <a asp-action="Edit"
                               asp-controller="Brand"
                               asp-route-Id="@item.Id"
                               class="btn btn-outline-warning btn-sm">
                                <i class="fa-solid fa-edit"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    onclick="deleteBrand(@item.Id)">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }


        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", ViewBag.Pager as E_commerce.Models.Paginate)

</div>
@* <partial name="_paging" model="@pager" /> *@
@* @section Scripts {
    <script>
        let table = new DataTable('#brandTable');
    </script>
} *@

<script>
    function deleteBrand(brandId) {
        if (confirm('Are you sure you want to delete this brand?')) {
            // Redirect đến action Delete với GET
            window.location.href = '@Url.Action("Delete", "Brand")?Id=' + brandId;
        }
    }
</script>