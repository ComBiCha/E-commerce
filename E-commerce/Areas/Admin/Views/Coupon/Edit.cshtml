@model CouponModel
@{
    ViewData["title"] = "Edit Coupon";
}
<link rel="stylesheet" href="~/css/admin-edit.css" />

<h4>Edit Brand</h4>
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="form">
        <input asp-for="Id" type="hidden" />
        
        <div class="form-group">
            <label asp-for="Code">Coupon Code</label>
            <input asp-for="Code" class="form-control" required />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="DiscountAmount">Discount Amount</label>
            <input asp-for="DiscountAmount" class="form-control" type="number" step="0.01" required />
            <span asp-validation-for="DiscountAmount" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="IsPercentage">Discount Type</label>
            <select asp-for="IsPercentage" class="form-control" required>
                <option value="false">Fixed Amount</option>
                <option value="true">Percentage</option>
            </select>
            <span asp-validation-for="IsPercentage" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MinOrderValue">Minimum Order Value</label>
            <input asp-for="MinOrderValue" class="form-control" type="number" />
            <span asp-validation-for="MinOrderValue" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MaxUsage">Maximum Usage</label>
            <input asp-for="MaxUsage" class="form-control" type="number" />
            <span asp-validation-for="MaxUsage" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="UsedCount">Used Count</label>
            <input asp-for="UsedCount" class="form-control" type="number" readonly />
            <span asp-validation-for="UsedCount" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ExpiryDate">Expiry Date</label>
            <input asp-for="ExpiryDate" class="form-control" type="datetime-local" required />
            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
        </div>

    <button type="submit" class="btn btn-primary coupon-submit">Update Coupon</button>
    </form>
    
    <a asp-action="Index" class="back-link">Back to List Coupon</a>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}