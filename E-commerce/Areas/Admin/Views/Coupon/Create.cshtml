@model CouponModel
@{
    ViewData["title"] = "Create Coupon";
}
<link rel="stylesheet" href="~/css/admin-create.css" />

<h4>Create Coupon</h4>
<div class="container">
    <form asp-action="Create" enctype="multipart/form-data" class="form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label>Code</label>
            <input asp-for="Code" placeholder="Code" />
            <span asp-validation-for="Code" class="text-danger" />
        </div>
        <div class="form-group">
            <label>Discount Amount</label>
            <input asp-for="DiscountAmount" placeholder="DiscountAmount" type="number" step="0.01" />
            <span asp-validation-for="DiscountAmount" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Percentage / Fixed Amount</label>
            <select asp-for="IsPercentage">
                <option value="true">Percentage (%)</option>
                <option value="false">Fixed Amount</option>
            </select>
            <span asp-validation-for="IsPercentage" class="text-danger" />
        </div>
        <div class="form-group">
            <label>Min Order Value</label>
            <input asp-for="MinOrderValue" placeholder="MinOrderValue" type="number" />
            <span asp-validation-for="MinOrderValue" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Max Usage</label>
            <input asp-for="MaxUsage" placeholder="MaxUsage" type="number" />
            <span asp-validation-for="MaxUsage" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Expiry Date</label>
            <input asp-for="ExpiryDate" placeholder="ExpiryDate" type="datetime-local" />
            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
        </div>
        <input asp-for="UsedCount" type="number" hidden readonly value="0" />
        <span asp-validation-for="UsedCount" class="text-danger"></span>
        <div class="form-group">
            <button class="btn btn-primary">Create</button>
        </div>

    </form>
    <a asp-action="Index" class="back-link">Back to List Coupon</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}