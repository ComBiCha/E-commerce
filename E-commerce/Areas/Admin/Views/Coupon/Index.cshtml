@model IEnumerable<CouponModel>
@{
    ViewData["title"] = "Coupon Listed";
    // Paginate pager = new Paginate();

    // int pageNo = 0;

    // if (ViewBag.Pager != null)
    // {
    //     pager = ViewBag.Pager;

    //     pageNo = pager.CurrentPage;
    // }
}
<link rel="stylesheet" href="~/css/admin-index.css" />

<div class="top">
    <h3>List Coupon</h3>
    <a asp-action="Create" asp-controller="Coupon" class="add-button">Add Coupon</a>
</div>

<div class="table-container">
    <table class="table table-hover" id="myTable">
        <thead>
            <tr>
                <th scope="col" class="text-center">#</th>
                <th scope="col" style="text-align:left">Coupon Code</th>
                <th scope="col" style="text-align:left">Discount Amount</th>
                <th scope="col" style="text-align:left">Min Ord Value</th>
                <th scope="col" style="text-align:left">Max Usage</th>
                <th scope="col" style="text-align:left">Used Count</th>
                <th scope="col" style="text-align:left">Expiry Date</th>
                <th scope="col" class="text-center">Coupon Manage</th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = (ViewBag.Pager.CurrentPage - 1) * ViewBag.Pager.PageSize + 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center align-middle">
                        <span class="badge bg-secondary">@stt</span>
                    </td>
                    <td>@item.Code</td>
                    <td style="text-align:left">
                        @item.DiscountAmount @(item.IsPercentage ? "%" : "$")
                    </td>
                    <td style="text-align:left">@item.MinOrderValue</td>
                    <td style="text-align:left">@item.MaxUsage</td>
                    <td style="text-align:left">@item.UsedCount</td>
                    <td>@item.ExpiryDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-center align-middle">
                        <div class="btn-group" role="group">
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    disabled
                                    title="Nothing to view">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <a asp-action="Edit"
                               asp-controller="Coupon"
                               asp-route-Id="@item.Id"
                               class="btn btn-outline-warning btn-sm">
                                <i class="fa-solid fa-edit"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    disabled
                                    title="Nothing to view">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                stt++;
            }


        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", ViewBag.Pager as E_commerce.Models.Paginate)

</div>
