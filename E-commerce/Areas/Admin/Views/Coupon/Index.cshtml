@model IEnumerable<CouponModel>
@{
    ViewData["title"] = "Coupon Listed";
    // Paginate pager = new Paginate();

    // int pageNo = 0;

    // if (ViewBag.Pager != null)
    // {
    //     pager = ViewBag.Pager;

    //     pageNo = pager.CurrentPage;
    // }
}
<h3>List Coupon</h3>
<a asp-action="Create" asp-controller="Coupon">Add Coupon</a>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Coupon Code</th>
            <th scope="col">Coupon Discount Amount</th>
            <th scope="col">Coupon Min Order Value</th>
            <th scope="col">Coupon Max Usage</th>
            <th scope="col">Coupon Used Count</th>
            <th scope="col">Coupon Expiry Date</th>
            <th scope="col">Coupon Manage</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Code</td>
                <td>
                    @item.DiscountAmount @(item.IsPercentage ? "%" : "$")
                </td>
                <td>@item.MinOrderValue</td>
                <td>@item.MaxUsage</td>
                <td>@item.UsedCount</td>
                <td>@item.ExpiryDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a asp-action="Edit" class="btn btn-warning btn-sm" asp-controller="Coupon" asp-route-Id="@item.Id">Edit</a>
                    <a asp-action="Delete" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Coupon" asp-route-Id="@item.Id">Delete</a>
                </td>
            </tr>
        }


    </tbody>
</table>
