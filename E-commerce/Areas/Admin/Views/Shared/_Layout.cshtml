<style>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	body {
		background-color: #0f172a; /* Background màu đen xanh đậm */
	}

	.dashboard-container {
		display: flex;
		background-color: #0f172a;
		color: white;
	}

	.sidebar-wrapper {
		width: 280px;
		background-color: #182237;
		flex-shrink: 0;
	}

	.main-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		padding: 20px; /* Padding cho main content để tạo gap */
		background-color: #0f172a; /* Background giữa các gap */
	}

	.navbar-wrapper {
		background-color: #182237;
		border-radius: 10px;
		margin-bottom: 20px; /* Gap giữa navbar và content */
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
	}

	.content-wrapper {
		flex: 1;
		overflow-y: auto;
		overflow-x: auto; 
		padding: 20px;
		background-color: #182237;
		border-radius: 10px;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
	}

	.footer-wrapper {
		flex-shrink: 0;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
	}
</style>