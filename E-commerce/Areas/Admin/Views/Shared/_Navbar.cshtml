<div class="navbar-container">
    <div class="title">
        @{
            var controller = ViewContext.RouteData.Values["controller"]?.ToString();
            var action = ViewContext.RouteData.Values["action"]?.ToString();
            var displayTitle = $"{controller} {action}";
        }
        @displayTitle
    </div>

    <div class="menu">
        <div class="search">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                <path fill="currentColor" d="m19.6 21l-6.3-6.3q-.75.6-1.725.95T9.5 16q-2.725 0-4.612-1.888T3 9.5t1.888-4.612T9.5 3t4.613 1.888T16 9.5q0 1.1-.35 2.075T14.7 13.3l6.3 6.3zM9.5 14q1.875 0 3.188-1.312T14 9.5t-1.312-3.187T9.5 5T6.313 6.313T5 9.5t1.313 3.188T9.5 14" />
            </svg>            
            <input type="text" placeholder="Search..." class="input" />
        </div>

        <div class="icons">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                <path fill="currentColor" d="M2 22V2h20v16H6zm3.15-6H20V4H4v13.125zM4 16V4zm2-2h8v-2H6zm0-3h12V9H6zm0-3h12V6H6z" />
            </svg>            
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                <path fill="currentColor" d="M4 19v-2h2v-7q0-2.075 1.25-3.687T10.5 4.2V2h3v2.2q2 .5 3.25 2.113T18 10v7h2v2zm8 3q-.825 0-1.412-.587T10 20h4q0 .825-.587 1.413T12 22m-4-5h8v-7q0-1.65-1.175-2.825T12 6T9.175 7.175T8 10z" />
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                <path fill="currentColor" d="M12 22q-2.075 0-3.9-.788t-3.175-2.137T2.788 15.9T2 12t.788-3.9t2.137-3.175T8.1 2.788T12 2t3.9.788t3.175 2.137T21.213 8.1T22 12t-.788 3.9t-2.137 3.175t-3.175 2.138T12 22m-1-2.05V18q-.825 0-1.412-.587T9 16v-1l-4.8-4.8q-.075.45-.137.9T4 12q0 3.025 1.988 5.3T11 19.95m6.9-2.55q1.025-1.125 1.563-2.512T20 12q0-2.45-1.362-4.475T15 4.6V5q0 .825-.587 1.413T13 7h-2v2q0 .425-.288.713T10 10H8v2h6q.425 0 .713.288T15 13v3h1q.65 0 1.175.388T17.9 17.4" />
            </svg>
        </div>
    </div>
</div>

<style>
    .navbar-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 30px;
        background-color: #182237;
        color: #b7bac1;
        border-radius: 10px;
    }

    .title {
        font-size: 20px;
        font-weight: bold;
        text-transform: capitalize;
        color: #b7bac1;
    }

    .menu {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .search {
        display: flex;
        align-items: center;
        gap: 10px;
        background-color: #1e293b;
        padding: 10px 15px;
        border-radius: 8px;
        border: 1px solid #374151;
    }

        .search i {
            color: #9ca3af;
        }

    .input {
        background-color: transparent;
        border: none;
        color: white;
        outline: none;
        width: 250px;
        font-size: 14px;
    }

        .input::placeholder {
            color: #9ca3af;
        }

    .icons {
        display: flex;
        align-items: center;
        gap: 20px;
    }

        .icons svg {
            color: white;
            font-size: 20px;
            cursor: pointer;
            transition: color 0.3s;
        }

            .icons svg:hover {
            color: #9ca3af;
                cursor: pointer;
            }
</style>
