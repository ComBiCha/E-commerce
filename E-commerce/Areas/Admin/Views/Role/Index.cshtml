@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>


@{
    ViewData["title"] = "Role Listed";
    Paginate pager = new Paginate();

    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;

        pageNo = pager.CurrentPage;
    }
}
<link rel="stylesheet" href="~/css/admin-index.css" />

<div class="top">
    <h3>List Role</h3>
    <a asp-action="Create" asp-controller="Role" class="add-button">Add Role</a>
</div>

<div class="table-container">
    <table class="table table-hover" id="myTable">
        <thead>
            <tr>
                <th scope="col" class="text-center">Role Id</th>
                <th scope="col">Role Name</th>
                <th scope="col" class="text-center">Role Manage</th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = (ViewBag.Pager.CurrentPage - 1) * ViewBag.Pager.PageSize + 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center align-middle">
                        <span class="badge bg-secondary">@stt</span>
                    </td>
                    <td>@item.Name</td>
                    <td class="text-center align-middle">
                        <div class="btn-group" role="group">
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    disabled
                                    title="Nothing to view">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <a asp-action="Edit"
                               asp-controller="Role"
                               asp-route-Id="@item.Id"
                               class="btn btn-outline-warning btn-sm">
                                <i class="fa-solid fa-edit"></i>
                            </a>
                            <a asp-action="Delete"
                               class="btn btn-outline-danger btn-sm confirmDeletion"
                                    asp-controller="Role"
                                    asp-route-Id="@item.Id">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                stt++;
            }


        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", ViewBag.Pager as E_commerce.Models.Paginate)

</div>

<script>
        function deleteRole(roleId) {
        if (confirm('Are you sure you want to delete this role?')) {
            // Sửa: Id thành id
            window.location.href = '@Url.Action("Delete", "Role")?id=' + roleId;
        }
    }
</script>