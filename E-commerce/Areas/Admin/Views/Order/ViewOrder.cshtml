@model IEnumerable<OrderDetails>
@{
    ViewData["title"] = "Order Details";
    decimal total = 0;
    decimal subtotal = 0;
}
<link rel="stylesheet" href="~/css/admin-detail.css" />

@* For Admin *@
<div class="order-details-container">
    <h3>Order Details</h3>

    <div class="order-details-shipping-address">
        <h4>Shipping Address: <span>@ViewBag.Order.Address</span></h4>
    </div>

    <div class="order-details-table-section">
        <table class="table order-details-table" id="orderdetailsTable">
            <thead>
                <tr>
                    <th scope="col" class="order-details-col-id">#</th>
                    <th scope="col" class="order-details-col-code">Order Code</th>
                    <th scope="col" class="order-details-col-username">UserName</th>
                    <th scope="col" class="order-details-col-product">Product Name</th>
                    <th scope="col" class="order-details-col-price">Product Price</th>
                    <th scope="col" class="order-details-col-image">Product Image</th>
                    <th scope="col" class="order-details-col-quantity">Quantity</th>
                    <th scope="col" class="order-details-col-subtotal">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    decimal itemSubtotal = item.Quantity * (item.Price - (item.DiscountAmount/item.Quantity)); // Tính tổng giá sau giảm cho từng item
                    subtotal += itemSubtotal;
                    total += itemSubtotal; // Cập nhật tổng tiền đã giảm
                    <tr>
                        <input type="hidden" asp-for="@item.OrderCode" class="getId" />
                        <th>@item.Id</th>
                        <td>@item.OrderCode</td>
                        <td>@item.UserName</td>
                        <td>@item.Product.Name - [@item.Variation.Material.Name|@item.Variation.Color.Name|Size:@item.Variation.Size]</td>
                        <td>
                            @if (item.DiscountAmount > 0)
                            {
                                <p class="order-details-original-price">$ @item.Price.ToString("N0")</p>
                                <p class="order-details-discounted-price">$@((item.Price - (item.DiscountAmount / item.Quantity)).ToString("N0"))</p>
                            }
                            else
                            {
                                <p class="order-details-regular-price">$@item.Price.ToString("N0")</p>
                            }
                        </td>
                        <td><img src="~/media/variations/@item.Variation.ImageUrl" class="order-details-product-image" width="120" /></td>
                        <td>@item.Quantity</td>
                        <td>$@subtotal.ToString("N0")</td>
                    </tr>
                }
                <!-- The total row is now outside the loop -->
                <tr class="order-details-total-row">
                    <td class="order-details-product-total">Product Total:</td>
                    <td class="order-details-total-amount">$@total.ToString("N0")</td>

                    <td class="order-details-shipping-label">Shipping Cost:</td>
                    <td class="order-details-shipping-amount">$@ViewBag.Order.ShippingCost.ToString("N0")</td>

                    <td class="order-details-grand-label">Grand Total:</td>
                    <td class="order-details-grand-amount">
                        $@((total + ViewBag.Order.ShippingCost).ToString("N0"))
                    </td>

                    <td class="order-details-button-cell">
                        @if (ViewBag.Order.Status != 6 && ViewBag.Order.Status < 5)
                        {
                            <button id="statusUpdateButton" class="order-status-update-btn">
                                @{
                                    var buttonText = ViewBag.Order.Status switch
                                    {
                                        1 => "Confirm",
                                        2 => "Ship",
                                        3 => "Deliver",
                                        4 => "Complete",
                                        _ => "Completed"
                                    };
                                    @buttonText
                                }
                            </button>
                        }
                        else if (ViewBag.Order.Status == 5)
                        {
                            <!-- Không hiện button gì cả hoặc hiện text -->
                        }
                    </td>

                    <td class="order-details-status-cell">
                        <span id="orderStatusText">
                            @if (ViewBag.Order.Status == 1)
                            {
                                <span class="order-status-new">New</span>
                            }
                            else if (ViewBag.Order.Status == 2)
                            {
                                <span class="order-status-confirmed">Confirmed</span>
                            }
                            else if (ViewBag.Order.Status == 3)
                            {
                                <span class="order-status-shipping">Shipping</span>
                            }
                            else if (ViewBag.Order.Status == 4)
                            {
                                <span class="order-status-delivered">Delivered</span>
                            }
                            else if (ViewBag.Order.Status == 5)
                            {
                                <span class="order-status-completed">Completed</span>
                            }
                            else if (ViewBag.Order.Status == 6)
                            {
                                <span class="order-status-cancelled">Cancelled</span>
                            }
                        </span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <a asp-action="Index" class="back-link">Back to List Order</a>
</div>
@section Scripts{
    <script>
        $(document).ready(function () {
            // Initialize the JavaScript variable for current status
            var currentStatus = @ViewBag.Order.Status;

            $('#statusUpdateButton').click(function () {
                var ordercode = $('.getId').val(); // Assuming there's an input with the OrderCode

                // If the status is already at "Success", disable the button
                if (currentStatus >= 5) {
                    Swal.fire({
                        icon: "info",
                        title: "Đơn hàng đã hoàn thành",
                        text: "Đơn hàng này đã hoàn thành!",
                    });
                    return;
                }

                // Increment status on each button click
                var newStatus = currentStatus + 1;

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UpdateOrder")",
                    data: { status: newStatus, ordercode: ordercode },
                    success: function (result) {
                        if (result.success) {
                            // Update button text and status display based on the new status
                            var buttonText = "";
                            var statusText = "";
                            switch (newStatus) {
                                case 2:
                                    buttonText = "Ship";
                                    statusText = "<span class='order-status-confirmed'>Confirmed</span>";
                                    break;
                                case 3:
                                    buttonText = "Deliver";
                                    statusText = "<span class='order-status-shipping'>Shipping</span>";
                                    break;
                                case 4:
                                    buttonText = "Complete";
                                    statusText = "<span class='order-status-delivered'>Delivered</span>";
                                    break;
                                case 5:
                                    statusText = "<span class='order-status-completed'>Completed</span>";
                                    $('#statusUpdateButton').addClass('order-completed');
                                    break;
                                default:
                                    buttonText = "Confirm";
                                    statusText = "<span class='order-status-new'>New</span>";
                                    break;
                            }
                            $('#statusUpdateButton').text(buttonText);
                            $('#orderStatusText').html(statusText);

                            // Update the JavaScript variable `currentStatus`
                            currentStatus = newStatus;

                            Swal.fire({
                                icon: "success",
                                title: "Yayyy",
                                text: "Order status updated successfully!",
                            });
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Oops...",
                                text: "Update failed: " + result.message,
                            });
                        }
                    }
                });
            });
        });
    </script>



    <script>
        let table = new DataTable('#orderdetailsTable', {
        layout: {
                topStart: {
                    buttons: ['pdf', 'print']
                }
            }
        });
    </script>
}