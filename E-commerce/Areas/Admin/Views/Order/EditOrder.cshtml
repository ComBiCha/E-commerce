@model E_commerce.Models.ViewModel.EditOrderViewModel

<link rel="stylesheet" href="~/css/admin-edit.css" />

<div class="edit-order-container">
    <h2>Edit Order</h2>
    <form method="post" action="/Admin/Order/EditOrder" class="edit-order-form">
        <input type="hidden" name="Order.Id" value="@Model.Order.Id" />

        <div class="edit-order-fields">
            <div class="edit-order-field">
                <label>Order Code:</label>
                <input type="text" name="Order.OrderCode" value="@Model.Order.OrderCode" readonly />
            </div>
            <div class="edit-order-field">
                <label>User Name:</label>
                <input type="text" name="Order.UserName" value="@Model.Order.UserName" />
            </div>
            <div class="edit-order-field">
                <label>Address:</label>
                <input type="text" name="Order.Address" value="@Model.Order.Address" />
            </div>
            <div class="edit-order-field">
                <label>Shipping Cost:</label>
                <input type="number" step="0.01" name="Order.ShippingCost" value="@Model.Order.ShippingCost" />
            </div>
        </div>


        <h3>Order Details</h3>
        <div class="edit-order-table-section">
            @if (Model.OrderDetails != null && Model.OrderDetails.Any())
            {
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="edit-order-validation">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    </div>
                }

                <table class="edit-order-table">
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>Price</th>
                            <th>Product Image</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.OrderDetails.Count; i++)
                        {
                            var detail = Model.OrderDetails[i];
                            <tr>
                                <td>@detail.Product.Name - [@detail.Variation.Material.Name|@detail.Variation.Color.Name|Size:@detail.Variation.Size]</td>
                                <td class="edit-order-price">$@detail.Price.ToString("N0")</td>
                                <td>
                                    <img src="~/media/variations/@detail.Variation.ImageUrl"
                                         class="edit-order-product-image"
                                         width="120" />
                                </td>
                                <td>
                                    <input type="number"
                                           name="OrderDetails[@i].Quantity"
                                           value="@detail.Quantity"
                                           min="1"
                                           class="edit-order-quantity-input" />
                                    <input type="hidden" name="OrderDetails[@i].Id" value="@detail.Id" />
                                </td>
                                <td class="edit-order-subtotal">
                                    $@((detail.Price * detail.Quantity - detail.DiscountAmount).ToString("N0"))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="edit-order-empty-state">
                    <p>No order details available.</p>
                </div>
            }
        </div>

        <button type="submit" class="edit-order-submit-btn">Save Changes</button>

    </form>
</div>
