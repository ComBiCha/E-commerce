@{
    ViewData["Title"] = "Lucky Box";
}

<div class="lucky-container">
    <div class="lucky-boxes">
        <div class="gift-box-container"><div class="gift-box"><div class="gift-lid"></div><div class="gift-ribbon"></div></div></div>
        <div class="gift-box-container"><div class="gift-box"><div class="gift-lid"></div><div class="gift-ribbon"></div></div></div>
        <div class="gift-box-container"><div class="gift-box"><div class="gift-lid"></div><div class="gift-ribbon"></div></div></div>
        <div class="gift-box-container"><div class="gift-box"><div class="gift-lid"></div><div class="gift-ribbon"></div></div></div>
        <div class="gift-box-container"><div class="gift-box"><div class="gift-lid"></div><div class="gift-ribbon"></div></div></div>
        <div class="gift-box-container"><div class="gift-box"><div class="gift-lid"></div><div class="gift-ribbon"></div></div></div>
        <div class="gift-box-container"><div class="gift-box"><div class="gift-lid"></div><div class="gift-ribbon"></div></div></div>
        <div class="gift-box-container"><div class="gift-box"><div class="gift-lid"></div><div class="gift-ribbon"></div></div></div>
        <div class="gift-box-container"><div class="gift-box"><div class="gift-lid"></div><div class="gift-ribbon"></div></div></div>
    </div>

    <div id="result" class="mt-4"></div>

    <div id="voucher-float" class="voucher-float" style="display:none;">
        <div class="voucher-content"></div>
    </div>

    <div class="voucher-area">
        <div class="gacha-desc">
            <b>Hướng dẫn:</b><br>
            - 1 đơn đặt hàng thành công = <span class="gacha-point">1 điểm</span><br>
            - 1 lần quay = <span class="gacha-point">1 điểm</span><br>
            - Tích điểm để nhận thêm lượt quay và voucher hấp dẫn!
        </div>

        <div class="voucher-board" id="voucher-board">
            <h3>🎫 Voucher của bạn</h3>
            <div class="voucher-list" id="voucher-list">
                <div style="color:#888;font-size:1.5rem;">Chưa có voucher nào</div>
            </div>
        </div>
        <div class="spin-info">
            <span id="spin-count">Lượt quay: 3</span>
        </div>
        <button id="spin-btn">Spin</button>
</div>
</div>


<style>
.lucky-container {
    background: #111;
    min-height: 100vh;
    padding: 10rem 0.7rem 15rem 0.7rem;
    font-family: Arial, Helvetica, sans-serif;
}
.lucky-boxes {
    display: grid;
    grid-template-columns: repeat(3, 120px);
    grid-gap: 80px;
    justify-content: center;
    margin: 60px 0 30px 0;
    margin-right: 320px; /* Đẩy các hộp quà sang trái, tránh sát bảng voucher */
    position: relative;
}

.gift-box-container {
    position: relative;
    width: 100px;
    height: 90px;
}

.gift-box {
    width: 100px;
    height: 90px;
    background: linear-gradient(145deg, #fff 60%, #e0f7fa 100%);
    border-radius: 16px;
    box-shadow: 0 8px 32px #5af2b288, 0 2px 8px #0002;
    position: absolute;
    left: 0; 
    top: 0;
    cursor: pointer;
    transition: transform 0.2s;
    overflow: visible;
    border: 4px solid #5af2b2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    transition: transform 0.7s cubic-bezier(.7,-0.2,.5,1.5);
}


.gift-box:hover {
    transform: scale(1.06) rotate(-2deg);
    box-shadow: 0 12px 40px #5af2b2cc;
}
.gift-lid {
    width: 104px;
    height: 32px;
    background: linear-gradient(90deg, #ff5252 60%, #ffb347 100%);
    border-radius: 18px 18px 12px 12px;
    position: absolute;
    top: -28px;
    left: -6px;
    z-index: 2;
    box-shadow: 0 4px 16px #ffb34788;
    transition: transform 1s cubic-bezier(.7,-0.2,.5,1.5);
    transform-origin: bottom center;
}
.gift-box.opening .gift-lid {
    animation: lid-fly 1.2s cubic-bezier(.7,-0.2,.5,1.5) forwards;
}
@@keyframes lid-fly {
    0% { transform: none; }
    60% { transform: translateY(-20px) rotate(-18deg) scaleY(0.9);}
    100% { transform: translateY(-60px) rotate(-25deg) scaleY(0.7);}
}
.gift-box.opened .gift-lid {
    transform: translateY(-60px) rotate(-25deg) scaleY(0.7);
    box-shadow: 0 8px 24px #ffd70088;
}
.gift-ribbon {
    width: 22px;
    height: 81px;
    background: linear-gradient(180deg, #ffd700 60%, #ff5252 100%);
    border-radius: 12px;
    position: absolute;
    left: 50%; top: 0;
    transform: translateX(-50%);
    z-index: 1;
    box-shadow: 0 0 8px #ffd70044;
}
.gift-box .prize {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%,-50%);
    font-size: 1.1rem;
    color: #d84315;
    font-weight: bold;
    text-align: center;
    z-index: 3;
    opacity: 0;
    transition: opacity 0.3s 0.2s;
    pointer-events: none;
}
.gift-box.opened .prize {
    opacity: 1;
}
.gift-box.opened {
    background: #fffbe7;
    border-color: #ffd700;
    box-shadow: 0 0 32px #ffd70088;
    cursor: default;
}

.voucher-float {
    position: fixed;
    left: 0; top: 0;
    width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    animation: fadeInBg 0.3s;
}
@@keyframes fadeInBg {
    from { background: rgba(0,0,0,0);}
    to   { background: rgba(0,0,0,0.25);}
}
.voucher-content {
    min-width: 340px;
    max-width: 90vw;
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 8px 48px #0003, 0 0 0 8px #5af2b244;
    padding: 2.5rem 2.5rem 2rem 2.5rem;
    font-size: 2.2rem;
    color: #009688;
    font-weight: bold;
    text-align: center;
    animation: voucherUp 0.7s cubic-bezier(.7,-0.2,.5,1.5);
    position: relative;
}
@@keyframes voucherUp {
    0% { transform: translateY(120px) scale(0.7); opacity: 0;}
    60% { transform: translateY(-16px) scale(1.05); opacity: 1;}
    100% { transform: translateY(0) scale(1);}
}
.voucher-content .close-voucher {
    position: absolute;
    top: 12px; right: 22px;
    font-size: 1.5rem;
    color: #aaa;
    cursor: pointer;
    transition: color 0.2s;
}
.voucher-content .close-voucher:hover {
    color: #ff5252;
}

.voucher-area {
    position: absolute;
    top: 125px;
    right: 32px;
    width: 420px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
}

.voucher-board {
    width: 100%;
    min-height: 310px;
    background: #fff;
    border-radius: 22px;
    box-shadow: 0 12px 48px #0003;
    padding: 2rem 1.5rem 2rem 1.5rem;
    font-size: 1.15rem;
    color: #009688;
    transition: box-shadow 0.2s;
    max-height: 40vh;
    overflow-y: auto;
}
.voucher-board h3 {
    font-size: 2.35rem;
    margin-bottom: 1.3rem;
    color: #ff5252;
    font-weight: bold;
    letter-spacing: 1px;
}
.voucher-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}
.voucher-item {
    background: linear-gradient(90deg,#e0f7fa 60%,#fffbe7 100%);
    border-radius: 12px;
    box-shadow: 0 2px 8px #5af2b244;
    padding: 0.7rem 1rem;
    display: flex;
    flex-direction: column;
    font-size: 1.08rem;
    color: #333;
    border-left: 5px solid #5af2b2;
    position: relative;
}
.voucher-item .voucher-time {
    font-size: 0.95rem;
    color: #888;
    margin-top: 0.2rem;
}

.gacha-desc {
    background: linear-gradient(90deg,#e0f7fa 60%,#fffbe7 100%);
    border-radius: 14px;
    box-shadow: 0 2px 8px #5af2b244;
    padding: 1.1em 1.2em;
    font-size: 1.13rem;
    color: #009688;
    margin-bottom: 1.2rem;
    text-align: left;
}

.gacha-point {
    color: #ff5252;
    font-weight: bold;
}

.spin-info {
    width: 100%;
    max-width: 420px;
    padding: 0.7em 0;
    font-size: 2rem;
    color: #009688;
    text-align: center;
    font-weight: bold;
    letter-spacing: 1px;
}

#spin-btn {
    display: block;
    width: 100%;
    max-width: 420px; /* bằng với voucher-board */
    padding: 0.5em 0;
    font-size: 1.7rem;
    background: #ff5252;
    color: #fff;
    border: none;
    border-radius: 18px;
    box-shadow: 0 2px 8px #ff525288;
    cursor: pointer;
    transition: background 0.2s;
}

#spin-btn:disabled {
    background: #ccc;
    color: #888;
    box-shadow: none;
    opacity: 0.7;
}

.gift-box .voucher-slip {
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    min-width: 90px;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 4px 24px #0002;
    padding: 0.7em 1em;
    font-size: 1.1rem;
    color: #ff5252;
    font-weight: bold;
    text-align: center;
    opacity: 0;
    z-index: 10;
    animation: slipDown 1s forwards;
}

@@keyframes slipDown {
    0% { opacity: 0; top: -60px; }
    40% { opacity: 1; top: 10px; }
    80% { opacity: 1; top: 40px; }
    100% { opacity: 0; top: 70px; }
}
</style>

<script>
const prizes = [
    "10% OFF", "20% OFF", "Free Shipping", "No Luck", "5% OFF", "50K Voucher", "Try Again", "15% OFF", "100K Voucher"
];

let opened = false;
let canPick = false;
let spinCount = 3;

let boxOrder = [...Array(prizes.length).keys()];
// Mảng lưu voucher của từng hộp theo vị trí ban đầu
let currentVouchers = [];

const spinBtn = document.getElementById('spin-btn');
document.getElementById('spin-count').textContent = `Lượt quay: ${spinCount}`;

function renderBoxes() {
    const containers = Array.from(document.querySelectorAll('.gift-box-container'));
    containers.forEach((container, idx) => {
        container.innerHTML = '';
        const box = document.createElement('div');
        box.className = 'gift-box';
        box.innerHTML = '<div class="gift-lid"></div><div class="gift-ribbon"></div>';
        container.appendChild(box);
    });
}
renderBoxes();

spinBtn.onclick = function() {
    if (spinCount <= 0) {
        showToast("You don't have any points left!");
        return;
    }
    if (spinBtn.disabled) return;
    spinBtn.disabled = true;
    spinCount--;
    document.getElementById('spin-count').textContent = `Lượt quay: ${spinCount}`;
    opened = false;
    canPick = false;

    // 1. Mở tất cả hộp, hiện voucher và gán data-voucher
    const containers = Array.from(document.querySelectorAll('.gift-box-container'));
    const boxes = containers.map(c => c.querySelector('.gift-box'));
    boxes.forEach((box, idx) => {
        box.classList.add('opened');
        box.innerHTML = `<div class="gift-lid"></div><div class="gift-ribbon"></div>
            <div class="prize">${prizes[idx]}</div>`;
        box.dataset.voucher = prizes[idx];
    });

    // 2. Đóng tất cả hộp lại sau 1.2s
    setTimeout(() => {
        boxes.forEach((box) => {
            box.classList.remove('opened');
            box.innerHTML = `<div class="gift-lid"></div><div class="gift-ribbon"></div>`;
            // Không gán lại voucher!
        });

        // 3. Xáo trộn vị trí hộp quà với hoạt ảnh
        animateShuffleBoxes(() => {
            canPick = true;
            spinBtn.disabled = false;
        });
    }, 1200);
};

// Hàm animateShuffleBoxes: chỉ xáo trộn vị trí hộp, không đổi voucher
function animateShuffleBoxes(callback) {
    const shuffleTimes = 3;
    const duration = 700;

    function doShuffle(timesLeft) {
        const containers = Array.from(document.querySelectorAll('.gift-box-container'));
        const boxes = containers.map(c => c.querySelector('.gift-box'));
        const startPos = containers.map(c => {
            const rect = c.getBoundingClientRect();
            return {left: rect.left, top: rect.top};
        });

        shuffle(boxOrder);

        const endPos = boxOrder.map(i => startPos[i]);

        boxes.forEach((box, idx) => {
            const dx = endPos[idx].left - startPos[idx].left;
            const dy = endPos[idx].top - startPos[idx].top;
            box.style.transition = `transform ${duration}ms cubic-bezier(.7,-0.2,.5,1.5)`;
            box.style.transform = `translate(${dx}px, ${dy}px)`;
        });

        setTimeout(() => {
            containers.forEach((container, idx) => {
                container.innerHTML = '';
                container.appendChild(boxes[boxOrder[idx]]);
                boxes[boxOrder[idx]].style.transition = '';
                boxes[boxOrder[idx]].style.transform = '';
            });
            setBoxClickEvents();
            if (timesLeft > 1) {
                setTimeout(() => doShuffle(timesLeft - 1), duration);
            } else {
                if (callback) callback();
            }
        }, duration);
    }

    doShuffle(shuffleTimes);
}

// Gán lại sự kiện click cho từng hộp sau khi xáo trộn
function setBoxClickEvents() {
    const containers = Array.from(document.querySelectorAll('.gift-box-container'));
    containers.forEach((container) => {
        const box = container.querySelector('.gift-box');
        box.onclick = function() {
            if (!canPick) {
                showToast('You need to spin first!');
                return;
            }
            if (opened || !box) return;
            opened = true;
            canPick = false;
            spinBtn.disabled = false;

            box.classList.add('opened');
            box.innerHTML = `<div class="gift-lid"></div><div class="gift-ribbon"></div>
                <div class="prize">${box.dataset.voucher}</div>`;

            const prize = box.dataset.voucher;
            if (prize !== "No Luck" && prize !== "Try Again") {
                fetch('/Coupon/Claim', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ couponCode: prize })
                })
                .then(res => res.json())
                .then(data => {
                    showVoucher(prize);
                    addVoucherToBoard(prize);
                });
            } else {
                showVoucher(prize);
            }
        };
    });
}


// Shuffle function
function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
    }
}

function showVoucher(prize) {
    const voucher = document.getElementById('voucher-float');
    const content = voucher.querySelector('.voucher-content');
    content.innerHTML = `<span class="close-voucher" title="Đóng">&times;</span>
        <div style="margin-top:1.2rem;">🎁</div>
        <div style="margin:1.5rem 0 0.5rem 0;">Bạn nhận được</div>
        <div style="font-size:2.7rem;color:#ff5252;margin-bottom:1.2rem;">${prize}</div>
        <div style="font-size:1.1rem;color:#888;">Chúc mừng bạn!</div>`;
    voucher.style.display = 'flex';
    content.querySelector('.close-voucher').onclick = () => voucher.style.display = 'none';
    voucher.onclick = e => { if(e.target===voucher) voucher.style.display='none'; };
}

function addVoucherToBoard(prize) {
    if (prize === "No Luck" || prize === "Try Again") return;
    const list = document.getElementById('voucher-list');
    const now = new Date();
    const dateStr = now.toLocaleDateString('vi-VN');
    const timeStr = now.toLocaleTimeString('vi-VN');
    const item = document.createElement('div');
    item.className = 'voucher-item';
    item.innerHTML = `<div><b>${prize}</b></div>
        <div class="voucher-time">Nhận lúc: ${dateStr} ${timeStr}</div>`;
    if (list.children.length && list.children[0].textContent.includes('Chưa có voucher')) {
        list.innerHTML = '';
    }
    list.prepend(item);
}

function showToast(msg) {
    let toast = document.getElementById('gacha-toast');
    if (!toast) {
        toast = document.createElement('div');
        toast.id = 'gacha-toast';
        toast.style.position = 'fixed';
        toast.style.bottom = '40px';
        toast.style.left = '50%';
        toast.style.transform = 'translateX(-50%)';
        toast.style.background = '#ff5252';
        toast.style.color = '#fff';
        toast.style.padding = '1em 2em';
        toast.style.borderRadius = '16px';
        toast.style.fontSize = '1.15rem';
        toast.style.boxShadow = '0 2px 16px #0005';
        toast.style.zIndex = '99999';
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s';
        document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.style.opacity = '1';
    setTimeout(() => { toast.style.opacity = '0'; }, 1800);
}
</script>