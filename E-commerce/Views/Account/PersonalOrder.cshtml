@model IEnumerable<OrderModel>

@{
    ViewData["Title"] = "PersonalOrder";
    int i = 0;
}

<div>
    <label for="statusFilter">Filter by Status:</label>
    <select id="statusFilter" class="form-select" style="width: 200px;">
        <option value="">All</option>
        <option value="đơn hàng mới">Đơn hàng mới</option>
        <option value="đơn hàng đã xác nhận">Đơn hàng đã xác nhận</option>
        <option value="Đã giao cho đơn vị vận chuyển">Đã giao cho đơn vị vận chuyển</option>
        <option value="Hàng đã giao tới nơi">Hàng đã giao tới nơi</option>
        <option value="Đơn hàng đã hoàn thành">Đơn hàng đã hoàn thành</option>
        <option value="Đơn hàng đã bị huỷ">Đơn hàng đã bị hủy</option>
    </select>
</div>
<div class="row mb-3">
    <div class="col-md-3">
        <label for="startDate">Start Date:</label>
        <input type="date" id="startDate" class="form-control">
    </div>
    <div class="col-md-3">
        <label for="endDate">End Date:</label>
        <input type="date" id="endDate" class="form-control">
    </div>
</div>
<table class="table" id="OrderTable">
    <thead>
        <tr>
            <th>#</th>
            <th>Order Code</th>
            <th>Day Order</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            i = i + 1;
            <tr>
                <td>
                    @i
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
            <td>
                    @if (@item.Status == 1)
                    {
                        <span class="text text-primary">đơn hàng mới</span>
                    }
                    else if (@item.Status == 2)
                    {
                        <span class="text text-danger">đơn hàng đã xác nhận</span>
                    }
                    else if (@item.Status == 3)
                    {
                        <span class="text text-warning">Đã giao cho đơn vị vận chuyển</span>
                    }
                    else if (@item.Status == 4)
                    {
                        <span class="text text-dark">Hàng đã giao tới nơi</span>
                    }
                    else if (@item.Status == 5)
                    {
                        <span class="text text-success">Đơn hàng đã hoàn thành</span>
                    }
                    else if (@item.Status == 6)
                    {
                        <span class="text text-danger">Đơn hàng đã bị huỷ</span>
                    }
            </td>
            <td>
                <a asp-action="ViewOrder" class="btn btn-warning btn-sm" asp-controller="Account" asp-route-OrderCode="@item.OrderCode">View Order</a>
                    @if (@item.Status == 1)
                    {
                        <a asp-action="CancelOrder" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Account" asp-route-OrderCode="@item.OrderCode">Cancel Order</a>
                    }
                    else if (@item.Status == 2)
                    {
                        <a asp-action="CancelOrder" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Account" asp-route-OrderCode="@item.OrderCode">Cancel Order</a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#OrderTable').DataTable();

            // Add event listener to the dropdown
            $('#statusFilter').on('change', function () {
                var selectedStatus = $(this).val();
                table.column(3).search(selectedStatus, true, false).draw(); // Column 4 is the "Order Status"
            });

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var startDate = $('#startDate').val();
                var endDate = $('#endDate').val();
                var createdDate = data[2]; // Column index of CreatedDate

                var tableDate = new Date(createdDate);


                if (startDate) {
                    startDate = new Date(startDate);
                }
                if (endDate) {
                    endDate = new Date(endDate);
                }

                // Apply the filter
                if ((!startDate || tableDate >= startDate) &&
                    (!endDate || tableDate <= endDate)) {
                    return true;
                }
                return false;
            });

            // Add event listeners to the date inputs
            $('#startDate, #endDate').on('change', function () {
                table.draw(); // Trigger a redraw with the date filter
            });
        });
    </script>
}
