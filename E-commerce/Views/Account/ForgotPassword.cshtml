@model AppUserModel
@{
    ViewData["Title"] = "Forgot Password";
}
<section style="background-color:white" id="login-section" class="d-flex justify-content-center align-items-center min-vh-100">
    <!--form-->
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-4">

                <div class="forgotPassword-form">
                    <!--login form-->
                    <h2 class="text-center mb-4">Forget Password</h2>
                    <h2 style="font-size:1.5rem; margin-bottom:0rem; font-weight:500">Enter your email address below to reset your password.</h2>
                <div class="login-form-signin">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-action="SendEmailForgotPassword" asp-controller="Account">
                        <div class="form-group mb-3">
                            <label style="padding-left:1rem; font-size:1.3rem">Email</label>
                            <input asp-for="Email" class="input-field" placeholder="Enter your email" />
                            <span asp-validation-for="Email" style="padding-left:1rem; font-size:1.1rem" class="text-danger" />
                        </div>
                        <div class="d-grid mb-3">
                            <button class="login-btn">Send</button>
                        </div>
                    </form>
                    </div>
                </div>
                <!--/login form-->

            </div>
        </div>
    </div>
</section><!--/form-->

<style>
    .forgotPassword-form h2 {
        color: #000000;
        font-size: 4.8rem;
        line-height: 4.8rem;
        font-weight: 400;
        margin-bottom: 4.5rem;
        text-align: center;
        font-family: system-ui;
    }

    .login-form-signin {
        max-width: 35rem;
        margin: 0 auto;
        padding: 15px;
        border-radius: 2px;
        font-family: Arial, sans-serif;
    }

    .form-group {
        display: flex;
        flex-direction: column; /* Đảm bảo label nằm trên input */
        align-items: flex-start; /* Căn label sang trái */
        margin-bottom: 10px;
    }

    .form-label {
        font-size: 1rem; /* Kích thước font của label */
        color: #000000; /* Màu chữ của label */
    }

    .input-field {
        width: 100%;
        height: 5rem;
        max-width: 300px;
        margin: 10px auto;
        padding: 10px;
        border: 2px solid #000000;
        border-radius: 2px;
        font-size: 1.3rem;
        background-color: #ffffff; /* Màu nền */
        color: #000000; /* Màu chữ */
        outline: none; /* Loại bỏ viền màu xanh */
    }

        .input-field:focus {
            background-color: #f9f9f9; /* Màu nền khi nhấp vào */
            border-color: #000000; /* Màu viền khi nhấp vào */
            outline: none; /* Loại bỏ viền mặc định */
            box-shadow: none; /* Loại bỏ bóng */
        }

    .login-btn {
        display: block;
        width: 100%;
        margin: 15px 0;
        padding: 10px;
        border: 2px solid #000000;
        border-radius: 2px;
        background-color: #000000;
        color: white;
        font-size: 1.5rem;
        font-weight: bold;
        cursor: pointer;
        text-align: center;
        transition: transform 0.3s ease-in-out;
    }

        .login-btn:hover {
            transform: scale(0.95);
        }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.min.js" integrity="sha384-QY6sqtrORtkgnbUMYpSvpo4YdjtU06LjxCsqEpsoP5Ea1lv4EcHA2VF5p8BEsI1u" crossorigin="anonymous"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
