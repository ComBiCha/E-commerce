@model E_commerce.Models.AppUserModel

@{
    ViewData["Title"] = "Portal";

    // Xác định hạng hiện tại và điểm cần thiết để lên hạng tiếp theo
    int points = Model.Points;
    string rank = "Bronze";
    int nextRankPoints = 10000;

    if (points >= 50000)
    {
        rank = "Diamond";
        nextRankPoints = 50000;
    }
    else if (points >= 40000)
    {
        rank = "Platinum";
        nextRankPoints = 50000;
    }
    else if (points >= 20000)
    {
        rank = "Gold";
        nextRankPoints = 40000;
    }
    else if (points >= 10000)
    {
        rank = "Silver";
        nextRankPoints = 20000;
    }

    int progressToNextRank = (int)(((double)points / nextRankPoints) * 100);
    if (progressToNextRank > 100) progressToNextRank = 100;
}

<style>
    .button-group {
        display: flex;
        gap: 10px; /* khoảng cách giữa các nút */
    }

    .action-link-button {
        display: inline-block;
        padding: 10px 20px;
        font-size: 18px;
        color: white;
        border-radius: 5px;
        text-align: center;
        text-decoration: none;
        transition: background-color 0.3s;
        cursor: pointer;
        border: none;
    }


</style>
<div class="container" style=" margin-top: 5.5rem">
    <h1>Quản lý tài khoản</h1>

    <div class="tabs">
        <button class="tab-button" onclick="openTab(event, 'PersonalInfo')">Thông tin cá nhân</button>
        <button class="tab-button" onclick="openTab(event, 'Orders')"><a asp-action="PersonalOrder" asp-controller="Account">Lịch sử đơn hàng</a></button>
        <button class="tab-button" onclick="openTab(event, 'Orders')"><a asp-action="MyWarranties" asp-controller="Account">Lịch sử bảo hành</a></button>
    </div>

    <div id="PersonalInfo" class="tab-content">
        <h2>Thông tin cá nhân</h2>
        <p>Tên: @Model.UserName</p>
        <p>Email: @Model.Email</p>
        <div class="user-points">
            <h3>Points: @Model.Points</h3>
            <p>Current Rank: <strong>@rank</strong></p>
            @if (rank != "Diamond")
            {
                <p>Need <strong>@(nextRankPoints - points) Points</strong> To rank-up <strong>@(rank == "Platinum" ? "Diamond" : (rank == "Gold" ? "Platinum" : (rank == "Silver" ? "Gold" : "Silver")))</strong></p>
                <div class="progress-bar-container">
                    <div class="progress-bar" style="width: @progressToNextRank%;"></div>
                </div>
            }
        </div>
        <div class="button-group">
            @Html.ActionLink("Chỉnh sửa thông tin", "EditPersonal", new { id = Model.Id }, new { @class = "btn btn-primary action-link-button" })
            @*@Html.ActionLink("Đăng xuất", "SignOut", "Login", new { @class = "btn btn-danger action-link-button" })*@
        </div>
    </div>
</div>

<script>
    function openTab(evt, tabName) {
            var i, tabcontent, tabbuttons;
            tabcontent = document.getElementsByClassName("tab-content");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }
            tabbuttons = document.getElementsByClassName("tab-button");
            for (i = 0; i < tabbuttons.length; i++) {
                tabbuttons[i].className = tabbuttons[i].className.replace(" active", "");
            }
            document.getElementById(tabName).style.display = "block";
            evt.currentTarget.className += " active";
        }

        document.getElementsByClassName("tab-button")[0].click();</script>

<style>
    .user-points {
        margin-top: 20px;
        padding: 15px;
        background-color: #f9f9f9;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .progress-bar-container {
        width: 100%;
        height: 20px;
        background-color: #ddd;
        border-radius: 10px;
        overflow: hidden;
        margin-top: 10px;
    }

    .progress-bar {
        height: 100%;
        background-color: #28a745;
        text-align: center;
        color: white;
        line-height: 20px;
        font-size: 14px;
        border-radius: 10px;
    }
</style>
