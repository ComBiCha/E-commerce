@model IEnumerable<OrderDetails>
@{
    ViewData["title"] = "Order Details";
    decimal total = 0;
    decimal subtotal = 0;


}
 @* For user *@
<h3>Order Details</h3>

<table class="table" id="orderdetailsTable">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Order Code</th>
            <th scope="col">UserName</th>
            <th scope="col">Product Name</th>
            <th scope="col">Product Price</th>
            <th scope="col">Product Image</th>
            <th scope="col">Quantity</th>
            <th scope="col">Subtotal</th>
            <th scope="col">Warranty Code</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var warrantyCode = @item.Product.Warranty?.FirstOrDefault()?.WarrantyCode ?? "No Warranty";
            var warrantyDate = @item.Product.Warranty?.FirstOrDefault()?.ExpirationDate;
            subtotal = item.Quantity * item.Price;
            total += subtotal;
            <tr>
                <input type="hidden" asp-for="@item.OrderCode" class="getId" />
                <th>@item.Id</th>
                <td>@item.OrderCode</td>
                <td>@item.UserName</td>
                <td>@item.Product.Name - [@item.Variation.Material.Name|@item.Variation.Color.Name]</td>
                <td>@item.Price</td>
                <td><img src="~/media/variations/@item.Variation.ImageUrl" width="120" /></td>
                <td>@item.Quantity</td>
                <td>@subtotal.ToString("C")</td>
                <td>
                    @if (@ViewBag.Order.Status == 5) // Hiển thị khi trạng thái đơn hàng là "Đơn hàng đã hoàn thành"
                    {
                        <span class="text-success">
                            @warrantyCode <br> Expiration Date: @warrantyDate
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">Not Completed</span>
                    }
                </td>
            </tr>
        }
        <!-- The total row is now outside the loop -->
        <tr>
            <td style="text-align:center;font-size: 20px;">ProductTotal: </td>
            <td colspan="1" style="color:#FE980F;font-size: 20px;">@total.ToString("C")</td>
            <td style="text-align:center;font-size: 20px;">ShippingCost: </td>
            <td colspan="1" style="color:#FE980F;font-size: 20px;">@ViewBag.Order.ShippingCost.ToString("C")</td>

            <td>
                @if (@ViewBag.Order.Status == 1)
                {
                    <span class="text text-primary">đơn hàng mới</span>
                }
                else if (@ViewBag.Order.Status == 2)
                {
                    <span class="text text-danger">đơn hàng đã xác nhận</span>
                }
                else if (@ViewBag.Order.Status == 3)
                {
                    <span class="text text-warning">Đã giao cho đơn vị vận chuyển</span>
                }
                else if (@ViewBag.Order.Status == 4)
                {
                    <form action="@Url.Action("ConfirmDelivery", "Account")" method="post">
                        <input type="hidden" name="orderCode" value="@ViewBag.Order.OrderCode" />
                        <button type="submit" class="btn btn-success">Xác nhận đã nhận hàng</button>
                    </form>
                }
                else if (@ViewBag.Order.Status == 5)
                {
                    <span class="text text-success">Đơn hàng đã hoàn thành</span>
                }
                else if (@ViewBag.Order.Status == 6)
                {
                    <span class="text text-danger">Đơn hàng đã bị huỷ</span>
                }
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select-update-order').change(function () {
                var status = $(this).val();
                var ordercode = $(this).closest('tbody').find('.getId').val(); // Lấy giá trị từ input ẩn trong cùng hàng

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UpdateOrder")",
                    data: { status: status, ordercode: ordercode },

                    success: function (result) {
                        if (result.success) {
                            Swal.fire({
                                icon: "success",
                                title: "Yayyy",
                                text: "Update successfully",
                            });
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Oops...",
                                text: "Update failed: " + result.message,
                            });
                        }
                    },
                });
            });
        });
    </script>
    <script>
        let table = new DataTable('#orderdetailsTable', {
        layout: {
                topStart: {
                    buttons: ['pdf', 'print']
                }
            }
        });
    </script>
}