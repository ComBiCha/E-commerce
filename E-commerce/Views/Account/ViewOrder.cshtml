@model IEnumerable<OrderDetails>
@{
    ViewData["title"] = "Order Details";
    decimal total = 0;
    decimal subtotal = 0;
    // 🔹 LẤY WARRANTIES TỪ VIEWBAG
    var warranties = ViewBag.Warranties as List<WarrantyModel> ?? new List<WarrantyModel>();
}

@* For user *@
<div class="view-order-container">
    <h3 style="font-size: 2rem; border-bottom: 1px solid black; margin-bottom: 3rem; display: inline-block;">
        Order Details
    </h3>
    <table class="table" id="orderdetailsTable">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Order Code</th>
                <th scope="col">UserName</th>
                <th scope="col">Product Name</th>
                <th scope="col">Product Price</th>
                <th scope="col">Product Image</th>
                <th scope="col">Quantity</th>
                <th scope="col">Subtotal</th>
                <th scope="col">Warranty Code</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                // 🔹 TÌM WARRANTY CHO VARIATION NÀY
                var warranty = warranties.FirstOrDefault(w => w.VariationId == item.VariationId);
                var warrantyCode = warranty?.WarrantyCode ?? "No Warranty";
                var warrantyDate = warranty?.ExpirationDate;

                decimal itemSubtotal = item.Quantity * (item.Price - (item.DiscountAmount / item.Quantity));
                subtotal += itemSubtotal;
                total += itemSubtotal;
                <tr>
                    <input type="hidden" asp-for="@item.OrderCode" class="getId" />
                    <th>@item.Id</th>
                    <td>@item.OrderCode</td>
                    <td>@item.UserName</td>
                    <td>@item.Product.Name - [@item.Variation.Material.Name|@item.Variation.Color.Name|Size:@item.Variation.Size]</td>
                    <td>
                        @if (item.DiscountAmount > 0)
                        {
                            <p style="text-decoration: line-through; color: gray;">$@item.Price.ToString("N0")</p>
                            <p style="color: green; font-weight: bold;">$@((item.Price - (item.DiscountAmount / item.Quantity)).ToString("N0"))</p>
                        }
                        else
                        {
                            <p style="color: orange; font-weight: bold;">$@item.Price.ToString("N0")</p>
                        }
                    </td>

                    <td><img src="~/media/variations/@item.Variation.ImageUrl" width="120" /></td>
                    <td>@item.Quantity</td>
                    <td>$@subtotal.ToString("N0")</td>
                    <td>
                        @if (@ViewBag.Order.Status == 5) // Hiển thị khi trạng thái đơn hàng là "Đơn hàng đã hoàn thành"
                        {
                            @if (warranty != null)
                            {
                                <div style="background: #e8f5e8; padding: 10px; border-radius: 8px; border: 1px solid #4caf50;">
                                    <strong style="color: #2e7d32;">@warrantyCode</strong><br>
                                    <small style="color: #666;">Expires: @warrantyDate?.ToString("MMM dd, yyyy")</small>
                                    <br>
                                    <button onclick="copyToClipboard('@warrantyCode')"
                                            style="background: #4caf50; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 12px; margin-top: 5px;">
                                        📋 Copy Code
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span style="color: #999; font-style: italic;">No warranty available</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Available after completion</span>
                        }
                    </td>
                </tr>
            }
            <!-- The total row is now outside the loop -->
            <tr>
                <td style="text-align:center;font-size: 20px;">Product Total: </td>
                <td colspan="1" style="color:#FE980F;font-size: 20px;">$@total.ToString("N0")</td>

                <td style="text-align:center;font-size: 20px;">Shipping Cost: </td>
                <td colspan="1" style="color:#FE980F;font-size: 20px;">$@ViewBag.Order.ShippingCost.ToString("N0")</td>

                <td style="text-align:center;font-size: 22px; font-weight: bold;">Grand Total:</td>
                <td colspan="1" style="color:#FE980F;font-size: 22px; font-weight: bold;">
                    $@((total + ViewBag.Order.ShippingCost).ToString("N0"))
                </td>

                <td>
                    @if (@ViewBag.Order.Status == 1)
                    {
                        <span class="text text-primary">đơn hàng mới</span>
                    }
                    else if (@ViewBag.Order.Status == 2)
                    {
                        <span class="text text-danger">đơn hàng đã xác nhận</span>
                    }
                    else if (@ViewBag.Order.Status == 3)
                    {
                        <span class="text text-warning">Đã giao cho đơn vị vận chuyển</span>
                    }
                    else if (@ViewBag.Order.Status == 4)
                    {
                        <form action="@Url.Action("ConfirmDelivery", "Account")" method="post">
                            <input type="hidden" name="orderCode" value="@ViewBag.Order.OrderCode" />
                            <button type="submit" class="btn btn-success">Xác nhận đã nhận hàng</button>
                        </form>
                    }
                    else if (@ViewBag.Order.Status == 5)
                    {
                        <span class="text text-success">Đơn hàng đã hoàn thành</span>
                    }
                    else if (@ViewBag.Order.Status == 6)
                    {
                        <span class="text text-danger">Đơn hàng đã bị huỷ</span>
                    }
                </td>
                <td>
                    @if (@ViewBag.Order.Status == 1)
                    {
                        <a asp-action="CancelOrder" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Account" asp-route-OrderCode="@ViewBag.Order.OrderCode">Cancel Order</a>
                    }
                    else if (@ViewBag.Order.Status == 2)
                    {
                        <a asp-action="CancelOrder" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Account" asp-route-OrderCode="@ViewBag.Order.OrderCode">Cancel Order</a>
                    }
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        </tbody>
    </table>
</div>

<style>
    .view-order-container {
        position: relative;
        clear: both;
        background: white;
        padding: 8rem 2rem 15rem 2rem;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select-update-order').change(function () {
                var status = $(this).val();
                var ordercode = $(this).closest('tbody').find('.getId').val();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UpdateOrder")",
                    data: { status: status, ordercode: ordercode },

                    success: function (result) {
                        if (result.success) {
                            Swal.fire({
                                icon: "success",
                                title: "Yayyy",
                                text: "Update successfully",
                            });
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Oops...",
                                text: "Update failed: " + result.message,
                            });
                        }
                    },
                });
            });
        });

        // 🔹 FUNCTION COPY WARRANTY CODE
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function () {
                Swal.fire({
                    icon: 'success',
                    title: 'Copied!',
                    text: 'Warranty code copied to clipboard',
                    timer: 2000,
                    showConfirmButton: false
                });
            }, function (err) {
                console.error('Could not copy text: ', err);
                var textArea = document.createElement("textarea");
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                try {
                    document.execCommand('copy');
                    Swal.fire({
                        icon: 'success',
                        title: 'Copied!',
                        text: 'Warranty code copied to clipboard',
                        timer: 2000,
                        showConfirmButton: false
                    });
                } catch (err) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to copy warranty code',
                    });
                }
                document.body.removeChild(textArea);
            });
        }
    </script>
    <script>
        let table = new DataTable('#orderdetailsTable', {
            layout: {
                topStart: {
                    buttons: ['pdf', 'print']
                }
            }
        });
    </script>
}