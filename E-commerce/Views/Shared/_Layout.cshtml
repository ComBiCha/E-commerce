<body>
	<header id="header">
		<div class="header-middle">
			<!--header-middle-->
			<div class="container-fluid">
				<div class="row align-items-center">
					<!-- Phần bên trái -->
					<div class="contactUs col-sm-4 d-flex align-items-center justify-content-center">
						<a asp-action="Contact" asp-controller="Home" class="contact-info d-flex align-items-center justify-content-center">
							<p>
								<i class="fa fa-plus" aria-hidden="true"></i>
								Contact Us
							</p>
						</a>
					</div>



					<!-- Phần ở giữa -->
					<div class="col-sm-4 d-flex align-items-center justify-content-center">
						<div id="layout-merdi" class="logo @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "logo-home" : "logo-static")">
							<a href="index.html">
								<h2>MERDI</h2>
							</a>
						</div>

					</div>


					<!-- Phần bên phải -->
					<div class="col-sm-4 d-flex align-items-center justify-content-center">
						<div class="shop-menu pull-right">
							<ul class="nav">
								<li>
									<a asp-action="Spin" asp-controller="Coupon" title="Spin & Win">
										<i class="fa fa-gift custom-icon"></i>
									</a>
								</li>
								<li><a asp-action="Index" asp-controller="Cart"><i class="fa fa-shopping-bag custom-icon" aria-hidden="true"></i></a></li>
								<li class="nav-item" id="searchContainer">
									<a class="nav-link" href="#" id="searchIcon" role="button">
										<i class="fa fa-search custom-icon" aria-hidden="true"></i>
									</a>
									<form asp-controller="Product" asp-action="Search" method="post" class="search-form d-none">
										<div class="input-group">
											<input type="text" class="form-control" placeholder="Search" name="searchTerm" />
											<button class="btn btnCancel" type="button" id="cancelSearch">Cancel</button>
										</div>
									</form>
								</li>
								@if (User.Identity?.IsAuthenticated ?? false)
								{
									<li class="nav-item dropdown">
										<a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
											<i class="fa fa-user custom-icon"></i>
										</a>
										<ul class="dropdown-menu" aria-labelledby="userDropdown">
											<li>
												<a class="dropdown-item" asp-controller="Account" asp-action="Portal">
													Portal
												</a>
											</li>
											<li>
												<a class="dropdown-item" asp-controller="Home" asp-action="Wishlist">
													Wishlist
												</a>
											</li>
											<li>
												<a class="dropdown-item" asp-controller="Warranty" asp-action="RequestWarranty">
													Request Warranty
												</a>
											</li>
										</ul>
									</li>
								

									@* <li><a href="checkout.html"><i class="fa fa-crosshairs"></i> Checkout</a></li> *@
									@if (User.IsInRole("Admin"))
									{
										<li><a asp-controller="Admin" asp-action="Index"><i class="fa fa-lock custom-icon"></i>Admin</a></li>
									}

									<li><a asp-controller="Account" asp-action="Logout"><i class="fa fa-sign-out custom-icon"></i>@User.Identity.Name, Logout</a></li>
								}
								
								else
								{
									<li><a asp-controller="Account" asp-action="Login"><i class="fa fa-sign-in"></i>Login</a></li>
								}

							</ul>
						</div>
					</div>
				</div>
			</div>
		</div><!--/header-middle-->


	</header><!--/header-->



	<section style="background-color:black">
		<div class="container-fluid p-0 m-0">
			<div class="row">
				@Html.Partial("_NotificationPartical")
				@RenderBody()
			</div>
		</div>
	</section>

