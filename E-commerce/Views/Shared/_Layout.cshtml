	<script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v21.0"></script>
	@await RenderSectionAsync("Scripts", required: false)
	@await RenderSectionAsync("Styles", required: false)

	<script>
		document.getElementById('searchIcon').addEventListener('click', function (event) {
			event.preventDefault(); // Ngăn chặn hành động mặc định
			const form = document.querySelector('.search-form');
			form.classList.toggle('d-none'); // Hiện/ẩn form
		});

		document.getElementById('cancelSearch').addEventListener('click', function () {
			const form = document.querySelector('.search-form');
			form.classList.add('d-none'); // Ẩn form
		});

		// -------------- Script của 2 logo MERDI ----------

					document.addEventListener("DOMContentLoaded", () => {
			const layoutText = document.querySelector(".logo h2");
			const sliderText = document.querySelector(".slider-text-top h2");
			const logoContainer = document.querySelector(".logo");

			if (!layoutText || !logoContainer) return;

			const isHome = logoContainer.classList.contains("logo-home");

			if (isHome && sliderText) {
				window.addEventListener("scroll", () => {
					const scrollTop = window.scrollY;
					const viewportHeight = window.innerHeight;

					if (scrollTop < viewportHeight / 3) {
						sliderText.style.transform = "translateY(0)";
						sliderText.style.opacity = "1";

						layoutText.style.transform = "translateY(50%)";
						layoutText.style.opacity = "0";
					} else {
						sliderText.style.transform = "translateY(-50%)";
						sliderText.style.opacity = "0";

						layoutText.style.transform = "translateY(0)";
						layoutText.style.opacity = "1";
					}
				});
			}
			// Nếu không phải trang chủ, KHÔNG cần làm gì thêm, vì CSS đã lo rồi
		});





	</script>
