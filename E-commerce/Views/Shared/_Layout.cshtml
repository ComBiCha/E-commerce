	<style>
		.custom-icon {
			color: black; /* Màu đen cho icon */
			text-shadow: 1px 1px 0 white, /* Trắng phía dưới bên phải */
			-1px 1px 0 white, /* Trắng phía dưới bên trái */
			1px -1px 0 white, /* Trắng phía trên bên phải */
			-1px -1px 0 white; /* Trắng phía trên bên trái */
		}

		
		.btnCancel{
			background-color: black !important;
			color: white !important;
		}

		.logo-static h2 {
			transform: none !important;
			opacity: 1 !important;
			transition: none !important;
		}

	</style>
