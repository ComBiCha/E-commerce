@{
	int index = 0;
}
<style>
	#slider-carousel {
		width: 100vw !important; /* Chiều rộng bằng toàn màn hình */
		margin: 0;
		padding: 0;
		position: relative;
		overflow: hidden;
	}

	.slider-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.3); /* Nền mờ tối */
		z-index: 2; /* Z-index thấp hơn nội dung */
	}

	.carousel-inner .item img {
		position: relative;
		z-index: 1; /* Nằm dưới overlay */
	}

	.slider-text-top,
	.slider-text-bottom,
	.slider-buttons {
		position: relative;
		z-index: 3; /* Các phần text và nút nằm trên hình ảnh */
	}

	.carousel-inner {
		width: 100%; /* Chiều rộng toàn màn hình */
	}

		.carousel-inner img {
			width: 100vw; /* Chiều ngang 100% của viewport */
			height: 120vh !important; /* Tự động điều chỉnh chiều cao theo tỷ lệ */
			object-fit: cover; /* Cắt ảnh nếu cần để phù hợp */
		}

	#slider .item {
		position: relative;
	}

	.slider-text-top {
		position: absolute;
		top: 7%; /* Đặt vị trí cách mép trên 10% */
		left: 50%;
		transform: translateX(-50%);
		color: white;
		font-weight: bold;
		text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7);
	}

	.slider-text-bottom {
		text-align: center; /* Căn giữa nội dung */
		bottom: 25%; /* Điều chỉnh khoảng cách từ dưới */
		left: 50%;
		transform: translateX(-50%);
		position: absolute;
		color: black;
		transition: bottom 0.3s ease; /* Hiệu ứng mượt */
	}

	.slider-buttons {
		margin-top: 10px; /* Khoảng cách giữa text và nút */
	}

	.btn-slider {
		display: inline-block;
		margin: 0 10px; /* Khoảng cách giữa các nút */
		padding: 15px 25px;
		font-size: 14px;
		font-weight: 600;
		color: white;
		text-decoration: none;
		background: transparent;
		border: 2px solid white;
		border-radius: 3px; /* Bo góc */
		background-color: rgba(255, 255, 255, 0.1);
		transition: all 0.3s ease; /* Hiệu ứng hover */
	}

		.btn-slider:hover {
			background-color: white; /* Màu nền khi hover */
			color: black; /* Màu chữ khi hover */
		}

	.slider-text-top a {
		text-decoration: none;
	}

	.slider-text-top h2 {
		font-family: "Times New Roman", serif;
		font-size: 25rem;
		font-weight: bold;
		color: white;
		text-transform: uppercase;
		letter-spacing: 3.5rem;
		margin: 0;
		text-decoration: none;
	}

	.slider-text-bottom h2 {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 3rem;
		color: white;
		margin: 0;
		text-decoration: none;
		margin-bottom: 25px;
		letter-spacing: 0.1rem;
		pointer-events: none;
	}

</style>
<section id="slider">
	<!--slider-->
	<div class="container-fluid p-0 m-0">
		<div class="row g-0">
			<div class="col-sm-12 p-0">
				<div id="slider-carousel" class="carousel slide" data-ride="carousel">
					<div class="carousel-inner position-relative">
						<div class="slider-overlay"></div>
						@foreach (var slider in ViewBag.Sliders)
						{
							<div class="item @(index == 0 ? "active" : "") position-relative">
								<!-- Text phía trên -->
								<div id="slider-merdi" class="slider-text-top position-absolute fade-in">
									<a href="index.html">
										<h2>MERDI</h2>
									</a>
								</div>

								<!-- Hình ảnh -->
								<img src="~/media/sliders/@slider.Image" class="img-responsive w-100" alt="Slider Image" />
								<!-- Text phía dưới -->
								<div class="slider-text-bottom position-absolute">
									<h2>Spring Summer 2025</h2>
									<div class="slider-buttons">
										<a href="/for-her" class="btn-slider">For Her</a>
										<a href="/for-him" class="btn-slider">For Him</a>
									</div>
								</div>
							</div>
							index++;
						}
					</div>
				</div>

			</div>
		</div>
	</div>
</section><!--/slider-->

<script>
	window.addEventListener("scroll", () => {
		const sliderText = document.querySelector(".slider-text-bottom");
		const slider = document.querySelector("#slider");

		// Lấy kích thước của slider
		const sliderTop = slider.offsetTop; // Vị trí trên của slider
		const sliderHeight = slider.offsetHeight; // Chiều cao của slider
		const sliderBottom = sliderTop + sliderHeight; // Vị trí dưới của slider

		// Vị trí hiện tại của scroll
		const scrollPosition = window.scrollY + window.innerHeight;

		if (scrollPosition < sliderBottom && scrollPosition > sliderTop) {
			// Tính tỷ lệ dựa trên khoảng cách cuộn trong slider
			const distance = (scrollPosition - sliderTop) / sliderHeight;
			const newBottom = 40 - (20 * distance); // Chuyển từ 25% -> 5%
			sliderText.style.bottom = `${newBottom}%`;
		} else if (scrollPosition >= sliderBottom) {
			// Khi cuộn vượt quá slider, giữ cố định tại bottom: 5%
			sliderText.style.bottom = "5%";
		} else if (scrollPosition <= sliderTop) {
			// Khi cuộn ngược lại về đầu slider, giữ cố định tại bottom: 25%
			sliderText.style.bottom = "25%";
		}
	});


</script>
