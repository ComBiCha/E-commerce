		<div class="filter-item">
			<span class="filter-title">Filter</span>
			<div class="dropdown-filter">
				<form id="filterForm" method="get" action="/Product/Search">
					<input type="hidden" name="searchTerm" value="@Context.Request.Query["searchTerm"]">
					<input type="hidden" name="category" value="@Context.Request.Query["category"]">
					<input type="hidden" name="brand" value="@Context.Request.Query["brand"]">
					<input type="hidden" name="sortOrder" value="@Context.Request.Query["sortOrder"]">

					<div class="filter-section">
						<h3 class="filter-heading">COLOR</h3>
						<ul class="filter-options color-options">
							<li><input type="checkbox" name="colors" value="Brown"><label>Brown</label></li>
							<li><input type="checkbox" name="colors" value="Black"><label>Black</label></li>
							<li><input type="checkbox" name="colors" value="Bright Green"><label>Bright Green</label></li>
							<li><input type="checkbox" name="colors" value="Red"><label>Red</label></li>
							<li><input type="checkbox" name="colors" value="White"><label>White</label></li>
							<li><input type="checkbox" name="colors" value="White&Black"><label>White&Black</label></li>
							<li><input type="checkbox" name="colors" value="Orange"><label>Orange</label></li>
						</ul>
					</div>

					<div class="filter-section">
						<h3 class="filter-heading">MATERIAL</h3>
						<ul class="filter-options material-options">
							<li><input type="checkbox" name="materials" value="Leather"><label>Leather</label></li>
							<li><input type="checkbox" name="materials" value="Canvas"><label>Canvas</label></li>
							<li><input type="checkbox" name="materials" value="GC selected"><label>GC selected</label></li>
						</ul>
					</div>

					<div class="dropdown-footer" id="sortby-column">
						<hr class="divider">
						<p class="footer-text">
							You can select several options at once
						</p>
						<div class="footer-buttons">
							<button type="submit" class="btn btn-apply">Apply</button>
							<button type="button" class="btn btn-reset" id="resetFilters" onclick="resetFilters()">Reset</button>
						</div>
					</div>
				</form>
			</div>
		</div>



		<div class="filter-item">
			<span class="filter-title">Sort By</span>
			<div class="dropdown-content">
				<ul>
					<a asp-action="Search"
					   asp-route-searchTerm="@Context.Request.Query["searchTerm"]"
					   asp-route-category="@Context.Request.Query["category"]"
					   asp-route-brand="@Context.Request.Query["brand"]"
					   asp-route-sortOrder="best_selling">
					<li>Best Selling</li>
					</a>
					<a asp-action="Search"
					   asp-route-searchTerm="@Context.Request.Query["searchTerm"]"
					   asp-route-category="@Context.Request.Query["category"]"
					   asp-route-brand="@Context.Request.Query["brand"]"
					   asp-route-sortOrder="price_desc">
					<li>Price: High to Low</li>
					</a>
					<a asp-action="Search"
					   asp-route-searchTerm="@Context.Request.Query["searchTerm"]"
					   asp-route-category="@Context.Request.Query["category"]"
					   asp-route-brand="@Context.Request.Query["brand"]"
					   asp-route-sortOrder="price_asc">
					<li>Price: Low to High</li>
					</a>
				</ul>
			</div>
		</div>
	</div>


</div>

<script>
			document.querySelectorAll('.filter-item').forEach(filterItem => {
	  const listItems = filterItem.querySelectorAll('.dropdown-content li'); // Chọn tất cả <li> trong filter-item hiện tại
	  listItems.forEach(item => {
		item.addEventListener('click', function () {
		  // Xóa lớp 'active' khỏi tất cả các mục <li> trong filter-item hiện tại
		  listItems.forEach(li => li.classList.remove('active'));
		  // Thêm lớp 'active' cho mục được click
		  this.classList.add('active');
		});
	  });
	});


</script>












