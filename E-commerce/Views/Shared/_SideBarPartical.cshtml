<div>
	<style>
		.filter-slider {
			display: flex;
			justify-content: flex-end;
			gap: 30px;
			padding: 15px 20px;
			background-color: black;
			border-top: 1px solid #ddd;
			border-bottom: 1px solid #ddd;
			position: relative;
		}

		.filter-item {
			position: relative;
			cursor: pointer;
		}

		.filter-title {
			font-size: 1.5rem;
			color: white;
			text-transform: uppercase;
			transition: color 0.3s ease;
		}

		#filterForm {
			display: flex;
			gap: 20rem;
			margin-top:3rem;
			flex-wrap: wrap;
			align-items: flex-start;
			position: absolute;
			top: 30%;
			left: 50%;
			transform: translate(-50%, -50%);
			padding: 0;
			box-sizing: border-box;
		}

		.dropdown-content {
			display: none;
			position: absolute;
			top: 165%;
			right: 0;
			background-color: white;
			border: 1px solid #ddd;
			box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
			z-index: 100;
			width: 200px;
			text-align: left;
		}

		.dropdown-filter {
			display: none;
			position: absolute;
			top: 165%;
			left: -90vw;
			padding: 40px 30px 40px 30px;
			background-color: white;
			border: 1px solid #ddd;
			box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
			z-index: 1000000000;
			height: 70vh;
			width: 100vw;
			box-sizing: border-box;
			overflow-y: auto;
			cursor: default;
		}

		a {
			color: black;
			 text-decoration: none;
		}

		a:hover{
			color:white;
		}

		.filter-item ul li a {
			display: block; /* Biến liên kết thành khối để bao phủ toàn bộ thẻ <li> */
			color: black;
			text-decoration: none;
		}

		.dropdown-content li:hover a,
		.dropdown-content li.active a {
			color: white; /* Đổi màu chữ khi active hoặc hover */
			text-decoration: none; /* Giữ liên kết không gạch chân */
		}

		.filter-item::after {
			content: '';
			position: absolute;
			top: 100%; /* Ngay dưới filter-item */
			left: 0;
			width: 100%;
			height: 65%; /* Tạo vùng hover ảo kết nối filter-item với dropdown */
			background: transparent;
			z-index: 99;
		}


			.dropdown-content ul {
				list-style: none; /* Loại bỏ bullet points */
				padding: 0; /* Xóa khoảng cách mặc định */
				margin: 0; /* Xóa khoảng cách mặc định */
			}

			.dropdown-content li {
				font-size: 1.4rem;
				font-weight: 600;
				padding: 10px 1rem; 
				border-bottom: 1px solid #ddd; /* Đường gạch dưới */
				transition: background-color 0.3s ease; /* Hiệu ứng mượt khi hover */
				cursor: pointer;
				position: relative;
			}

				.dropdown-content li:last-child {
					border-bottom: none; /* Ẩn đường gạch dưới ở mục cuối */
				}

				.dropdown-content li:hover,
				.dropdown-content li.active {
					background-color: black; /* Màu nền khi hover hoặc active */
					color: white; /* Màu chữ khi hover hoặc active */
				}

					.dropdown-content li.active::after {
						content: "\2713"; /* Biểu tượng checkmark */
						position: absolute;
						right: 1rem; /* Căn sang bên phải */
					top: 50%; /* Đưa đến giữa dòng */
					transform: translateY(-50%);
						color: white; /* Màu dấu checkmark */
						font-size: 1.5rem; /* Kích thước dấu checkmark */
					}

				.dropdown-content label{
					font-size: 1.4rem;
					color: black;
				}
		


		.filter-item:hover .dropdown-content {
			display: block;
		}

		.filter-item:hover .dropdown-filter{
			display: flex;
			flex-wrap: wrap; /* Cho phép các mục bên trong dropdown nằm ngang hoặc xuống dòng nếu cần */
			align-items: flex-start;
		}

		.filter-section {
			flex: 1; /* Các phần COLOR và MATERIAL sẽ có cùng chiều rộng */
			display: flex;
			flex-direction: column; /* Duy trì bố cục theo chiều dọc */
			gap: 20px; /* Khoảng cách giữa các phần */
		}

		.filter-heading {
			font-size: 3rem;
			font-weight: bold;
			color: black;
		}

		.color-options,
		.material-options {
			list-style: none;
			padding: 0;
			margin: 0; /* Căn giữa toàn bộ grid */
			display: grid;
			gap: 15px;
			overflow-y: auto;
		}

		.color-options {
			grid-template-columns: repeat(3, 1fr); /* COLOR: 3 cột */
		}

		.material-options {
			grid-template-columns: repeat(2, 1fr); /* MATERIAL: 2 cột */
			justify-content: start; /* Center toàn bộ grid trong container */
		}

			.color-options li,
			.material-options li {
				display: flex;
				align-items: center; /* Căn giữa checkbox và label theo chiều dọc */
				gap: 8px; /* Khoảng cách giữa checkbox và label */
				justify-content: start; /* Đảm bảo checkbox và label luôn căn trái trong mỗi cột */
			}

			.color-options input[type="checkbox"],
			.material-options input[type="checkbox"] {
				margin: 0; /* Loại bỏ margin mặc định của checkbox */
			}

			.color-options label,
			.material-options label {
				display: flex;
				align-items: start; /* Căn giữa checkbox và văn bản theo chiều dọc */
				gap: 5px; /* Khoảng cách giữa checkbox và văn bản */
				font-size: 1.5rem;
				color: black;
				opacity: 0.75;
			}

		input[type="checkbox"] {
			margin: 0;
			cursor: pointer;
		}

		/* Checkbox mặc định */
		.color-options input[type="checkbox"] {
			appearance: none; /* Loại bỏ kiểu mặc định của checkbox */
			width: 20px;
			height: 20px;
			border: 2px solid black; /* Viền mặc định */
			border-radius: 2px; /* Bo góc cho checkbox */
			background-color: white; /* Màu nền mặc định */
			cursor: pointer;
			transition: background-color 0.3s, border-color 0.3s; /* Hiệu ứng mượt mà */
		}

			/* Khi checkbox được chọn */
			.color-options input[type="checkbox"]:checked {
				background-color: #f8f8f8; /* Màu nền khi được chọn */
				border-color: black; /* Viền khi được chọn */
			}

				/* Tùy chọn: Thêm dấu check khi chọn */
				.color-options input[type="checkbox"]:checked::after {
					content: "\2713"; /* Dấu check */
					color: black;
					font-size: 14px;
					display: flex;
					align-items: center;
					justify-content: center;
				}

				.color-options input[type="checkbox"]:checked + label {
					color: black; /* Màu chữ khi được chọn */
				}


		.material-options input[type="checkbox"] {
			appearance: none; /* Loại bỏ kiểu mặc định của checkbox */
			width: 20px;
			height: 20px;
			border: 2px solid black; /* Viền mặc định */
			border-radius: 2px; /* Bo góc cho checkbox */
			background-color: white; /* Màu nền mặc định */
			cursor: pointer;
			transition: background-color 0.3s, border-color 0.3s; /* Hiệu ứng mượt mà */
		}

			/* Khi checkbox được chọn */
			.material-options input[type="checkbox"]:checked {
				background-color: #f8f8f8; /* Màu nền khi được chọn */
				border-color: black; /* Viền khi được chọn */
			}

				/* Tùy chọn: Thêm dấu check khi chọn */
				.material-options input[type="checkbox"]:checked::after {
					content: "\2713"; /* Dấu check */
					color: black;
					font-size: 14px;
					display: flex;
					align-items: center;
					justify-content: center;
				}

				.material-options input[type="checkbox"]:checked + label {
					color: black; /* Màu chữ khi được chọn */
				}


		
	

		.dropdown-footer {
			position: absolute; /* Định vị tuyệt đối */
			bottom: -18rem; /* Đưa footer xuống dưới cùng (nếu cần) */
			left: 50%; /* Đưa vào giữa theo trục ngang */
			transform: translateX(-50%); /* Căn chỉnh thực tế theo giữa trục ngang */
			width: 99vw; /* Đảm bảo không vượt chiều ngang nội dung */
			padding: 20px; /* Khoảng cách nội dung bên trong */
			text-align: center; /* Canh giữa nội dung */
			border-top: 1px solid rgb(0, 0, 0,0.5);
		}


			.dropdown-footer .footer-text {
				font-size: 1.5rem; /* Kích thước chữ */
				margin-bottom: 10px; /* Khoảng cách giữa text và các nút */
				color: black; /* Màu chữ */
			}

			.dropdown-footer .footer-buttons {
				display: flex;
				justify-content: center; /* Canh giữa các nút */
				gap: 10px; /* Khoảng cách giữa 2 nút */
			}

			.dropdown-footer .btn {
				padding: 10px 20px;
				font-size: 1.6rem;
				font-weight: 600;
				border: 1px solid black;
				cursor: pointer;
				border-radius: 3px;
				transition: all 0.3s ease;
			}

				.dropdown-footer .btn:hover {
					transform: scale(0.95); 
				}

			.dropdown-footer .btn-apply {
				background-color: black;
				color: white;
			}

			.dropdown-footer .btn-reset {
				background-color: white;
				color: black;
			}

	</style>

	@{
		// Lấy giá trị hiện tại của category và brand từ query string
		var currentCategory = ViewContext.HttpContext.Request.Query["category"].ToString();
		var currentBrand = ViewContext.HttpContext.Request.Query["brand"].ToString();

		// Thiết lập giá trị mặc định nếu không có category
		if (string.IsNullOrEmpty(currentCategory))
		{
			currentCategory = "All"; // Hoặc giá trị mặc định khác
		}
	}

	<div class="filter-slider">
		<div class="filter-item" id="gender-column">
			<span class="filter-title">Gender</span>
			<div class="dropdown-content">
				<ul>
					<li class="@(string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["category"]) ? "active" : "")">
						<a asp-action="Search" asp-controller="Product">All</a>
					</li>
					<li class="@(ViewContext.HttpContext.Request.Query["category"] == "Men's" ? "active" : "")">
						<a asp-action="Search" asp-controller="Product" asp-route-category="Men's">Men</a>
					</li>
					<li class="@(ViewContext.HttpContext.Request.Query["category"] == "Women's" ? "active" : "")">
						<a asp-action="Search" asp-controller="Product" asp-route-category="Women's">Women</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="filter-item" id="category-column">
			<span class="filter-title">Category</span>
			<div class="dropdown-content">
				<ul>
					<li class="@(string.IsNullOrEmpty(currentBrand) ? "active" : "")">
						<a asp-action="Search" asp-controller="Product" asp-route-category="@currentCategory">All</a>
					</li>
					@if (currentCategory == "Women's" || currentCategory == "All")
					{
						<li class="@(currentBrand == "Handbags" ? "active" : "")">
							<a asp-action="Search" asp-controller="Product" asp-route-category="Women's" asp-route-brand="Handbags">Handbags</a>
						</li>
					}

					<!-- Mục "Men's Bags" hiển thị nếu đang chọn Men's hoặc All -->
					@if (currentCategory == "Men's" || currentCategory == "All")
					{
						<li class="@(currentBrand == "Bags" ? "active" : "")">
							<a asp-action="Search" asp-controller="Product" asp-route-category="Men's" asp-route-brand="Bags">Men's Bags</a>
						</li>
					}
					<li class="@(currentBrand == "Shoes" ? "active" : "")">
						<a asp-action="Search"
						   asp-controller="Product"
						   asp-route-category="@(currentCategory == "All" ? null : currentCategory)"
						   asp-route-brand="Shoes">Shoes</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="filter-item">
			<span class="filter-title">Filter</span>
			<div class="dropdown-filter">
				<form id="filterForm" method="get" action="/Product/Search">
					<input type="hidden" name="searchTerm" value="@Context.Request.Query["searchTerm"]">
					<input type="hidden" name="category" value="@Context.Request.Query["category"]">
					<input type="hidden" name="brand" value="@Context.Request.Query["brand"]">
					<input type="hidden" name="sortOrder" value="@Context.Request.Query["sortOrder"]">

					<div class="filter-section">
						<h3 class="filter-heading">COLOR</h3>
						<ul class="filter-options color-options">
							<li><input type="checkbox" name="colors" value="Brown"><label>Brown</label></li>
							<li><input type="checkbox" name="colors" value="Black"><label>Black</label></li>
							<li><input type="checkbox" name="colors" value="Bright Green"><label>Bright Green</label></li>
							<li><input type="checkbox" name="colors" value="Red"><label>Red</label></li>
							<li><input type="checkbox" name="colors" value="White"><label>White</label></li>
							<li><input type="checkbox" name="colors" value="White&Black"><label>White&Black</label></li>
							<li><input type="checkbox" name="colors" value="Orange"><label>Orange</label></li>

						</ul>
					</div>
					
					<div class="filter-section">
						<h3 class="filter-heading">MATERIAL</h3>
						<ul class="filter-options material-options">
							<li><input type="checkbox" name="materials" value="Leather"><label>Leather</label></li>
							<li><input type="checkbox" name="materials" value="Canvas"><label>Canvas</label></li>
							<li><input type="checkbox" name="materials" value="GC selected"><label>GC selected</label></li>
						</ul>
					</div>

					<div class="dropdown-footer" id="sortby-column">
						<p class="footer-text">
							You can select several options at once
						</p>
						<div class="footer-buttons">
							<button type="submit" class="btn btn-apply">Apply</button>
							<button type="button" class="btn btn-reset" id="resetFilters" onclick="resetFilters()">Reset</button>
						</div>
					</div>
				</form>

			</div>
		</div>



		<div class="filter-item">
			<span class="filter-title">Sort By</span>
			<div class="dropdown-content">
				<ul>
					<li class="@(ViewContext.HttpContext.Request.Query["sortOrder"] == "best_selling" ? "active" : "")">
						<a asp-action="Search"
						   asp-route-searchTerm="@Context.Request.Query["searchTerm"]"
						   asp-route-category="@Context.Request.Query["category"]"
						   asp-route-brand="@Context.Request.Query["brand"]"
						   asp-route-sortOrder="best_selling">Best Selling</a>
					</li>
					<li class="@(ViewContext.HttpContext.Request.Query["sortOrder"] == "price_desc" ? "active" : "")">
						<a asp-action="Search"
						   asp-route-searchTerm="@Context.Request.Query["searchTerm"]"
						   asp-route-category="@Context.Request.Query["category"]"
						   asp-route-brand="@Context.Request.Query["brand"]"
						   asp-route-sortOrder="price_desc">Price: High to Low</a>
					</li>
					<li class="@(ViewContext.HttpContext.Request.Query["sortOrder"] == "price_asc" ? "active" : "")">
						<a asp-action="Search"
						   asp-route-searchTerm="@Context.Request.Query["searchTerm"]"
						   asp-route-category="@Context.Request.Query["category"]"
						   asp-route-brand="@Context.Request.Query["brand"]"
						   asp-route-sortOrder="price_asc">Price: Low to High</a>
					</li>
				</ul>
			</div>
		</div>

	</div>


</div>

<script>
			document.querySelectorAll('.filter-item').forEach(filterItem => {
	  const listItems = filterItem.querySelectorAll('.dropdown-content li'); // Chọn tất cả <li> trong filter-item hiện tại
	  listItems.forEach(item => {
		item.addEventListener('click', function () {
		  // Xóa lớp 'active' khỏi tất cả các mục <li> trong filter-item hiện tại
		  listItems.forEach(li => li.classList.remove('active'));
		  // Thêm lớp 'active' cho mục được click
		  this.classList.add('active');
		});
	  });
	});


</script>












