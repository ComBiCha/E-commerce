@section Scripts {
	<script>
							$(document).ready(function () {
			let selectedVariationId = null;

			// Mặc định chọn variant đầu tiên
			const setDefaultVariation = function () {
				const firstOption = $('.variation-option').first();
				if (firstOption.length > 0) {
					let material = firstOption.data("material");
					let color = firstOption.data("color");
					let stock = firstOption.data("stock");

					selectedVariationId = firstOption.data("variation_id");

					$('#current-variation').text(`${material} - ${color}`);
					$('#current-availability').text(stock > 0 ? "Available" : "Out of Order");

					// Cập nhật trạng thái nút Add to Cart
					let addToCartButton = $('#add-to-cart-button');
					if (stock > 0) {
						addToCartButton.prop('disabled', false).removeClass('out-of-order');
					} else {
						addToCartButton.prop('disabled', true).addClass('out-of-order');
					}

					addToCartButton.data('variation_id', selectedVariationId);
				}
			};

			// Gọi hàm setDefaultVariation để chọn mặc định variant đầu tiên
			setDefaultVariation();

			// Khi nhấn vào product-variations để mở dropdown
			$('.product-variations').click(function () {
				$('.variation-dropdown').toggle();
			});

			// Khi chọn một variation từ dropdown
			$('.variation-option').click(function () {
				let material = $(this).data("material");
				let color = $(this).data("color");
				let stock = $(this).data("stock");

				if (stock <= 0) {
					// Hiển thị thông báo nếu hết hàng
					Swal.fire("This variation is out of stock.");
					return;
				}

				// Cập nhật thông tin variation đã chọn
				selectedVariationId = $(this).data("variation_id");
				$('#current-variation').text(`${material} - ${color}`);
				$('#current-availability').text(stock > 0 ? "Available" : "Out of Order");

				// Cập nhật trạng thái nút Add to Cart
				let addToCartButton = $('#add-to-cart-button');
				addToCartButton.prop('disabled', false).removeClass('out-of-order');
				addToCartButton.data('variation_id', selectedVariationId);

				// Ẩn dropdown
				$('.variation-dropdown').hide();
			});

			// Xử lý thêm vào giỏ hàng
			$('#add-to-cart-button').click(function () {
				let productId = $(this).data("product_id");
				if (!selectedVariationId) {
					Swal.fire("Please select a variation before adding to cart.");
					return;
				}
				$.ajax({
					type: "POST",
					url: "@Url.Action("Add", "Cart")",
					data: { productId: productId, variationId: selectedVariationId },
					success: function (result) {
						if (result.success) {
							Swal.fire("Added to cart successfully.");
						} else {
							Swal.fire("Error: " + result.message);
						}
					},
					error: function (xhr) {
						Swal.fire("Có lỗi xảy ra khi thêm vào giỏ hàng: " + xhr.responseText);
					}
				});
			});

			// Hiển thị thông báo khi nhấn vào nút OUT OF ORDER
			$('.add-to-cart.out-of-order').click(function () {
				Swal.fire("This item is out of stock.");
			});

			// Ẩn dropdown nếu click ra ngoài
			$(document).click(function (e) {
				if (!$(e.target).closest('.product-variation-section').length) {
					$('.variation-dropdown').hide();
				}
			});
		});



		// ------------------- VARIANTS ------------------------

					document.querySelectorAll(".toggle-button").forEach((button) => {
			button.addEventListener("click", () => {
				const content = button.nextElementSibling;

				if (content.classList.contains("open")) {
					// Đóng nội dung bằng cách giảm max-height về 0
					content.style.maxHeight = null;
					content.classList.remove("open");
				} else {
					// Đóng tất cả các phần khác nếu muốn
					document.querySelectorAll(".content.open").forEach((openContent) => {
						openContent.style.maxHeight = null;
						openContent.classList.remove("open");
					});

					// Mở phần nội dung hiện tại
					content.style.maxHeight = content.scrollHeight + "px";
					content.classList.add("open");
				}
			});
		});

		// ------------ PLUS/ MINUS ----------------
				// Lấy tất cả các tiêu đề có class 'toggle-button'
		const toggleButtons = document.querySelectorAll('.toggle-button');

		// Gắn sự kiện click cho từng tiêu đề
		toggleButtons.forEach(button => {
		  button.addEventListener('click', () => {
			// Chuyển đổi class 'active' cho tiêu đề hiện tại
			button.classList.toggle('active');

			// Thay đổi dấu '+' thành '-' và ngược lại
			const icon = button.querySelector('.toggle-icon');
			if (icon.textContent === '+') {
			  icon.textContent = '-';
			} else {
			  icon.textContent = '+';
			}
		  });
		});

		// ----------------- scrollLeft/Right --------------
				document.addEventListener("DOMContentLoaded", function () {
			const slider = document.querySelector(".variants-list");
			const prevButton = document.querySelector(".slider-btn.prev");
			const nextButton = document.querySelector(".slider-btn.next");
			const scrollAmount = slider.querySelector(".variant-image").offsetWidth + 10; // Kích thước + khoảng cách giữa các ảnh

			prevButton.addEventListener("click", function () {
				slider.scrollLeft -= scrollAmount * 4; // Lùi lại 4 biến thể
			});

			nextButton.addEventListener("click", function () {
				slider.scrollLeft += scrollAmount * 4; // Tiến tới 4 biến thể
			});
		});

	</script>
}
