@model ProductDetailsViewModel
@{
	var materialName = Model.Variations.FirstOrDefault()?.Material.Name;
	var colorName = Model.Variations.FirstOrDefault()?.Color.Name;
	var selectedVariationId = "";
}
<style>
	.detail-container {
		position: relative;
		overflow: hidden;
		padding: 70px 0px 0px 0px;
	}

	.col-sm-6{
		padding-right: 0px !important;
		padding-left: 0px !important;
	}

	.product-details{
		display: flex; /* Để xếp hai hình ngang nhau */
		justify-content: space-between; /* Đặt khoảng cách đều giữa hình ảnh */
		align-items: center; /* Căn giữa theo chiều dọc */
		margin: 0;
		padding: 0;
		background-color: #e7e7e7;
		min-height:100vh;
	}

	.view-productPrimary {
		position: relative !important;
		margin-top: -31.9vh;
		z-index: 2;
		padding-top: 110px;
		box-sizing: border-box;
		display: table;
		height: inherit;
		margin-bottom: 0;
		margin-right: 10vw;
		top: 0;
		width: 40vw;
}

		.view-productPrimary img {
		height: 100%;
		min-height:77rem;
		background-color: #dcdcdc;
		transform: scale(1.5);
		vertical-align: middle;

	}

	.view-productSecondary {
		position: relative !important;
		margin-top: -13.9vh;
		z-index: 2;
		padding-top: 110px;
		box-sizing: border-box;
		display: table;
		height: inherit;
		margin-bottom: 0;
		margin-left: 10vw;
		margin-right: 10vw;
		top: 0;
		width: 40vw;
	}

		.view-productSecondary img {
			height: 70%; /* Giảm chiều cao xuống 70% */
			width: auto; /* Tự động điều chỉnh chiều rộng theo tỷ lệ */
			background-color: #dcdcdc;
			transform: scale(1); /* Đặt lại scale mặc định */
			vertical-align: middle;
			margin: auto; /* Canh giữa hình trong khung */
			display: block;
		}

	.product-table-wrapper {
		position: absolute; /* Đặt vị trí tuyệt đối để dễ canh chỉnh */
		top: 50%; 
		left: 50%; 
		transform: translate(-50%, -50%); /* Đảm bảo căn chính giữa */
		z-index: 3;
		background-color: rgba(255, 255, 255, 0.8);
		padding: 5px 20px 0px 20px;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
		border-radius: 3px;
		max-width: 350px; /* Giới hạn độ rộng cứng */
		width: 100%;
		box-sizing: border-box;
	}

	.productNameAndPriceContainer {
		display: flex; /* Sử dụng flexbox */
		flex-direction: column; /* Căn theo chiều dọc từ trên xuống */
		align-items: center; /* Căn giữa theo chiều ngang */
		justify-content: center; /* Căn giữa theo chiều dọc */
		text-align: center; /* Canh giữa văn bản */
		padding: 20px 0px 20px 0px; /* Thêm khoảng cách bên trong */
		word-wrap: break-word; /* Tự động xuống dòng nếu chuỗi quá dài */
	}

	.product-name {
		font-family: Arial;
		font-size: 1.7rem;
		font-weight: bold;
		margin-bottom: 1.8rem; /* Khoảng cách giữa các phần tử */
		text-transform: uppercase;
		overflow-wrap: break-word;
	}

	.product-price {
		font-size: 1.9rem;
		color: black;
		font-weight: 600;
		margin-bottom: 1.8rem;
		max-width: 100%;
	}


	.product-variation-section {
		position: relative;
	}
	.product-variations{
		font-size: 1.6rem;
		color: #443e3e;
		margin-bottom: 1.8rem;
		max-width: 100%;
		cursor:pointer;
		white-space: normal !important;
	}

	.variation-dropdown {
		position: absolute;
		top: 20%;
		left: 0;
		background: white;
		border: 1px solid #ddd;
		box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
		z-index: 1000;
		width: 100%;
		max-height: 200px;
		overflow-y: auto;
	}

	.variation-option {
		padding: 10px;
		cursor: pointer;
	}

		.variation-option:hover {
			background: #f8f9fa;
		}


	.product-availability {
		font-size: 1.3rem;
		color: #443e3e;
		font-weight: bold;
		margin: 0;
		text-transform: uppercase;
		max-width: 100%;
	}


	.product-delivery-info {
		font-size: 1.4rem;
		color: #443e3e;
		max-width: 100%; /* Giới hạn chiều rộng */
		text-align: center;
		word-wrap: break-word;
	}

	.add-to-cart {
		background-color: #000;
		color: #fff;
		border: none;
		padding: 10px 20px;
		font-size: 16px;
		border-radius: 2px;
		cursor: pointer;
		width: -webkit-fill-available;
		transition: transform 0.5s ease;
	}

		.add-to-cart:hover {
			transform: scale(0.95); /* Thu nhỏ nút một chút */
			background-color: black;
			color: white;
		}

		.add-to-cart.out-of-order {
			background-color: gray; /* Màu xám cho trạng thái hết hàng */
			cursor: not-allowed;
		}
	.new-section {
		background-color: black; /* Màu nền tùy chỉnh */
		padding: 20px; /* Khoảng cách padding cho toàn bộ khung */
		color: white;
	}

	.product-variants-container {
		background-color: black; /* Màu nền cho khung bên trái */
		padding: 10px;
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
	}

	.detail-right-contain {
		background-color: black; /* Màu nền cho khung bên phải */
		padding: 20px;
		border-radius: 8px;
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
	}

	/* Tổng container với border */
	.product-detail-container {
		border: 1px solid #ddd;
		padding: 20px;
		border-radius: 5px;
		text-align: center; /* Căn giữa nội dung */
		background-color: #fff;
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Thêm hiệu ứng đổ bóng */
	}

	/* Hình ảnh sản phẩm */
	.product-detail-image img {
		max-width: 15vw;
		height: auto;
		margin: 0 auto;
		display: block;
		border-radius: 5px; /* Làm mềm các góc của hình ảnh */
	}

	/* Cam kết */
	.commitment {
	}

		.commitment img {
			width: 3.5rem; /* Định kích thước icon */
			height: 3.5rem;
		}

		.commitment p {
			margin-top: 1rem;
			font-size: 1.2rem;
			font-weight: 600;
			color: #333; /* Màu chữ cam kết */
		}

			.commitment p::after {
				content: ""; /* Thêm phần tử gạch chân */
				display: block;
				width: 25%; /* Chiều dài gạch chân (bằng 50% chiều rộng chữ) */
				height: 2px; /* Độ dày gạch chân */
				background-color: #333; /* Màu sắc gạch chân */
				margin: 0px auto; /* Căn giữa và thêm khoảng cách */
			}

	/* Chi tiết sản phẩm */
	.product-detail-text h3 {
		margin-top: 5rem;
		font-size: 2rem;
		font-weight: bold;
		text-align: left;
		color: #000; /* Màu tiêu đề */
	}

	.product-detail-text p {
		font-size: 1.5rem;
		color: #555;
		text-align: left;
		line-height: 1.6;
		margin-top: 10px;
	}
	
	.product-detail-text li{
		color: black;
		text-align: left;
		padding-left: 2rem;
		font-size: 1.3rem;
	}
	
	.product-detail-text li::before {
		content: "•"; /* Dấu chấm */
		position: absolute;
		left: 5rem; /* Đặt dấu chấm ở bên trái */
		color: #333; /* Màu dấu chấm */
		font-size: 2rem; /* Kích thước dấu chấm */
		line-height: 1; /* Đặt chiều cao dòng */
	}

	.product-details-list {
		margin-top: 10px;
		padding-left: 20px; /* Thụt vào danh sách */
		font-size: 1.3rem;
		color: #333; /* Màu chữ */
	}

		.product-details-list li {
			text-align: left;
			margin-bottom: 5px; /* Khoảng cách giữa các dòng */
			list-style: none; /* Ẩn dấu chấm mặc định */
			position: relative;
			padding-left: 1.5rem;
		}


	.variant-contain {
		border-bottom: 1px solid #ccc;
	}

	.material-contain {
		font-family: "Arial", sans-serif;
		border-bottom: 1px solid #ccc;
		padding-top: 3rem;
		padding-bottom: 1.5rem;
		color: white;
	}

	.material-description {
		margin-top: 1rem;
		font-size: 1.3rem;
		margin-bottom: 1.5rem;
	}

	.material-contain .content {
		max-height: 0; /* Nội dung ban đầu ẩn */
		overflow: hidden; /* Ẩn nội dung tràn */
		transition: max-height 0.5s ease; /* Hiệu ứng trượt mượt */
	}

		.material-contain .content.open {
			max-height: 500px; /* Đặt chiều cao tối đa khi mở (tùy chỉnh theo nội dung) */
		}

	.material-list {
		list-style: none; /* Tắt dấu chấm mặc định */
		padding-left: 20px; /* Khoảng cách lùi trái */
	}

		.material-list li {
			margin-bottom: 10px; /* Khoảng cách giữa các mục */
			position: relative; /* Đặt relative để căn chỉnh */
			padding-left: 20px; /* Khoảng cách lùi trái cho nội dung */
			font-size: 1.3rem;
		}

			.material-list li::before {
				content: ''; /* Thêm dấu chấm */
				position: absolute;
				left: 0;
				top: 50%;
				transform: translateY(-50%);
				width: 8px; /* Kích thước dấu chấm */
				height: 8px;
				background-color: white; /* Màu của dấu chấm */
				border-radius: 50%; /* Làm tròn dấu chấm */
				opacity: 0; /* Ẩn dấu chấm ban đầu */
				transition: opacity 0.3s ease; /* Hiệu ứng khi xuất hiện */
			}

	.material-contain .content.open .material-list li::before {
		opacity: 1; /* Hiển thị dấu chấm khi nội dung được mở */
	}



	.shipping-contain {
		border-bottom: 1px solid #ccc;
		padding-top: 3rem;
		padding-bottom: 1.5rem;
	}

	.payment-contain {
		border-bottom: 1px solid #ccc;
		padding-top: 3rem;
		padding-bottom: 1.5rem;
	}

	.packaging-contain {
		border-bottom: 1px solid #ccc;
		padding-top: 3rem;
		padding-bottom: 1.5rem;
	}


	.variants-title {
		font-size: 1.7rem;
		font-weight: bold;
		margin-bottom: 10px;
		padding-right: 20px; /* Tạo không gian cho dấu '+' hoặc '-' */
	}

	.toggle-icon {
		font-size: 1.7rem;
		margin-left: 10px;
		transition: transform 0.2s ease;
	}

	.toggle-button.active .toggle-icon {
		content: '-'; /* Chuyển thành dấu '-' khi được kích hoạt */
	}

	.variant-slider {
		display: flex;
		align-items: center;
		position: relative;
		overflow: hidden;
		max-width: 100%;
	}

	.variants-list {
		display: flex;
		gap: 10px;
		scroll-behavior: smooth;
		max-width: calc(4 * 100px); /* Hiển thị 4 biến thể, mỗi biến thể 100px */
		flex-wrap: nowrap;
	}

	.variant-image {
		width: 15vw;
		height: 35vh;
		object-fit: cover;
		border-radius: 5px;
		cursor: pointer;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.slider-btn {
		background: #fff;
		border: 1px solid #ccc;
		padding: 5px 10px;
		cursor: pointer;
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 1;
	}

		.slider-btn.prev {
			left: 10px;
		}

		.slider-btn.next {
			right: 10px;
		}

	.content {
		max-height: 0; /* Ban đầu ẩn nội dung */
		overflow: hidden;
		transition: max-height 0.4s ease; /* Tạo hiệu ứng trượt */
		max-width: 55rem;
	}

		.content.open {
			max-height: 500px; /* Điều chỉnh chiều cao tối đa để nội dung trượt xuống */
		}

	.toggle-button {
		cursor: pointer;
		font-weight: bold;
		margin-bottom: 10px;
	}

	.shipping-table {
		width: 100%;
		border-collapse: collapse;
		margin: 20px 0;
		font-size: 16px;
		text-align: left;
	}

		.shipping-table th, .shipping-table td {
			border: 1px solid #ddd;
			padding: 12px;
			vertical-align: middle;
		}

		.shipping-table th {
			background-color: #f4f4f4;
			font-weight: bold;
			color: black;
		}

		.shipping-table td small {
			font-size: 14px;
			color: #ccc;
		}

	.payment-grid {
		display: flex;
		gap: 8rem; /* khoảng cách giữa 2 cột */
		font-size: 1.3rem;
		padding-left: 2.5rem;
	}

		.payment-grid ul {
			list-style-type: none;
			padding: 0;
			margin: 0;
		}

		.payment-grid li {
			margin-bottom: 1.1rem; /* khoảng cách giữa các mục trong cột */
			position: relative;
			padding-left: 3rem;
		}

			.payment-grid li::before {
				content: '';
				position: absolute;
				left: 0;
				top: 50%;
				transform: translateY(-50%);
				width: 23px; /* Kích thước hình ảnh */
				height: 14px;
				background-image: url('https://www.gucci.com/_ui/responsive/common/20250211062345/images/sprite-hd-standard.png'); /* Thay link này bằng đường dẫn ảnh của bạn */
				background-repeat: no-repeat;
				background-size: 531px 510px; /* Tùy chỉnh kích thước tổng của sprite */
			}

	.visa::before {
		background-position: -327px -433px;
	}

	.master::before {
		background-position: -252px -433px;
	}

	.apple-pay::before {
		background-position: -469px -420px;
	}

	.amazon-pay::before {
		background-position: -469px -404px;
	}

	.amex::before {
		background-position: -409px -407px;
	}

	.paypal::before {
		background-position: -277px -433px;
	}

	.discover::before {
		background-position: -152px -433px;
	}

	.jcb::before {
		background-position: -202px -433px;
	}

	.gift-images {
		display: flex; /* Dùng flexbox để bố trí các hình ảnh */
		justify-content: space-between; /* Tạo khoảng cách đều giữa các hình */
		align-items: center; /* Căn giữa theo chiều dọc nếu cần */
		padding-top: 3.5rem;
	}

		.gift-images img {
			width: 50%; /* Mỗi hình chiếm 50% chiều rộng */
			height: auto; /* Giữ nguyên tỷ lệ hình ảnh */
			padding-right: 5px;
			object-fit: cover; /* Tùy chỉnh cắt hình nếu cần */
			border-radius: 2px; /* Thêm bo góc (tùy chọn) */
		}

	.gift-content{
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding-top: 3rem;
	}


</style>

<div style="font-family: Arial, sans-serif;">
	<div class="detail-container">
		<div class="product-details">
			<!--product-details-->
			<div class="col-sm-6">
				<div class="view-productPrimary">
					<img src="~/media/products/@Model.ProductDetails.Image2" alt="" />
					@* <h3>ZOOM</h3> *@
				</div>
				@* <div id="similar-product" class="carousel slide" data-ride="carousel">

					<!-- Wrapper for slides -->
					<div class="carousel-inner">
						<div class="item active">
							<a href=""><img src="images/product-details/similar1.jpg" alt=""></a>
							<a href=""><img src="images/product-details/similar2.jpg" alt=""></a>
							<a href=""><img src="images/product-details/similar3.jpg" alt=""></a>
						</div>
						<div class="item">
							<a href=""><img src="images/product-details/similar1.jpg" alt=""></a>
							<a href=""><img src="images/product-details/similar2.jpg" alt=""></a>
							<a href=""><img src="images/product-details/similar3.jpg" alt=""></a>
						</div>
						<div class="item">
							<a href=""><img src="images/product-details/similar1.jpg" alt=""></a>
							<a href=""><img src="images/product-details/similar2.jpg" alt=""></a>
							<a href=""><img src="images/product-details/similar3.jpg" alt=""></a>
						</div>

					</div> *@

					<!-- Controls -->
					@* <a class="left item-control" href="#similar-product" data-slide="prev">
						<i class="fa fa-angle-left"></i>
					</a>
					<a class="right item-control" href="#similar-product" data-slide="next">
						<i class="fa fa-angle-right"></i>
					</a> *@
				@*</div>*@

			</div>

			<div class="product-table-wrapper">
				<div class="product-container">
					<div class="productNameAndPriceContainer">
						<h1 class="product-name">
							@Model.ProductDetails.Name
						</h1> <!-- Tên túi -->
						@if (Model.Variations != null && Model.Variations.Any())
						{

							var firstVariation = Model.Variations.First();
							<p class="product-price" id="product-price">$@firstVariation.Price.ToString("#,0")</p> <!-- Giá tiền -->
							<div class="product-variation-section">
								<!-- Hiển thị variation đầu tiên -->
								<p class="product-variations dropdown-toggle">
									Variations: <span id="current-variation">@firstVariation.Material.Name - @firstVariation.Color.Name</span>
								</p>

								<!-- Dropdown danh sách các variation -->
								<div class="variation-dropdown" style="display: none;">
									@foreach (var variation in Model.Variations)
									{
										<div class="variation-option"
											 data-variation_id="@variation.Id"
											 data-material="@variation.Material.Name"
											 data-color="@variation.Color.Name"
											 data-stock="@variation.Stock">
											@variation.Material.Name - @variation.Color.Name
											(@(variation.Stock > 0 ? "Available" : "Out of Order"))
										</div>
									}
								</div>

								<!-- Thông tin chi tiết -->
								<p class="product-availability">
									Availability: <span id="current-availability">@((firstVariation.Stock > 0) ? "Available" : "Out of Order")</span>
								</p>
								<p class="product-delivery-info">Enjoy complimentary delivery or Collect In Store</p>

								<!-- Nút Add to Cart -->
								@if (firstVariation.Stock > 0)
								{
									<button class="add-to-cart" id="add-to-cart-button" data-product_id="@Model.ProductDetails.Id" data-variation_id="@firstVariation.Id">
										ADD TO SHOPPING BAG
									</button>
								}
								else
								{
									<button class="add-to-cart out-of-order" disabled>
										OUT OF ORDER
									</button>
								}
							</div>
						}
						else
						{
							<p class="product-variations">No variations available</p>
							<p class="product-availability">Out of Order</p>
							<p class="product-delivery-info">Enjoy complimentary delivery or Collect In Store</p>
						}


					</div>
				</div>
			</div>


			<div class="col-sm-6">
				<div class="view-productSecondary">
					<img src="~/media/products/@Model.ProductDetails.Image" alt="" />
					@* <h3>ZOOM</h3> *@
				</div>
			</div>

			@* <div class="col-sm-6">
				<div class="product-information">
					<h2>@Model.ProductDetails.Name</h2>
					<p>Product ID: @Model.ProductDetails.Id</p>
					<span>
						<span>US $@Model.ProductDetails.Price</span>
						@if (Model.ProductDetails.Quantity > 0)
						{
							<button class="btn btn-fefault add-to-cart" data-product_id="@Model.ProductDetails.Id">
								<i class="fa fa-shopping-cart"></i> Add to cart
							</button>
						}
						else
						{
							<button class="btn btn-fefault">
								<i class="fa fa-minus-square"></i> Out of stock
							</button>
						}
					</span>

					<p><b>Availability:</b> @(Model.ProductDetails.Quantity > 0 ? "In Stock" : "Out of Stock")</p>
					<p><b>Brand:</b> @Model.ProductDetails.Brand.Name</p>
					<p><b>Category:</b> @Model.ProductDetails.Category.Name</p>
					<p><b>Warranty:</b> @Model.ProductDetails.WarrantyPeriod months</p>

					@if (Model.Variations != null && Model.Variations.Count > 0)
					{
