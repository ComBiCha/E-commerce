@model IEnumerable<ProductModel>
@using System.Web
@{
	ViewData["Title"] = @ViewBag.Keyword;
}
<div>
	
	<style>
		.search-container {
			overflow: hidden;
			padding: 70px 0px 100px 0px;
		}

		.overlay {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.2); /* Overlay mờ với màu đen */
			z-index: 1; /* Nằm phía trên hình ảnh */
		}

		.image-header {
			position: relative;
			display: flex;
			justify-content: center;
			align-items: center;
			flex-direction: column; /* Xếp chồng hình ảnh và text */
			height: 90vh; /* Hoặc 100vh nếu cần */
			width: 100%;
			overflow: hidden;
			text-align: center;
		}

		.page-banner {
			position: absolute;
			width: 100%;
			height: 100%;
			object-fit: cover;
			z-index: 1; /* Nằm phía sau */
		}

		.search_text{
			margin-top: 11rem;
			position: relative;
			z-index: 2; /* Nằm trên hình ảnh */
			color: white;
		}

		.search_title {
			font-size: 5rem;
			text-transform: uppercase;
			margin-bottom: 20px;
			font-family: serif;
		}

		.search_subtitle {
			font-size: 1.8rem;
			text-transform: capitalize;
			font-family: serif;
		}


		/*------------------------------ Sản phẩm ------------------------------------- */
		.search_items {
			display: flex;
			flex-wrap: wrap; /* Cho phép xuống dòng nếu không đủ chỗ */
			padding: 2rem;
		}

			.search_items .col-sm-3 {
				padding: 0px !important;
			}

		.product-image-wrapper {
			position: relative;
			border: 1px solid #e0e0e0;
			overflow: hidden;
			transition: transform 0.3s ease;
			margin: 0 !important;
		}


		.product-top {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 10px 15px;
			background-color: #e7e7e7; /* Màu nền nhạt */
		}

		.new-label {
			color: black;
			padding: 5px 10px;
			font-weight: bold;
			font-size: 14px;
		}

		.heart-icon {
			color: #e7e7e7; /* Màu đỏ cho icon trái tim */
			font-size: 18px;
			cursor: pointer;
			-webkit-text-stroke: 1px black; /* Viền ngoài màu đen */
			text-stroke: 1px black;
		}

			.heart-icon:hover {
				color: black; /* Khi hover, trái tim chuyển thành màu đỏ */
				-webkit-text-stroke: 1px black; /* Giữ viền ngoài màu đen */
			}

			.heart-icon.liked {
				color: black; 
				-webkit-text-stroke: 1px black; 
			}

		.productinfo {
		}

			.productinfo img {
				transition: transform 0.3s;
				width: 100%; /* Đảm bảo hình ảnh luôn full chiều rộng */
			}

	</style>
	<div class="search-container">
		<div class="image-header">
			@if (!string.IsNullOrEmpty(Context.Request.Query["category"]) && !string.IsNullOrEmpty(Context.Request.Query["brand"]))
			{
				string category = HttpUtility.UrlDecode(Context.Request.Query["category"].ToString()).ToLower();
				string brand = Context.Request.Query["brand"].ToString().ToLower();

				// Kết hợp category và brand để chọn hình ảnh và tiêu đề
				if (category == "women's" && brand == "handbags")
				{
					<img src="https://media.gucci.com/content/HeroRegularStandard_1600x675/1738772108/HeroRegularStandard_Gucci-TierII-SS25-Jan25-4135-HW-GUCCI-19_001_Default.jpg" alt="Women's Handbags" class="page-banner" />
					<div class="overlay"></div>
					<div class="search_text">
					<h2 class="search_title text-center">Handbags For Women</h2>
					<h2 class="search_subtitle text-center">
							Crafted for everyday luxury, Merdi designer handbags blend sophistication and flair, with Merdi Blondie,
						<br/>
							GG Emblem, and Merdi B.
					</h2>
					</div>
				}
				else if (category == "women's" && brand == "shoes")
				{
					<img src="https://media.gucci.com/content/HeroRegularStandard_1600x675/1736954115/HeroRegularStandard_Gucci-SS25-Jan25-1-4-0469-11-F_001_Default.jpg" alt="Women's Shoes" class="page-banner" />
					<div class="overlay"></div>
					<div class="search_text">
						<h2 class="search_title text-center">Shoes For Women</h2>
						<h2 class="search_subtitle text-center">
							The Merdi collection of women's designer shoes features luxury sneakers, Horsebit loafers, sandals, heels and more.
						</h2>
					</div>
				}
				else if (category == "men's" && brand == "bags")
				{
					<img src="https://media.gucci.com/content/HeroRegularStandard_1600x675/1738579517/HeroRegularStandard_Gucci-TierII-SS25-Jan25-4135-HW-GUCCI-08_001_Default.jpg" alt="Men's Bags" class="page-banner" />
					<div class="overlay"></div>
					<div class="search_text">
						<h2 class="search_title text-center">Bags For Men</h2>
						<h2 class="search_subtitle text-center">
							The collection of bags for men features duffle bags, briefcases, messenger bags, belt bags and backpacks in a range of materials and colors.
						</h2>
					</div>
				}
				else if (category == "men's" && brand == "shoes")
				{
					<img src="https://media.gucci.com/content/HeroRegularStandard_1600x675/1738750510/HeroRegularStandard_Gucci-TierII-SS25-Feb25-Gucci-SS25-Shot3-225-SAFE_001_Default.jpg" alt="Men's Shoes" class="page-banner" />
					<div class="overlay"></div>
					<div class="search_text">
						<h2 class="search_title text-center">Shoes For Men</h2>
						<h2 class="search_subtitle text-center">
							The Merdi Horsebit 1953 takes center stage alongside signature Jordaan loafers, sneakers, and men's designer shoes.
						</h2>
					</div>
				}
			}
			else if (!string.IsNullOrEmpty(Context.Request.Query["category"]) && string.IsNullOrEmpty(Context.Request.Query["brand"]))
			{
				string category = Context.Request.Query["category"].ToString().ToLower();

				// Hiển thị hình ảnh và tiêu đề cho All Products của Nam hoặc Nữ
				if (category == "women's")
				{
					<img src="https://media.gucci.com/content/HeroRegularStandard_1600x675/1738771124/HeroRegularStandard_Gucci-TierII-SS25-Jan25-4135-HW-GUCCI-09_001_Default.jpg" alt="All Women's Products" class="page-banner" />
					<div class="overlay"></div>
					<div class="search_text">
						<h2 class="search_title text-center">Women</h2>
						<h2 class="search_subtitle text-center">
							The Spring Summer 2025 collection for women introduces the new Merdi Go shoulder bag, bamboo-inspired handbags and jewelry, and Horsebit motifs.
						</h2>
					</div>
				}
				else if (category == "men's")
				{
					<img src="https://media.gucci.com/content/HeroRegularStandard_1600x675/1738579517/HeroRegularStandard_Gucci-TierII-SS25-Jan25-4135-HW-GUCCI-08_001_Default.jpg" alt="All Men's Products" class="page-banner" />
					<div class="overlay"></div>
					<div class="search_text">
						<h2 class="search_title text-center">Men</h2>
						<h2 class="search_subtitle text-center">
							The Spring Summer 2025 collection for men includes relaxed tailoring, vibrant prints, Merdi B, Horsebit shoes and the new Merdi cub3d sneakers.
						</h2>
					</div>
				}
			}
		</div>

		<div> 
			@Html.Partial("_SideBarPartical")
		</div>

		<div class="search_items">
			@foreach (var item in Model)
			{
				<div class="col-sm-3">
					<div class="product-image-wrapper">
						<div class="single-products">
							<div class="product-top">
							<span class="new-label">New</span>
								<span class="heart-icon @(ViewBag.Wishlist.Contains(item.Id) ? "liked" : "")" data-product-id="@item.Id">
									<i class="fa fa-heart"></i>
								</span>
					</div>

							<div class="productinfo text-center">
								<a asp-action="Details" asp-controller="Product" asp-route-Id="@item.Id"><img src="~/media/products/@item.Image" alt="@item.Name" width="100%" /></a>
								 @* <h2>$@item.Price</h2> 
								 <p>@item.Name</p> 
								 <p>Category: @item.Category.Name</p>
								 <p>Brand: @item.Brand.Name</p>
								 @if (item.Quantity > 0) 
								 { 
								 	<a asp-action="Details" asp-controller="Product" asp-route-Id="@item.Id" class="btn btn-default add-to-cart"><i class="fa fa-shopping-cart"></i>View Details</a> 
								 } 
								 else 
								 { 
								 	<a class="btn btn-default add-to-cart"><i class="fa fa-minus-square"></i>Sold Out</a> 
								 } 
								 @if (User.Identity?.IsAuthenticated ?? false) 
								 { 
								 	<ul class="nav nav-pills nav-justified"> 
								 		<li><button class="btn btn-default add-btn-wishlist"><i class="fa fa-plus-square"></i><a asp-action="AddWishList" asp-controller="Home" asp-route-Id="@item.Id"> Add Wishlist</a></button></li> 
								 	</ul> 
								 }  *@
							</div>
						</div>
					</div>
				</div>
			}

		</div><!--features_items-->
		@* <div class="pagination">
			@if (ViewBag.Page > 1)
			{
				<a asp-action="Index" asp-route-page="1" class="first">First</a> <!-- Nút "First" -->
				<a asp-action="Index" asp-route-page="@(ViewBag.Page - 1)" class="prev">Previous</a>
			}

			@for (var i = 1; i <= ViewBag.TotalPages; i++)
			{
				<a asp-action="Index" asp-route-page="@i" class="@(i == ViewBag.Page ? "active" : "")">@i</a>
			}

			@if (ViewBag.Page < ViewBag.TotalPages)
			{
				<a asp-action="Index" asp-route-page="@(ViewBag.Page + 1)" class="next">Next</a>
				<a asp-action="Index" asp-route-page="@ViewBag.TotalPages" class="last">Last</a> <!-- Nút "Last" -->
			}
		</div> *@
	</div>
</div>


		@section Scripts {
			<script>
				$(document).ready(function () {
					$('.add-btn-wishlist').click(function () {
						var Id = $(this).data("product_id");

						$.ajax({
							type: "POST",
							url: "@Url.Action("AddWishList", "Home")",
							data: { Id: Id },

							success: function (result) {
								if (result) {
									Swal.fire("Added to wishlist successfully.");
								}
							},
							error: function () {
								Swal.fire("Error when adding to wishlist!");
							}
						});
					});
				});
			</script>
			<script>
				$(document).ready(function () {
					$('.add-btn-compare').click(function () {
						var Id = $(this).data("product_id");

						$.ajax({
							type: "POST",
							url: "@Url.Action("AddCompare", "Home")",
							data: { Id: Id },

							success: function (result) {
								if (result) {
									Swal.fire("Added to compare successfully.");
								}
							},
							error: function () {
								Swal.fire("Error when adding to compare!");
							}
						});
					});
				});
			</script>
			<script>
								document.addEventListener("DOMContentLoaded", function () {
			const heartIcons = document.querySelectorAll(".heart-icon");

			heartIcons.forEach((icon) => {
				icon.addEventListener("click", function () {
					const productId = this.getAttribute("data-product-id");
					const isLiked = this.classList.contains("liked");

					if (isLiked) {
						// Xóa khỏi Wishlist
						this.classList.remove("liked");
						removeFromWishlist(productId);
					} else {
						// Thêm vào Wishlist
						this.classList.add("liked");
						addToWishlist(productId);
					}
				});
			});

			function addToWishlist(productId) {
				fetch(`/Home/AddWishList?Id=${productId}`, { method: "POST" })
					.then((response) => response.json())
					.then((data) => {
						if (data.success) {
							console.log("Sản phẩm đã được thêm vào Wishlist.");
						}
					})
					.catch((error) => console.error("Đã xảy ra lỗi:", error));
			}

			function removeFromWishlist(productId) {
				fetch(`/Home/DeleteWishlist?Id=${productId}`, { method: "POST" })
					.then((response) => response.json())
					.then((data) => {
						if (data.success) {
							console.log("Sản phẩm đã được xóa khỏi Wishlist.");
						}
					})
					.catch((error) => console.error("Đã xảy ra lỗi:", error));
			}
		});


			</script>
		}
