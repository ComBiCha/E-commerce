<style>
    .portal-banner-image {
    position: relative;
    width: 100%;
    height: auto;
    overflow: visible;
    }

    .portal-banner-image img {
            width: 100%;
            height: 40vh;
            object-fit: cover;
            display: block;
            object-position: center 48%;
    }

    .portal-banner-image .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.1); /* Lớp overlay đen với độ mờ */
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 2.5rem;
    font-weight: bold;
    text-transform: uppercase;
    z-index: 2;
    }

    .portal-banner-image h1 {
    margin: 0;
    padding: 0;
    font-size: 4.6rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.6);
    font-family: Arial, Helvetica, sans-serif;
    transform: translateY(2rem);
    }

    .quad {
        bottom: -24px;
        height: 48px;
        left: calc(50%);
        position: absolute;
        z-index: 3;
    }


        .quad:before,
        .quad:after {
            content: "";
            position: absolute;
            display: block;
            border: 24px solid transparent;
        }

        .quad:before {
            border-bottom-color: #490807; /* Màu tam giác phía trên */
            top: 0;
            left: 0;
            transform: translate(-50%, -50%);
        }

        .quad:after {
            border-top-color: black; /* Màu tam giác phía dưới */
            bottom: 0;
            left: 0;
            transform: translate(-50%, 50%);
        }

        .quad .logo {
            position: relative;
            top: 1rem;
            z-index: 4;
            margin-left: -1.45rem;
            width: 3rem; /* Đặt kích thước của hình ảnh */
            height: 3rem;
            object-fit: contain;
        }

            .quad .logo:before {
                content: "";
            }

            .search_items {
			display: flex;
			flex-wrap: wrap; /* Cho phép xuống dòng nếu không đủ chỗ */
			padding: 2rem;
		}

			.search_items .col-sm-3 {
				padding: 0px !important;
			}

		.product-image-wrapper {
			position: relative;
			border: 1px solid #e0e0e0;
			overflow: hidden;
			transition: transform 0.3s ease;
			margin: 0 !important;
		}


		.product-top {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 10px 15px;
			background-color: #e7e7e7; /* Màu nền nhạt */
		}

		.new-label {
			color: black;
			padding: 5px 10px;
			font-weight: bold;
			font-size: 14px;
		}

		.heart-icon {
			color: #e7e7e7; /* Màu đỏ cho icon trái tim */
			font-size: 18px;
			cursor: pointer;
			-webkit-text-stroke: 1px black; /* Viền ngoài màu đen */
			text-stroke: 1px black;
		}

			.heart-icon:hover {
				color: black; /* Khi hover, trái tim chuyển thành màu đỏ */
				-webkit-text-stroke: 1px black; /* Giữ viền ngoài màu đen */
			}

			.heart-icon.liked {
				color: black; 
				-webkit-text-stroke: 1px black; 
			}

		.productinfo {
		}

		.product-container {
			position: relative; /* Đặt container làm gốc để định vị tuyệt đối cho product-details */
			overflow: hidden; /* Đảm bảo phần chi tiết không vượt ra ngoài container */
		}

		/* Hình ảnh sản phẩm */
		.product-image {
			position: relative;
		}
			.product-image img {
			transition: transform 0.8s;
				width: 100%; /* Đảm bảo hình ảnh luôn full chiều rộng */
				background-color: #dcdcdc;
			}

		.primary-image {
			position: absolute;
			z-index: 1;
			opacity: 1;
			transition: opacity 0.5s ease-in-out; /* Thêm chuyển đổi cho transform và opacity */
		}

		.secondary-image {
			z-index: 0;
			opacity: 0;
			transition: opacity 0.5s ease-in-out; /* Thêm chuyển đổi cho transform và opacity */
		}

		.product-container:hover .primary-image {
			opacity: 0; /* Ẩn ảnh đầu tiên */
		}

		.product-container:hover .secondary-image {
			opacity: 1; /* Hiển thị ảnh thứ hai */
			z-index:1;
		}

		.product-details {
			position: absolute; /* Định vị tuyệt đối để che lên các sản phẩm */
			bottom: 0; /* Đặt ở cạnh dưới của container */
			left: 0;
			right: 0;
			background-color: rgba(255, 255, 255, 0.8); /* Nền mờ nhẹ */
			padding: 20px;
			opacity: 0; /* Ban đầu ẩn đi */
			transform: translateY(100%); /* Dịch xuống ngoài khung nhìn */
			transition: transform 0.5s ease-in-out, opacity 0.5s ease-in-out;
			z-index: 2; /* Đảm bảo nằm trên hình ảnh và các phần tử khác */
		}

		.product-name {
			font-size: 1.6rem;
			color: black;
			padding: 0px 0px 20px 0px;
			font-family: Roboto;
		}

		.product-price {
			font-size: 1.7rem;
			font-weight: 400;
			color: black;
			font-family: Roboto;
		}

		.shop-link {
			font-family: Roboto;
			display: inline-block;
			font-size: 1.3rem;
			font-weight: 500;
			color: black;
			position: relative; /* Để đặt `::after` bên dưới */
			transition: color 0.3s ease-in-out;
			text-decoration: none;
		}

			.shop-link::after {
				content: ""; /* Thanh underline đen */
				position: absolute;
				left: 0;
				bottom: -2px; /* Đặt ngay dưới chữ */
				width: 100%; /* Chiều rộng đầy đủ */
				height: 2px; /* Độ dày underline */
				background-color: black; /* Màu underline */
				z-index: 1; /* Hiển thị phía dưới */
			}


		.product-container:hover .product-details {
			opacity: 1; /* Hiển thị chi tiết */
			transform: translateY(0); /* Trượt lên */
		}

		/* Đảm bảo khi hover vào product-details, hình ảnh thứ hai vẫn hiển thị */
		.product-container:hover .secondary-image {
			opacity: 1; /* Đảm bảo giữ image2 */
		}
</style>

<div style="padding: 7rem 0.7rem 3rem 0.7rem; background-color: black">
    <div class="portal-banner-image">
        <img src="https://media.gucci.com/content/HeroRegularStandard_1600x675/1738583137/HeroRegularStandard_Gucci-TierII-SS25-Jan25-SS25TIERII-STILLLIFE-S-28-1449_001_Default.jpg" alt="cart-banner" />
        <div class="overlay">
            <h1>WISHLIST</h1>
        </div>
        <div class="quad">
            <img class="logo" src="~/images/banner-cart-removebg-preview.png" alt="Logo">
        </div>
    </div>

    <div>
        @Html.Partial("_SideBarPartical")
    </div>

    <div class="search_items">
        @foreach (var wishlist_product in Model)
        {
            <div class="col-sm-3">
                <div class="product-image-wrapper">
                    <div class="single-products">
                        <div class="product-top">
                            <span class="new-label">New</span>
                        </div>

                        <div class="productinfo text-center">
                            <a asp-action="Details" asp-controller="Product" asp-route-Id="@wishlist_product.Product.Id">
                                <div class="product-container">
                                    <!-- Hình ảnh sản phẩm -->
                                    <div class="product-image">
                                        <img class="primary-image" src="~/media/products/@wishlist_product.Product.Image" alt="@wishlist_product.Product.Name" width="100%" />
                                        <img class="secondary-image" src="~/media/products/@wishlist_product.Product.Image2" alt="@wishlist_product.Product.Name" width="100%" />
                                    </div>
                                    <!-- Chi tiết sản phẩm -->
                                    <div class="product-details">
                                        <h4 class="product-name">@wishlist_product.Product.Name</h4>
                                        <p class="product-price">$@wishlist_product.Product.Price.ToString("#,0")</p>
                                        <span class="shop-link">SHOP THIS</span>
                                    </div>
                                </div>
                            </a>
                            @* <h2>$@item.Price</h2> 
								 <p>@item.Name</p> 
								 <p>Category: @item.Category.Name</p>
								 <p>Brand: @item.Brand.Name</p>
								 @if (item.Quantity > 0) 
								 { 
								 	<a asp-action="Details" asp-controller="Product" asp-route-Id="@item.Id" class="btn btn-default add-to-cart"><i class="fa fa-shopping-cart"></i>View Details</a> 
								 } 
								 else 
								 { 
								 	<a class="btn btn-default add-to-cart"><i class="fa fa-minus-square"></i>Sold Out</a> 
								 } 
								 @if (User.Identity?.IsAuthenticated ?? false) 
								 { 
								 	<ul class="nav nav-pills nav-justified"> 
								 		<li><button class="btn btn-default add-btn-wishlist"><i class="fa fa-plus-square"></i><a asp-action="AddWishList" asp-controller="Home" asp-route-Id="@item.Id"> Add Wishlist</a></button></li> 
								 	</ul> 
								 }  *@
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

    @* @foreach (var wishlist_product in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-controller="Product" asp-route-Id="@wishlist_product.Product.Id">@wishlist_product.Product.Name</a></td>
            <td>@Html.Raw(@wishlist_product.Product.Description)</td>
            <td>@wishlist_product.Product.Price</td>
            <td><img src="~/media/products/@wishlist_product.Product.Image" width="120" /></td>
            <td>
                <a asp-action="DeleteWishlist" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Home" asp-route-Id="@wishlist_product.Wishlists.Id">Delete</a>
            </td>
        </tr>
    } *@
</div>
