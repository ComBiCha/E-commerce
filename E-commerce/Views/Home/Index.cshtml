	<script>
		$(document).ready(function () {
			$('.add-btn-compare').click(function () {
				var Id = $(this).data("product_id");

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddCompare", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result) {
							Swal.fire("Added to compare successfully.");
						}
					},
					error: function () {
						Swal.fire("Error when adding to compare!");
					}
				});
			});
		});

		// ------------------ Ready to wear ---------------

		document.addEventListener("DOMContentLoaded", function () {
			const wrappers = document.querySelectorAll(".rtw-wrapper");
			let currentIndex = 0;

			function showNextWrapper() {
				// Xóa lớp active của wrapper hiện tại
				wrappers[currentIndex].classList.remove("active");

				// Chuyển sang wrapper tiếp theo
				currentIndex = (currentIndex + 1) % wrappers.length;

				// Thêm lớp active vào wrapper mới
				wrappers[currentIndex].classList.add("active");
			}

			// Hiển thị wrapper đầu tiên khi tải trang
			wrappers[currentIndex].classList.add("active");

			// Thiết lập khoảng thời gian 7 giây để chuyển đổi
			setInterval(showNextWrapper, 7000);
		});

	</script>
}
<style>

	.product-image-wrapper {
		height: 410px;
	}

	.category-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
	}

	.category-item {
		text-align: center;
		flex: 1;
	}

	.title,
	.category-container {
		position: relative;
		z-index: 2;
	}

	.category-img {
		width: 100%;
		max-width: 330px;
		height: auto;
		cursor: pointer;
		transition: transform 0.5s ease;
		transform: scale(1);
	}

		.category-img:hover {
			transform: scale(0.95);
		}

	.category-item p {
		font-family: Arial, Helvetica, sans-serif;
		margin-top: 10px;
		font-size: 16px;
		color: #ffffff;
		cursor: pointer;
	}

	.category-item a {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-decoration: none;
		color: inherit;
		background-color: transparent;
	}

		.category-item a:focus,
		.category-item a:hover {
			background-color: transparent;
		}


	.rtw-container {
		display: flex;
		justify-content: center;
		align-items: center;
		padding-top: 50px;
		overflow: hidden;
		position: relative;
	}

	.rtw-wrapper {
		position: relative;
		width: fit-content;
		display: none;
	}

		.rtw-wrapper.active {
			display: block;
		}

		.rtw-wrapper::after {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.2); /* Overlay màu đen nhạt, độ trong suốt 20% */
			z-index: 3;
		}

	.rtw-image {
		position: relative;
		display: block;
		max-width: 100%;
		height: 800px;
		border-radius: 8px;
		z-index: 2;
		object-fit: cover;
	}

	.text {
		position: absolute;
		font-size: 20px;
		font-weight: bold;
		text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.8);
		width: 100%;
		text-align: center;
		cursor: pointer;
	}

	.rtw-image {
		z-index: 2;
	}

	.text {
		z-index: 4;
	}

	.top-text {
		position: absolute;
		top: 90px;
		left: 50%;
		transform: translateX(-50%);
		text-transform: uppercase;
		font-size: 12px;
		color: rgb(247, 239, 239);
		background-color: #282224;
		border-radius: 3px;
		padding: 6px 10px;
		text-align: center;
		display: inline-block;
		max-width: fit-content;
		font-family: Arial, Helvetica, sans-serif;
	}

	.bottom-text {
		bottom: 80px;
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		color: white;
	}

	.shop-now-btn {
		margin-top: 25px;
		padding: 15px 20px;
		font-size: 13px;
		font-weight: bold;
		color: white;
		background-color: rgba(77, 77, 77, 0.5);
		border: 1px solid white;
		border-radius: 2px;
		cursor: pointer;
		text-transform: uppercase;
		transition: all 0.3s ease;
		transform: scale(1);
	}

		.shop-now-btn:hover {
			transform: scale(0.95);
		}

	.fade-in {
		animation: fadeIn 0.5s ease-in-out;
	}

	@@keyframes fadeIn {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	.story_items {
		width: 100%;
		max-width: 1200px; /* Giới hạn chiều rộng của container */
		margin: 0 auto; /* Căn giữa container */
		padding: 16px; /* Khoảng cách bên trong */
	}

	.story_title {
		text-transform: uppercase;
		text-align: center;
		font-size: 3rem;
		font-weight: bold;
		margin-bottom: 50px;
		color: white; /* Màu chữ */
	}

	.story_container {
		display: flex; /* Bố cục theo hàng */
		align-items: center; /* Căn giữa theo chiều dọc */
		justify-content: space-between; /* Tách đều các phần tử */
		gap: 16px; /* Khoảng cách giữa các khung */
	}

	.story_image {
		flex: 1; /* Chiếm 1 phần không gian */
	}

		.story_image img {
			width: 100%; /* Ảnh chiếm toàn bộ chiều rộng khung */
			height: auto; /* Giữ tỷ lệ ảnh */
			border-radius: 8px; /* Bo tròn góc ảnh */
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Tạo đổ bóng */
		}

	.story_text {
		flex: 1; /* Chiếm 1 phần không gian */
		padding: 16px; /* Khoảng cách bên trong */
		background-color: #f8f8f8; /* Màu nền khung văn bản */
		border-radius: 8px; /* Bo tròn góc */
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Tạo đổ bóng */
		font-size: 1.2rem; /* Cỡ chữ */
		line-height: 1.5; /* Khoảng cách dòng */
		color: #333; /* Màu chữ */
		text-align: center; /* Căn giữa nội dung */
	}




