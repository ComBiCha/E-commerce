				class="rtw-image" />
				<div class="text top-text">Men</div>
				<div class="text bottom-text">
					<div style="font-size:12px">
						DISTINCTIVE PALETTE AND SILHOUETTES
					</div>
					<div style="font-size:30px;margin-top:30px">
						Ready-to-Wear
					</div>
