<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
<script>
	// ===== READY TO WEAR SLIDER SCRIPT =====
	document.addEventListener("DOMContentLoaded", function () {
		const wrappers = document.querySelectorAll(".rtw-wrapper");
		let currentIndex = 0;

		function showNextWrapper() {
			// Xóa lớp active của wrapper hiện tại
			wrappers[currentIndex].classList.remove("active");

			// Chuyển sang wrapper tiếp theo
			currentIndex = (currentIndex + 1) % wrappers.length;

			// Thêm lớp active vào wrapper mới
			wrappers[currentIndex].classList.add("active");
		}

		// Hiển thị wrapper đầu tiên khi tải trang
		if (wrappers.length > 0) {
			wrappers[currentIndex].classList.add("active");
			// Thiết lập khoảng thời gian 7 giây để chuyển đổi
			setInterval(showNextWrapper, 7000);
		}
	});

	// ===== CHAT WIDGET VARIABLES =====
	let isOpen = false;
	let connection = null;
	let currentUser = "@(ViewBag.UserName ?? "")";
	let userRole = "@(ViewBag.Role ?? "")";
	let customerSupportUserName = "";
	let currentSelectedUser = "";
	let allUsers = []; // Store all users for filtering
	let unreadMessages = {}; // Track unread count per user
	let totalUnreadCount = 0; // Track total unread for main badge

	// ===== LOAD TOTAL UNREAD COUNT FOR MAIN BADGE =====
	async function loadTotalUnreadCount() {

		// Kiểm tra user đã đăng nhập chưa
		if (!currentUser || currentUser === "") {
			console.log("❌ User not authenticated, skipping unread count load");
			totalUnreadCount = 0;
			updateMainNotificationBadge();
			return;
		}

		try {
			console.log("📊 Loading total unread count...");
			const response = await fetch("/Chat/GetTotalUnreadCount");
			if (!response.ok) {
				console.error("Failed to fetch total unread count:", response.status);
				return;
			}

			const count = await response.json();
			totalUnreadCount = count;
			
			console.log(`📊 Total unread count: ${count}`);
			updateMainNotificationBadge();
			
		} catch (error) {
			console.error("❌ Failed to load total unread count:", error);
			totalUnreadCount = 0;
        	updateMainNotificationBadge();
		}
	}

	// ===== UPDATE MAIN NOTIFICATION BADGE =====
	function updateMainNotificationBadge() {
		const badge = document.getElementById("notificationBadge");
		if (!badge) return;

		// Nếu user chưa đăng nhập hoặc không có tin nhắn, ẩn badge
		if (!currentUser || currentUser === "" || totalUnreadCount <= 0) {
			badge.style.display = 'none';
			console.log(`❌ Main badge hidden (user: ${currentUser}, count: ${totalUnreadCount})`);
			return;
		}

		if (totalUnreadCount > 0) {
			badge.textContent = totalUnreadCount > 99 ? '99+' : totalUnreadCount;
			badge.style.display = 'flex';
			console.log(`🔴 Main badge updated: ${totalUnreadCount} messages`);
		}
	}

	// ===== INCREMENT TOTAL UNREAD COUNT =====
	function incrementTotalUnreadCount() {

		// Chỉ increment nếu user đã đăng nhập
		if (!currentUser || currentUser === "") {
			console.log("❌ User not authenticated, not incrementing count");
			return;
		}
			totalUnreadCount++;
			updateMainNotificationBadge();
		}

	// ===== CLEAR TOTAL UNREAD COUNT WHEN OPENING CHAT =====
	function clearTotalUnreadCountForUser(userName) {
		if (userRole === "User") {
			// User: clear all unread from support
			totalUnreadCount = 0;
		} else if (userRole === "Admin" || userRole === "CustomerSupport") {
			// Admin: subtract this user's unread count
			const userUnreadCount = unreadMessages[userName] || 0;
			totalUnreadCount = Math.max(0, totalUnreadCount - userUnreadCount);
		}
		updateMainNotificationBadge();
	}

	// ===== TOGGLE CHAT FUNCTION - ĐỊNH NGHĨA SỚM =====
	function handleToggleChat() {
		const container = document.getElementById('chatContainer');
		const bubble = document.getElementById('chatBubble');
		const chatIcon = document.getElementById('chatIcon');
		const closeIcon = document.getElementById('closeIcon');
		const badge = document.getElementById('notificationBadge');

		isOpen = !isOpen;

			if (isOpen) {
			container.style.display = 'flex';
			bubble.classList.add('bubble-open');
			chatIcon.style.display = 'none';
			closeIcon.style.display = 'block';

			// Clear main badge when opening chat
        	if (currentUser && currentUser !== "" && userRole === "User") {
				// User: clear all unread count when opening
				totalUnreadCount = 0;
				updateMainNotificationBadge();
			}

			// Initialize SignalR when opening chat
			if (!connection) {
				initializeSignalR();
			}
		} else {
			container.style.display = 'none';
			bubble.classList.remove('bubble-open');
			chatIcon.style.display = 'block';
			closeIcon.style.display = 'none';
		}
	}

	// ===== UNREAD MESSAGES TRACKING =====
	function initializeUnreadCount(userName) {
		if (!unreadMessages[userName]) {
			unreadMessages[userName] = 0;
		}
	}

	function updateUserNotificationBadge(userName, count) {
		console.log(`Updating badge for ${userName} with count: ${count}`);

		const badge = document.getElementById(`badge-${userName}`);
		if (!badge) {
			console.log(`Badge not found for user: ${userName}`);
			return;
		}

		const countSpan = badge.querySelector('.badge-count');
		if (!countSpan) {
			console.log(`Count span not found for user: ${userName}`);
			return;
		}

		if (count > 0) {
			countSpan.textContent = count > 99 ? '99+' : count;
			badge.style.display = 'flex';
			console.log(`✅ Badge shown for ${userName}: ${count} messages`);
		} else {
			badge.style.display = 'none';
			console.log(`❌ Badge hidden for ${userName}`);
		}
	}

	function incrementUnreadCount(userName) {
		if (!unreadMessages[userName]) {
			unreadMessages[userName] = 0;
		}
		unreadMessages[userName]++;
		updateUserNotificationBadge(userName, unreadMessages[userName]);
		console.log(`📩 New message from ${userName}. Total unread: ${unreadMessages[userName]}`);
	}

	function clearUnreadCount(userName) {
		if (unreadMessages[userName]) {
			unreadMessages[userName] = 0;
			updateUserNotificationBadge(userName, 0);
			console.log(`✅ Cleared unread count for ${userName}`);
		}
	}

	// ===== LOAD UNREAD COUNTS FROM DATABASE =====
	async function loadUnreadCounts() {
		try {
			console.log("📊 Loading unread counts from database...");
			const response = await fetch("/Chat/GetUnreadCounts");
			if (!response.ok) {
				console.error("Failed to fetch unread counts:", response.status);
				return;
			}

			const unreadData = await response.json();
			console.log("📊 Unread data from database:", unreadData);

			Object.keys(unreadData).forEach(userName => {
				const count = unreadData[userName];
				if (count > 0) {
					unreadMessages[userName] = count;
					updateUserNotificationBadge(userName, count);
					console.log(`🔴 Set badge for ${userName}: ${count} unread messages`);
				}
			});

			console.log("📊 Final unread messages object:", unreadMessages);
		} catch (error) {
			console.error("❌ Failed to load unread counts:", error);
		}
	}

	// ===== RENDER USER LIST =====
	function renderUserList(users) {
		const userListContent = document.getElementById("userListContent");
		if (!userListContent) return;

		userListContent.innerHTML = "";

		users.forEach(user => {
			const userDiv = document.createElement("div");
			userDiv.className = "user-item-widget";
			userDiv.setAttribute("data-user", user);

			userDiv.innerHTML = `
				<span class="user-name">${user}</span>
				<div class="user-notification-badge" id="badge-${user}" style="display: none;">
					<span class="badge-count">0</span>
				</div>
			`;

			if (user === currentSelectedUser) {
				userDiv.classList.add("active");
			}

			userDiv.addEventListener("click", () => selectUser(user));
			userListContent.appendChild(userDiv);
		});
	}

	// ===== SEARCH USERS =====
	function searchUsers(searchTerm) {
		console.log("=== Search Debug ===");
		console.log("Search term:", searchTerm);
		console.log("All users:", allUsers);

		// If search is empty, show all users
		if (!searchTerm || searchTerm.trim() === "") {
			console.log("Empty search, showing all users");
			renderUserList(allUsers);
			return;
		}

		const filteredUsers = allUsers.filter(user => {
			const match = user.toLowerCase().includes(searchTerm.toLowerCase());
			console.log(`User: ${user}, Match: ${match}`);
			return match;
		});

		console.log("Filtered users:", filteredUsers);
		console.log("=== End Search Debug ===");

		renderUserList(filteredUsers);

		// If no users found, show message
		if (filteredUsers.length === 0) {
			const userListContent = document.getElementById("userListContent");
			userListContent.innerHTML = `
				<div style="padding: 10px; color: #6b7280; font-size: 11px; text-align: center; width: 100%;">
					No users found for "${searchTerm}"
				</div>
			`;
		}
	}

		// ===== SELECT USER TO CHAT WITH =====
	async function selectUser(userName) {
		console.log(`Selecting user: ${userName}`);

		// ===== MARK MESSAGES AS READ VIA API =====
		try {
			const response = await fetch("/Chat/MarkMessagesAsRead", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
				},
				body: JSON.stringify(userName)
			});

			if (response.ok) {
				const result = await response.json();
				console.log(`✅ Marked ${result.markedCount} messages as read for ${userName}`);
			}
		} catch (error) {
			console.error("❌ Failed to mark messages as read:", error);
		}

		// Clear unread count in UI
		clearTotalUnreadCountForUser(userName);
		clearUnreadCount(userName);

		currentSelectedUser = userName;
		document.getElementById("receiverWidget").value = userName;
		document.getElementById("chatTitle").textContent = `Chat with ${userName}`;

		console.log(`Updated currentSelectedUser to: ${currentSelectedUser}`);

		// Update UI - remove active from all, add to selected
		document.querySelectorAll(".user-item-widget").forEach(el => {
			el.classList.remove("active");
		});

		const selectedElement = document.querySelector(`.user-item-widget[data-user="${userName}"]`);
		if (selectedElement) {
			selectedElement.classList.add("active");
		}

		// Load chat history for selected user
		loadChatHistory(userName);
	}

	// ===== SIGNALR INITIALIZATION =====
	async function initializeSignalR() {

		 if (!currentUser || currentUser === "") {
        console.log("❌ User not authenticated, not initializing SignalR");
        return;
    	}

		if (connection) return;

		connection = new signalR.HubConnectionBuilder()
			.withUrl("/chatHub")
			.build();

		try {
			await connection.start();
			console.log("SignalR Connected in widget");

			await loadTotalUnreadCount();

			// Get customer support username
			try {
				const csResponse = await fetch("/Chat/GetCustomerSupportUserName");
				if (csResponse.ok) {
					customerSupportUserName = await csResponse.json();
					console.log("Customer Support UserName:", customerSupportUserName);
				}
			} catch (error) {
				console.error("Failed to fetch Customer Support UserName:", error);
			}

			// Setup for different user roles
			if (userRole === "User") {
				document.getElementById("receiverWidget").value = customerSupportUserName;
				document.getElementById("chatTitle").textContent = "Customer Support";
				loadChatHistory(customerSupportUserName);
			} else if (userRole === "Admin" || userRole === "CustomerSupport") {
				console.log("Setting up for Admin/Support role");
				await loadChatUsers();
				const userListWidget = document.getElementById("userListWidget");
				if (userListWidget) {
					userListWidget.style.display = "block";
				}
			}

			// ===== SIGNALR EVENT HANDLERS =====
			connection.on("ReceiveMessage", function (sender, message, imageUrl, messageTimestamp = null) {
			console.log("🔔 ReceiveMessage triggered!");
			console.log(`From: ${sender}, Message: ${message}`);
			console.log(`Current user: ${currentUser}, Role: ${userRole}`);
			console.log(`Selected user: ${currentSelectedUser}`);

			const receiverValue = document.getElementById("receiverWidget")?.value;
			let shouldDisplay = false;

			if (userRole === "User") {
				shouldDisplay = (sender === currentUser) ||
							   (sender === customerSupportUserName);
			} else if (userRole === "Admin" || userRole === "CustomerSupport") {
				shouldDisplay = (sender === currentUser) ||
							   (sender === customerSupportUserName) ||
							   (sender === currentSelectedUser) ||
							   (sender === receiverValue);
			}

			console.log(`Should display message: ${shouldDisplay}`);

			if (shouldDisplay) {
				// Display message in chat
				addMessage(sender, message, imageUrl, messageTimestamp);
				console.log("✅ Message displayed in chat");

				const messagesList = document.getElementById("chatMessages");
				if (messagesList) {
					setTimeout(() => {
						messagesList.scrollTop = messagesList.scrollHeight;
					}, 100);
				}
			} else {
				// Handle unread message counts
                if (userRole === "User") {
                    // User: only count messages from support
                    if (sender === customerSupportUserName && !isOpen) {
                        incrementTotalUnreadCount();
                        console.log(`📢 User received message from support. Total unread: ${totalUnreadCount}`);
                    }
                } else if (userRole === "Admin" || userRole === "CustomerSupport") {
                    // Admin: count messages from regular users
                    const isFromRegularUser = sender !== currentUser && sender !== customerSupportUserName;
                    const isNotCurrentlySelected = sender !== currentSelectedUser;

                    console.log(`Badge check: isFromRegularUser=${isFromRegularUser}, isNotCurrentlySelected=${isNotCurrentlySelected}`);

                    if (isFromRegularUser && isNotCurrentlySelected) {
                        console.log(`📢 Admin received message from user: ${sender}`);
                        incrementUnreadCount(sender);
                        
                        // Only increment total if chat is closed or user not selected
                        if (!isOpen || sender !== currentSelectedUser) {
                            incrementTotalUnreadCount();
                            console.log(`📢 Total unread count: ${totalUnreadCount}`);
                        }
                    }
                }
				updateNotificationBadge();
			}
		});

			connection.on("UpdateUserList", function (newUserName) {
            console.log(`Updating user list for new user: ${newUserName}`);
            loadChatUsers();
            // Reload total unread count when user list updates
            loadTotalUnreadCount();
        });

        connection.on("LoadUserList", function () {
            console.log("Reloading user list based on server request.");
            loadChatUsers();
            // Reload total unread count when user list updates
            loadTotalUnreadCount();
        });

		} catch (err) {
			console.error("SignalR Connection Error in widget: ", err.toString());
			setTimeout(initializeSignalR, 5000); // Retry after 5 seconds
		}
	}

	// ===== LOAD CHAT USERS =====
	async function loadChatUsers() {
		try {
			const response = await fetch("/Chat/GetChatUsers");
			if (!response.ok) {
				console.error("Failed to fetch users, status:", response.status);
				return;
			}

			const users = await response.json();
			console.log("Loaded users from API:", users);

			allUsers = [...users];
			console.log("allUsers array set to:", allUsers);

			renderUserList(users);

			// Initialize unread counts
			users.forEach(user => {
				initializeUnreadCount(user);
			});

			// Load unread counts from database
			await loadUnreadCounts();

			// Auto-select first user logic...
			if (userRole !== "User" && users.length > 0) {
				if (!currentSelectedUser || currentSelectedUser === "" || !users.includes(currentSelectedUser)) {
					console.log(`Auto-selecting first user: ${users[0]}`);
					selectUser(users[0]);
				} else {
					console.log(`Keeping current selected user: ${currentSelectedUser}`);
					document.getElementById("receiverWidget").value = currentSelectedUser;
				}
			}
		} catch (error) {
			console.error("Failed to load chat users:", error);
		}
	}

	// ===== LOAD CHAT HISTORY =====
	async function loadChatHistory(username) {
		try {
			const response = await fetch(`/Chat/GetChatHistory?receiver=${username}`);
			if (!response.ok) return;

			const messages = await response.json();
			const messagesList = document.getElementById("chatMessages");
			if (!messagesList) return;

			messagesList.innerHTML = "";

			messages.forEach(msg => {
				console.log("Loading message:", msg);
				addMessage(msg.sender, msg.content, msg.imageUrl, msg.timestamp || msg.sentTime || msg.createdAt);
			});

			messagesList.scrollTop = messagesList.scrollHeight;
		} catch (error) {
			console.error("Error loading chat history:", error);
		}
	}

	// ===== SEND MESSAGE =====
	async function sendMessageWidget() {
		console.log("sendMessageWidget called!");

		if (!currentUser || currentUser === "") {
			alert("Please login to use chat feature.");
			return;
		}

		if (!connection) {
			console.error("SignalR not connected");
			alert("Chat connection not established. Please refresh page.");
			return;
		}

		const receiver = document.getElementById("receiverWidget").value;
		console.log("Receiver:", receiver);

		if (!receiver) {
			alert("Please select a user to chat with first.");
			return;
		}

		const messageInput = document.getElementById("messageInputWidget");
		const imageInput = document.getElementById("imageInputWidget");

		if (!messageInput) {
			console.error("Message input not found!");
			return;
		}

		const message = messageInput.value.trim();
		console.log("Message:", message);

		let imageUrl = "";

		if (!message && !imageUrl) {
			console.log("No message or image to send");
			return;
		}

		try {
			console.log("Sending message via SignalR...");

			// Clear input immediately for better UX
			messageInput.value = "";
			if (imageInput) imageInput.value = "";
			updateSendButtonState();

			// Send via SignalR
			await connection.invoke("SendMessage", receiver, message, imageUrl);
			console.log("Message sent successfully!");

		} catch (err) {
			console.error("SignalR error:", err.toString());
			alert("Failed to send message. Please try again.");

			// Restore message on error
			messageInput.value = message;
			updateSendButtonState();
		}
	}

	// ===== ADD MESSAGE TO CHAT =====
	function addMessage(sender, message, imageUrl, messageTimestamp = null) {
		const msgDiv = document.createElement("div");

		if (messageTimestamp) {
			const msgDate = new Date(messageTimestamp);
			const today = new Date();
			const daysDiff = Math.floor((today - msgDate) / (1000 * 60 * 60 * 24));

			if (daysDiff === 1) {
				msgDiv.classList.add("yesterday");
			} else if (daysDiff > 1) {
				msgDiv.classList.add("old");
			}
		}

		let isMyMessage = false;

		if (userRole === "User") {
			isMyMessage = (sender === currentUser);
		} else if (userRole === "Admin" || userRole === "CustomerSupport") {
			isMyMessage = (sender === currentUser) ||
						 (sender === customerSupportUserName);
		}

		msgDiv.classList.add("message-widget", isMyMessage ? "user" : "bot");

		let html = "";

		if (!isMyMessage) {
			if (userRole === "User") {
				if (sender === customerSupportUserName) {
					html += `<strong>Customer Support</strong><br>`;
				} else {
					html += `<strong>${sender}</strong><br>`;
				}
			} else {
				html += `<strong>${sender}</strong><br>`;
			}
		}

		if (message) html += `<p>${message}</p>`;
		if (imageUrl) html += `<img src="${imageUrl}" alt="Image" style="max-width:150px; border-radius:8px; margin-top:6px;" />`;

		let timestamp;
		if (messageTimestamp) {
			timestamp = formatMessageTimestamp(messageTimestamp);
		} else {
			timestamp = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
		}

		html += `<span class="timestamp-widget">${timestamp}</span>`;

		msgDiv.innerHTML = `<div class="message-content-widget">${html}</div>`;

		const messagesList = document.getElementById("chatMessages");
		if (messagesList) {
			messagesList.appendChild(msgDiv);
			messagesList.scrollTop = messagesList.scrollHeight;

			msgDiv.style.opacity = '0';
			msgDiv.style.transform = 'translateY(10px)';
			setTimeout(() => {
				msgDiv.style.transition = 'all 0.3s ease';
				msgDiv.style.opacity = '1';
				msgDiv.style.transform = 'translateY(0)';
			}, 50);
		}
	}

	// ===== SMART TIMESTAMP FORMATTING =====
	function formatMessageTimestamp(messageTimestamp) {
		const msgDate = new Date(messageTimestamp);
		const today = new Date();
		const yesterday = new Date(today);
		yesterday.setDate(yesterday.getDate() - 1);

		const msgDateOnly = new Date(msgDate.getFullYear(), msgDate.getMonth(), msgDate.getDate());
		const todayOnly = new Date(today.getFullYear(), today.getMonth(), today.getDate());
		const yesterdayOnly = new Date(yesterday.getFullYear(), yesterday.getMonth(), yesterday.getDate());

		const time = msgDate.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});

		if (msgDateOnly.getTime() === todayOnly.getTime()) {
			return time;
		} else if (msgDateOnly.getTime() === yesterdayOnly.getTime()) {
			return `Yesterday ${time}`;
		} else {
			const daysDiff = Math.floor((todayOnly - msgDateOnly) / (1000 * 60 * 60 * 24));

			if (daysDiff < 7) {
				const dayName = msgDate.toLocaleDateString([], {weekday: 'short'});
				return `${dayName} ${time}`;
			} else {
				const dateString = msgDate.toLocaleDateString([], {month: 'short', day: 'numeric'});
				return `${dateString} ${time}`;
			}
		}
	}

	// ===== UPDATE SEND BUTTON STATE =====
	function updateSendButtonState() {
		const messageInput = document.getElementById("messageInputWidget");
		const imageInput = document.getElementById("imageInputWidget");
		const sendButton = document.getElementById("sendButtonWidget");

		if (messageInput && sendButton) {
			const msg = messageInput.value.trim();
			const hasImage = imageInput && imageInput.files.length > 0;
			sendButton.disabled = !(msg || hasImage);
		}
	}

	// ===== UPDATE NOTIFICATION BADGE =====
	function updateNotificationBadge() {
		const badge = document.getElementById("notificationBadge");
		if (badge && !isOpen) {
			let currentCount = parseInt(badge.textContent) || 0;
			badge.textContent = currentCount + 1;
			badge.style.display = 'flex';
		}
	}

	// ===== HANDLE IMAGE UPLOAD AND SEND =====
document.getElementById("imageInputWidget").addEventListener("change", async function (e) {
    const file = e.target.files[0];
    if (!file) return;

    // Tạo form data để upload
    const formData = new FormData();
    formData.append("image", file);

    try {
        // Gửi ảnh lên server
        const response = await fetch("/Chat/UploadImage", {
            method: "POST",
            body: formData
        });

        if (!response.ok) {
            alert("Upload image failed!");
            return;
        }

        const data = await response.json();
        if (data && data.imageUrl) {
            // Gửi ảnh qua SignalR (không cần nhập text)
            const receiver = document.getElementById("receiverWidget").value;
            if (!receiver) {
                alert("Please select a user to chat with first.");
                return;
            }
            if (!connection) {
                alert("Chat connection not established. Please refresh page.");
                return;
            }
            await connection.invoke("SendMessage", receiver, "", data.imageUrl);
        }
    } catch (err) {
        alert("Upload image error: " + err);
    } finally {
        // Reset input để có thể chọn lại cùng file nếu muốn
        e.target.value = "";
        updateSendButtonState();
    }
});

	// ===== EVENT LISTENERS =====
	document.addEventListener('DOMContentLoaded', function() {
		console.log("DOM loaded, setting up chat events");
		console.log("Current User:", currentUser);
		console.log("User Role:", userRole);

		// Chỉ load unread count khi user đã đăng nhập
		if (currentUser && currentUser !== "") {
			console.log("✅ User authenticated, loading unread count");
			loadTotalUnreadCount();
		} else {
			console.log("❌ User not authenticated, hiding badge");
			// Đảm bảo badge bị ẩn khi chưa đăng nhập
			const badge = document.getElementById("notificationBadge");
			if (badge) {
				badge.style.display = 'none';
			}
		}

		const messageInput = document.getElementById("messageInputWidget");
		const imageInput = document.getElementById("imageInputWidget");
		const sendButton = document.getElementById("sendButtonWidget");

		console.log("Elements found:", { messageInput, imageInput, sendButton });

		if (messageInput) {
			messageInput.addEventListener("input", updateSendButtonState);
			messageInput.addEventListener("keypress", function(e) {
				console.log("Key pressed:", e.key);
				if (e.key === 'Enter' && !e.shiftKey) {
					e.preventDefault();
					console.log("Enter pressed, sending message...");
					sendMessageWidget();
				}
			});
		}

		if (imageInput) {
			imageInput.addEventListener("change", updateSendButtonState);
		}

		if (sendButton) {
			sendButton.addEventListener("click", function(e) {
				e.preventDefault();
				console.log("Send button clicked");
				sendMessageWidget();
			});
		}

		const userSearchInput = document.getElementById("userSearchInput");
		if (userSearchInput) {
			console.log("Search input found, setting up events");

			userSearchInput.addEventListener("input", function(e) {
				const searchTerm = e.target.value;
				console.log("Search input changed:", searchTerm);
				searchUsers(searchTerm);
			});

			userSearchInput.addEventListener("keydown", function(e) {
				if (e.key === "Escape") {
					console.log("Escape pressed, clearing search");
					e.target.value = "";
					searchUsers("");
				}
			});

			userSearchInput.addEventListener("keypress", function(e) {
				if (e.key === "Enter") {
					e.preventDefault();
				}
			});
		} else {
			console.log("Search input NOT found");
		}

		updateSendButtonState();
	});
</script>