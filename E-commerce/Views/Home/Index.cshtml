		</div>

		<div class="story_items">
			<h2 class="story_title">Featured</h2>
			<div class="story_container">
				<div class="story_image">
					<img src="https://media.gucci.com/content/DiaryArticleDouble_Standard_2800x1788/1737993612/DiaryArticleDouble_Gucci-SS25-Jan25-2-1-0573-08-F_001_Default.jpg"
					alt="story" class="story-img" />
				</div>
				<div class="story_text">
					<div class="story-right-text">
						<div class="story-title">Where Light Finds Us</div>
						<div class="story-description">
							Yara Shahidi and George MacKay star in the new Spring Summer 2025 campaign, an evocative story of balance and connection.
						</div>
						<button class="discover-more">Discover More</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Sửa phần chat widget này: -->
		<div id="chatWidget">
			<!-- Chat Container -->
			<div id="chatContainer" class="chat-container" style="display: none;">
				<div class="chat-header">
					<div class="header-info">
						<div class="avatar">CS</div>
						<div class="header-text">
							<h4 id="chatTitle">Customer Support</h4>
							<span class="status">Online</span>
						</div>
					</div>
					<button class="close-btn" onclick="handleToggleChat()">×</button>
				</div>

				@if (User.Identity.IsAuthenticated)
				{
					<!-- User List cho Admin/Support -->
					<div class="user-list-widget" id="userListWidget" style="display: none;">
						<div class="user-list-header">
							<span>Select User to Chat:</span>
							<!-- Search Box -->
							<div class="user-search-container">
								<input type="text" id="userSearchInput" placeholder="Search users..." class="user-search-input" />
								<svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
									<circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2" fill="none" />
									<path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="2" />
								</svg>
							</div>
						</div>
						<div class="user-list-content" id="userListContent">
							<!-- Users loaded here -->
						</div>
					</div>

					<div class="chat-messages" id="chatMessages">
						<!-- Default message -->
						<div class="message bot">
							<div class="message-content">
								<p>Hello! How can I help you today?</p>
								<span class="timestamp">
									<script>document.write(new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}))</script>
								</span>
							</div>
						</div>
					</div>

					<!-- Chat input form -->
					<div class="chat-input">
						<input type="file" id="imageInputWidget" accept="image/*" style="display: none;" />
						<label for="imageInputWidget" class="file-input-btn">📎</label>
						<input type="text" id="messageInputWidget" placeholder="Type your message..." class="message-input" />
						<button type="button" id="sendButtonWidget" class="send-btn">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none">
								<path d="M2 21L23 12L2 3V10L17 12L2 14V21Z" fill="currentColor" />
							</svg>
						</button>
						<input type="hidden" id="receiverWidget" />
					</div>
				}
				else
				{
					<!-- Login Required Message -->
					<div class="login-required-container">
						<div class="login-icon">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none">
								<path d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z" fill="#5af2b2" />
								<path d="M12 14C8.13401 14 5 17.134 5 21C5 21.5523 5.44772 22 6 22H18C18.5523 22 19 21.5523 19 21C19 17.134 15.866 14 12 14Z" fill="#5af2b2" />
							</svg>
						</div>
						<h3>Sign In Required</h3>
						<p>You need to sign in to use our chat support feature.</p>
						<div class="login-buttons">
							<a href="/Account/Login" class="login-btn">Sign In</a>
							<a href="/Account/Create" class="register-btn">Sign Up</a>
						</div>
					</div>
				}
			</div>

			<!-- Chat Bubble - Hiển thị cho tất cả -->
			<div class="chat-bubble" id="chatBubble" onclick="handleToggleChat()">
				<svg id="chatIcon" width="24" height="24" viewBox="0 0 24 24" fill="none">
					<path d="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2ZM20 16H5.17L4 17.17V4H20V16Z" fill="white" />
					<circle cx="8" cy="10" r="1" fill="white" />
					<circle cx="12" cy="10" r="1" fill="white" />
					<circle cx="16" cy="10" r="1" fill="white" />
				</svg>
				<svg id="closeIcon" width="24" height="24" viewBox="0 0 24 24" fill="none" style="display: none;">
					<path d="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z" fill="white" />
				</svg>
				<div class="notification-badge" id="notificationBadge"></div>
			</div>
		</div>
	</div>
</div>


<style>

	.product-image-wrapper {
		height: 410px;
	}

	.category-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
	}

	.category-item {
		text-align: center;
		flex: 1;
	}

	a {
		text-decoration: none;
		color: inherit;
	}


	.title,
	.category-container {
		position: relative;
		z-index: 2;
	}

	.category-img {
		width: 100%;
		max-width: 40rem;
		height: auto;
		cursor: pointer;
		transition: transform 0.5s ease;
		transform: scale(1);
	}

		.category-img:hover {
			transform: scale(0.95);
		}

	.category-item p {
		font-family: Arial, Helvetica, sans-serif;
		margin-top: 10px;
		font-size: 16px;
		color: #ffffff;
		cursor: pointer;
	}

	.category-item a {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-decoration: none;
		color: inherit;
		background-color: transparent;
	}

		.category-item a:focus,
		.category-item a:hover {
			background-color: transparent;
		}


	.rtw-container {
		display: flex;
		justify-content: center;
		align-items: center;
		padding-top: 50px;
		overflow: hidden;
		position: relative;
	}

	.rtw-wrapper {
		position: relative;
		width: fit-content;
		display: none;
	}

		.rtw-wrapper.active {
			display: block;
		}

		.rtw-wrapper::after {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.2); /* Overlay màu đen nhạt, độ trong suốt 20% */
			z-index: 3;
		}

	.rtw-image {
		position: relative;
		display: block;
		max-width: 100%;
		height: 800px;
		border-radius: 8px;
		z-index: 2;
		object-fit: cover;
	}

	.text {
		position: absolute;
		font-size: 20px;
		font-weight: bold;
		text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.8);
		width: 100%;
		text-align: center;
		cursor: pointer;
	}

	.rtw-image {
		z-index: 4;
	}

	.text {
		z-index: 4;
	}

	.top-text {
		position: absolute;
		top: 90px;
		left: 50%;
		transform: translateX(-50%);
		text-transform: uppercase;
		font-size: 12px;
		color: rgb(247, 239, 239);
		background-color: #282224;
		border-radius: 3px;
		padding: 6px 10px;
		text-align: center;
		display: inline-block;
		max-width: fit-content;
		font-family: Arial, Helvetica, sans-serif;
	}

	.bottom-text {
		bottom: 80px;
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		color: white;
	}

	.shop-now-btn {
		margin-top: 25px;
		padding: 15px 20px;
		font-size: 13px;
		font-weight: bold;
		color: white;
		background-color: rgba(77, 77, 77, 0.5);
		border: 1px solid white;
		border-radius: 2px;
		cursor: pointer;
		text-transform: uppercase;
		transition: all 0.3s ease;
		transform: scale(1);
	}

		.shop-now-btn:hover {
			transform: scale(0.95);
		}

	.fade-in {
		animation: fadeIn 0.5s ease-in-out;
	}

	@@keyframes fadeIn {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	.story_items {
		width: 100%;
		margin: 0 auto; /* Căn giữa container */
		padding: 16px 16px 100px 16px; /* Khoảng cách bên trong */
	}

	.story_title {
		text-transform: uppercase;
		text-align: center; 
		font-size: 2rem;
		font-weight: bold;
		margin-bottom: 100px;
		color: white; /* Màu chữ */
	}

	.story_container {
		display: flex; /* Bố cục theo hàng */
		align-items: center; /* Căn giữa theo chiều dọc */
		justify-content: space-between; /* Tách đều các phần tử */
		gap: 20px; /* Khoảng cách giữa các khung */
		padding-left: 105px;
		padding-right: 105px;
	}

	.story_image {
		flex: 1; /* Chiếm 1 phần không gian */
		width: 100%; /* Ảnh chiếm toàn bộ chiều rộng khung */
		height: 100vh; /* Giữ tỷ lệ ảnh */
	}

		.story_image img {
			width: 100%; /* Ảnh chiếm toàn bộ chiều rộng khung */
			height: 100%; /* Giữ tỷ lệ ảnh */
			border-radius: 8px; /* Bo tròn góc ảnh */
			object-fit: cover;
			object-position: 35% center;
		}

	.story_text {
		flex: 1; /* Chiếm 1 phần không gian */
		padding: 16px; /* Khoảng cách bên trong */
		text-align: center; /* Căn giữa nội dung */
	}


	.story-title {
		font-size: 30px;
		font-weight: 600;
		margin-bottom: 20px; /* Khoảng cách dưới tiêu đề */
		color: white;
		text-transform: uppercase;
	}

	.story-description {
		font-size: 16px;
		color: #d9d9d9; /* Màu chữ mờ giống hình */
		font-weight: 100;
		margin-bottom: 30px; /* Khoảng cách dưới phần mô tả */
		line-height: 1.5; /* Tăng khoảng cách dòng để dễ đọc */
		padding: 0px 10rem 0px 10rem;
		display: -webkit-box;
		-webkit-line-clamp: 3; /* Giới hạn chỉ hiển thị 3 dòng */
		-webkit-box-orient: vertical;
		overflow: hidden; /* Ẩn bớt phần văn bản thừa */
	}

	.discover-more {
		font-size: 14px;
		text-transform: uppercase;
		font-weight: bold;
		color: white;
		background: none;
		border: none;
		cursor: pointer;
		border-bottom: 2px solid white;
		padding: 5px 0;
	}

	/* ===== CHAT WIDGET STYLING ===== */

	/* Chat Bubble */
	.chat-bubble {
		position: fixed;
		bottom: 20px;
		right: 20px;
		width: 60px;
		height: 60px;
		background: linear-gradient(135deg, #ffe4bf 0%, #06180b 100%);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		box-shadow: 0 8px 25px rgb(231,231,231,0.4);
		transition: all 0.3s ease;
		z-index: 9999;
		animation: pulse 2s infinite;
		border: none;
	}

		.chat-bubble:hover {
			transform: scale(1.1);
			box-shadow: 0 12px 35px rgb(114, 212, 156, 0.6);
		}

		.chat-bubble.bubble-open {
			background: linear-gradient(135deg, #ffe4bf 0%, #06180b 100%);
			animation: none;
		}

	.notification-badge {
		position: absolute;
		top: -5px;
		right: -5px;
		width: 24px;
		height: 24px;
    	background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
		color: white;
		border-radius: 50%;
		display: none;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		font-weight: 600;
		border: 2px solid white;
		box-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
		animation: badgePulse 2s infinite;
		transition: all 0.3s ease;
	}

	@@keyframes badgePulse {
		0% {
			box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
		}
		70% {
			box-shadow: 0 0 0 6px rgba(239, 68, 68, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
		}
	}

/* Chỉ hiển thị khi có class 'show' hoặc inline style display: flex */
.notification-badge.show {
    display: flex !important;
}

	/* Chat Container */
	.chat-container {
		position: fixed;
		bottom: 100px;
		right: 20px;
		width: 380px;
		height: 525px;
		background: linear-gradient(135deg, #1a2332 0%, #0f1419 100%);
		border-radius: 15px;
		border: 1px solid #2e374a;
		box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
		flex-direction: column;
		z-index: 9998;
		animation: slideInUp 0.3s ease;
	}

	/* Chat Header */
	.chat-header {
		background: linear-gradient(140deg, #474747 10%, #5af2b2 100%);
		padding: 20px;
		border-radius: 15px 15px 0 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: white;
	}

	.header-info {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.avatar {
		width: 40px;
		height: 40px;
		background: rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 600;
		font-size: 14px;
	}

	.header-text h4 {
