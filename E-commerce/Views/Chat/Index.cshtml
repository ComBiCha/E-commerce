@{
    ViewData["Title"] = "Chat";
}
<style>
    .chat-container {
        max-width: 900px;
        margin: 40px auto;
        background-color: #fff;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .chat-header {
        padding: 15px 20px;
        background-color: #007bff;
        color: white;
        font-size: 1.25rem;
        font-weight: bold;
    }

    .chat-body {
        height: 400px;
        overflow-y: auto;
        padding: 20px;
        background-color: #f5f5f5;
    }

    .chat-message {
        margin-bottom: 15px;
        max-width: 70%;
        padding: 10px 15px;
        border-radius: 20px;
        clear: both;
        word-wrap: break-word;
    }

    .message-left {
        background-color: #e2e3e5;
        float: left;
    }

    .message-right {
        background-color: #d1e7dd;
        float: right;
        text-align: right;
    }

    .chat-footer {
        padding: 15px 20px;
        background-color: #f9f9f9;
        border-top: 1px solid #ddd;
    }

        .chat-footer .input-group textarea {
            resize: none;
        }

    .username-input {
        padding: 15px;
        border-bottom: 1px solid #ccc;
        background-color: #fafafa;
    }

    .chat-message img {
        max-width: 100%;
        margin-top: 5px;
        border-radius: 10px;
    }
</style>

<div class="chat-container">
    <div class="chat-header">
        Real-Time Chat
    </div>

    <div class="username-input">
        <label for="receiver" class="form-label">Chat with:</label>
        <input id="receiver" class="form-control" placeholder="Receiver's username" onblur="loadChatHistory()" />
    </div>

    <div class="chat-body" id="messagesList">
        <!-- Messages will appear here -->
    </div>

    <div class="chat-footer">
        <div class="input-group">
            <input type="file" id="imageInput" accept="image/*" class="form-control me-2" />
            <textarea id="messageInput" class="form-control me-2" rows="1" placeholder="Type your message..."></textarea>
            <button id="sendButton" class="btn btn-primary" onclick="sendMessage()" disabled>Send</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script>

        function updateSendButtonState() {
            const message = document.getElementById("messageInput").value.trim();
            const imageInput = document.getElementById("imageInput");
            const hasImage = imageInput.files.length > 0;

            const sendButton = document.getElementById("sendButton");
            sendButton.disabled = !(message || hasImage);
        }

        function addMessageToList(sender, message, imageUrl) {
            const currentUser = "@ViewBag.UserName";
            const msgDiv = document.createElement("div");
            msgDiv.classList.add("chat-message");

            const isSender = sender === currentUser;
            msgDiv.classList.add(isSender ? "message-right" : "message-left");

            let html = "";
            if (!isSender) html += `<strong>${sender}</strong><br>`;
            if (message) html += `<span>${message}</span><br>`;
            if (imageUrl) {
                console.log("Image to show:", imageUrl);
                html += `<img src="${imageUrl}" alt="Image" style="max-width:200px; border-radius:10px;" />`;
            }

            msgDiv.innerHTML = html;
            document.getElementById("messagesList").appendChild(msgDiv);

            const chatBody = document.getElementById("messagesList");
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        function loadChatHistory() {
            const receiver = document.getElementById("receiver").value.trim();
            if (!receiver) return;

            fetch(`/Chat/GetChatHistory?receiver=${receiver}`)
                .then(response => response.json())
                .then(data => {
                    const list = document.getElementById("messagesList");
                    list.innerHTML = "";
                    data.forEach(msg => {
                        addMessageToList(msg.sender, msg.content, msg.imageUrl);
                    });
                })
                .catch(error => console.error("Chat history error:", error));
        }

        async function sendMessage() {
            const receiver = document.getElementById("receiver").value.trim();
            const message = document.getElementById("messageInput").value.trim();
            const sender = "@ViewBag.UserName";
            const imageInput = document.getElementById("imageInput");

            if (!receiver) {
                alert("Please enter receiver's username");
                return;
            }

            if (!message && imageInput.files.length === 0) {
                alert("Please enter a message or select an image");
                return;
            }

            let imageUrl = "";

            if (imageInput.files.length > 0) {
                const formData = new FormData();
                formData.append("image", imageInput.files[0]);

                try {
                    const uploadResponse = await fetch("/Chat/UploadImage", {
                        method: "POST",
                        body: formData
                    });

                    const result = await uploadResponse.json();
                    imageUrl = result.imageUrl;
                } catch (err) {
                    console.error("Upload error:", err);
                    return;
                }
            }

            connection.invoke("SendMessage", receiver, message, imageUrl)
                .then(() => {
                    console.log("Message sent successfully");
                })
                .catch(err => {
                    console.error("SignalR error:", err.toString());
                });

            document.getElementById("messageInput").value = "";
            document.getElementById("imageInput").value = "";
            updateSendButtonState();
        }


        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        connection.start().then(function () {
            console.log("✅ Connected to SignalR");

            document.getElementById("messageInput").addEventListener("input", updateSendButtonState);
            document.getElementById("imageInput").addEventListener("change", updateSendButtonState);
        });

        connection.on("ReceiveMessage", function (sender, message, imageUrl) {
            addMessageToList(sender, message, imageUrl);
        });
    </script>
}

