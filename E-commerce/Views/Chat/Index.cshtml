@{
    var role = ViewBag.Role as string;
    var currentUser = ViewBag.UserName as string;
}

<div class="chat-container">
    @* Ẩn danh sách người dùng nếu là khách hàng *@
    <div class="user-list" id="userList" style="@(role == "User" ? "display:none" : "")">
        <!-- Users will be loaded here -->
    </div>

    <div class="chat-content">
        <div class="chat-header" id="chatHeader">
            Select a user to chat
        </div>

        <div class="chat-body" id="messagesList"></div>

        <div class="chat-footer d-none" id="chatFooter">
            <div class="input-group">
                <input type="file" id="imageInput" accept="image/*" class="form-control me-2" />
                <textarea id="messageInput" class="form-control me-2" rows="1" placeholder="Type your message..."></textarea>
                <button id="sendButton" class="btn btn-primary" onclick="sendMessage()" disabled>Send</button>
                <input type="hidden" id="receiver" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script>
                // Thêm debug cho authentication:
        console.log("Current User:", currentUser);
        console.log("User Role:", userRole);
        console.log("Is Authenticated:", currentUser !== "");
        //lấy tên và role của người dùng đăng nhập hiện tại
        const currentUser = "@currentUser"; 
        const role = "@role";               
        let customerSupportUserName = "";   
        let currentSelectedUser = "";       

        //kết nối SignalR (chạy trước tiên)
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        //Lắng nghe các sự kiện từ server
        //Nhận tin nhắn từ người gửi
        connection.on("ReceiveMessage", function (sender, message, imageUrl) {
            console.log(`Received message from ${sender}: ${message} (Image: ${imageUrl})`);
            console.log(`Current user (logged in): ${currentUser}, Selected chat (UI): ${currentSelectedUser}, Role: ${role}`);

            let shouldDisplayInCurrentChat = false;

            //logic hiển thị tin nhắn
            if (role === "User") {
                if (sender === currentUser || sender === customerSupportUserName) {
                    shouldDisplayInCurrentChat = true;
                }
            }
            //nếu là role khác ngoài user
            else {
                const isMyOwnSentMessage = (sender === currentUser) || (role === "Admin" && sender === customerSupportUserName);
                const isFromCurrentSelectedPartner = (sender === currentSelectedUser);
                //là tin nhắn mình gửi
                if (isMyOwnSentMessage && document.getElementById("receiver").value === currentSelectedUser) {
                    shouldDisplayInCurrentChat = true;
                } 
                //người đang nhắn với admin gửi
                else if (isFromCurrentSelectedPartner) {
                    shouldDisplayInCurrentChat = true;
                }
            }
            if (shouldDisplayInCurrentChat) {
                //hiển thị tin nhắn
                addMessageToList(sender, message, imageUrl);
            } 
            //highlight tin nhắn
            else {
                highlightNewMessage(sender);
            }
        });


        connection.on("UpdateUserList", function (newUserName) {
            console.log(`Updating user list for new user: ${newUserName}`);
            loadChatUsers();
        });

        connection.on("LoadUserList", function () {
            console.log("Reloading user list based on server request.");
            loadChatUsers();
        });


        connection.start().then(async function () {
            console.log("SignalR Connected");

            try {
                // lấy thông tin về CustomerSupport (acc chính)
                const csRes = await fetch("/Chat/GetCustomerSupportUserName");
                customerSupportUserName = await csRes.json();
console.log("Customer Support UserName fetched:", customerSupportUserName);
            } catch (error) {
                console.error("Failed to fetch Customer Support UserName:", error);
            }

            if (role === "User") {
                // Hiển thị đang chat với customer support
                document.getElementById("receiver").value = customerSupportUserName;
                document.getElementById("chatHeader").textContent = "Chatting with: Customer Service Agent";
                document.getElementById("chatFooter").classList.remove("d-none");
                //Hiển thị lịch sử chat với customer support
                loadChatHistory(customerSupportUserName);
            } else {
                //Nếu là role khác ngoài user thì chạy hàm này
                loadChatUsers();
            }
        }).catch(function (err) {
            console.error("SignalR Connection Error: ", err.toString());
        });
        
        //Hiển thị lịch sử tin nhắn
        async function loadChatHistory(username) {
            try {
                const res = await fetch(`/Chat/GetChatHistory?receiver=${username}`);
                const messages = await res.json();
                const list = document.getElementById("messagesList");
                list.innerHTML = "";
                messages.forEach(m => addMessageToList(m.sender, m.content, m.imageUrl));
                list.scrollTop = list.scrollHeight;
            } catch (error) {
                console.error("Error loading chat history:", error);
            }
        }

        // thêm tin nhắn vào giao diện
        function addMessageToList(sender, message, imageUrl) {
            const msgDiv = document.createElement("div");
            let isMyMessage = false;

            if (role === "User") {
                isMyMessage = (sender === currentUser);
            } else {
                if (sender === currentUser || (role === "Admin" && sender === customerSupportUserName)) {
                    isMyMessage = true;
                }
            }

            msgDiv.classList.add("chat-message", isMyMessage ? "message-right" : "message-left");
            let html = "";

            if (!isMyMessage) {
                if (role === "User" && sender === customerSupportUserName) {
                    html += `<strong>Customer Support</strong><br>`;
                } else {
                    html += `<strong>${sender}</strong><br>`;
                }
            }

            if (message) html += `<span>${message}</span><br>`;
            if (imageUrl) html += `<img src="${imageUrl}" alt="Image" style="max-width:200px; border-radius:10px; margin-top: 5px;" />`;
            msgDiv.innerHTML = html;
            document.getElementById("messagesList").appendChild(msgDiv);
            document.getElementById("messagesList").scrollTop = document.getElementById("messagesList").scrollHeight;
        }
// Vị trí admin, lấy danh sách những người đã nhắn tin cho customer support
        async function loadChatUsers() {
            try {
                //trả về danh sách người dùng đã nhắn tin cho customer support
                const res = await fetch("/Chat/GetChatUsers");
                const users = await res.json();
                const userList = document.getElementById("userList");
                userList.innerHTML = "";

                // Sort users: current selected first, then others
                users.sort((a, b) => {
                    if (a === currentSelectedUser) return -1;
                    if (b === currentSelectedUser) return 1;
                    return 0;
                });
                //sửa giao diện để có thể nhấn vào 1 người và nhắn với họ
                users.forEach(u => {
                    const div = document.createElement("div");
                    div.className = "user-item";
                    div.textContent = u;
                    div.setAttribute("data-user", u);
                    if (u === currentSelectedUser) {
                        div.classList.add("active");
                    }
                    //Nhấn vào để gọi hàm selectUser
                    div.addEventListener("click", (event) => selectUser(u, event));
                    userList.appendChild(div);
                });

                // role khác user
                if (role !== "User" && users.length > 0) {
                    if (currentSelectedUser === "" || !users.includes(currentSelectedUser)) {
                        selectUser(users[0], null);
                    }
                    // đã chọn được người để nhắn
                    else {
                        const selectedElement = document.querySelector(`.user-item[data-user="${currentSelectedUser}"]`);
                        if (selectedElement) {
                            selectedElement.classList.add("active");
                            //set người nhận tin nhắn là người mình chọn hiện tại
                            document.getElementById("receiver").value = currentSelectedUser;
                            document.getElementById("chatHeader").textContent = "Chatting with: " + currentSelectedUser;
                            document.getElementById("chatFooter").classList.remove("d-none");
                        }
                    }
                }

            } catch (error) {
                console.error("Failed to load chat users:", error);
            }
        }

        //Chọn người để nhắn
        function selectUser(userName, event) {
            const receiverInput = document.getElementById("receiver");
            const chatHeader = document.getElementById("chatHeader");
            const chatFooter = document.getElementById("chatFooter");

            currentSelectedUser = userName;

            receiverInput.value = userName;
chatHeader.textContent = "Chatting with: " + userName;

            document.querySelectorAll(".user-item").forEach(el => {
                el.classList.remove("active", "new-message");
                el.style.backgroundColor = "";
                el.style.fontWeight = "";
            });

            if (event?.currentTarget) {
                event.currentTarget.classList.add("active");
            } else {
                const selectedElement = document.querySelector(`.user-item[data-user="${userName}"]`);
                if (selectedElement) {
                    selectedElement.classList.add("active");
                }
            }

            chatFooter.classList.remove("d-none");
            //hiển thị lịch sử nhắn với người được chọn
            loadChatHistory(userName);
        }

        //gửi tin nhắn
        async function sendMessage() {
            const receiver = document.getElementById("receiver").value;
            if (!receiver) {
                alert("Please select a user to chat with first.");
                return;
            }

            const message = document.getElementById("messageInput").value.trim();
            const imageInput = document.getElementById("imageInput");
            let imageUrl = "";

            if (imageInput.files.length > 0) {
                const formData = new FormData();
                formData.append("image", imageInput.files[0]);

                try {
                    const uploadResponse = await fetch("/Chat/UploadImage", {
                        method: "POST",
                        body: formData
                    });
                    const result = await uploadResponse.json();
                    imageUrl = result.imageUrl;
                } catch (err) {
                    console.error("Upload error:", err);
                    alert("Failed to upload image.");
                    return;
                }
            }

            if (!message && !imageUrl) {
                return;
            }

            try {
                //Gọi tới ChatHub.cs /SendMessage
                await connection.invoke("SendMessage", receiver, message, imageUrl);
            } catch (err) {
                console.error("SignalR error:", err.toString());
            }

            document.getElementById("messageInput").value = "";
            imageInput.value = "";
            updateSendButtonState();
        }

        function updateSendButtonState() {
            const msg = document.getElementById("messageInput").value.trim();
            const img = document.getElementById("imageInput");
            document.getElementById("sendButton").disabled = !(msg || img.files.length > 0);
        }

        //Highlight tin nhắn mới
        function highlightNewMessage(sender) {
            const userItems = document.querySelectorAll(".user-item");
            let found = false;
            userItems.forEach(item => {
if (item.textContent === sender) {
                    item.classList.add("new-message");
                    found = true;
                }
            });

            if (!found && sender !== currentUser) {
                loadChatUsers(); 
            }
        }

        document.getElementById("messageInput").addEventListener("input", updateSendButtonState);
        document.getElementById("imageInput").addEventListener("change", updateSendButtonState);
    </script>
}